@model CrossChat.Data.Entities.FacebookSettings
@{
    ViewData["Title"] = "Управление Facebook Page";
    bool isConnected = Model != null && !string.IsNullOrEmpty(Model.PageAccessToken);
}

@section Styles {
    <style>
        /* Уникальные стили для страницы Facebook */

        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
            box-sizing: border-box;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
            box-sizing: border-box;
            overflow: hidden; /* Защита от вылета любых элементов */
        }

        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #1877F2;
            padding: 4px;
            background: transparent;
            margin-bottom: 1rem;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }

        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* === АДАПТИВНЫЕ ПОЛЯ ВВОДА И ВЫПАДАЮЩИЕ СПИСКИ (ИСПРАВЛЕНО ДЛЯ МОБИЛОК) === */
        .text-input, .select-input {
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            display: block;
        }

        /* Стилизация выпадающих списков со стрелочкой и защитой от переполнения */
        select.text-input, select.select-input {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1.1em;
            padding-right: 2.5rem !important;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
            cursor: pointer;
        }

        .text-input:focus, .select-input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
        }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            font-family: inherit;
            resize: vertical;
            min-height: 120px;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            box-sizing: border-box;
        }

        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

            .btn-console:hover {
                background: rgba(15, 23, 42, 0.7) !important;
                border-color: var(--text-secondary) !important;
                transform: translateY(-1px);
            }

        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
                transform: translateY(-1px);
            }

        .btn-fb {
            background: #1877F2;
            color: white;
            box-shadow: 0 4px 12px rgba(24, 119, 242, 0.2);
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* ТОГГЛЫ */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            box-sizing: border-box;
            width: 100%;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked ~ .slider {
            background-color: #10b981;
        }

            input:checked ~ .slider:before {
                transform: translateX(24px);
            }

        /* МОБИЛЬНАЯ АДАПТАЦИЯ */
        @@media (max-width: 600px) {
            .container {
                margin-top: 5rem;
                padding: 0 0.75rem;
            }

            .card {
                padding: 1.25rem;
            }

            .action-buttons-group {
                grid-template-columns: 1fr !important;
                gap: 10px !important;
            }
            /* Компактный размер шрифта для мобилок, чтобы опции не обрезались слишком рано */
            .text-input, .select-input {
                font-size: 0.85rem !important;
                padding: 0.65rem 0.85rem !important;
                padding-right: 2.2rem !important;
            }
        }

        [data-theme="light"] .btn-console {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

            [data-theme="light"] .btn-console:hover {
                background: #f1f5f9 !important;
                border-color: #94a3b8 !important;
            }
    </style>
}

@section NavbarActions {
    @{
        var backUrl = Model?.ProfileId > 0
            ? $"/profile?profileId={Model.ProfileId}"
            : (Context.Request.Query.ContainsKey("profileId") ? $"/profile?profileId={Context.Request.Query["profileId"]}" : "/profiles");
    }
    <a href="@backUrl" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">
        ← Назад
    </a>
}

<div class="container">
    <div class="card">
        @if (isConnected)
        {
            /* === РЕЖИМ НАСТРОЕК СТРАНИЦЫ === */
            <div class="connected-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
                }
                <div class="username">@Model.PageName</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот работает</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Отключен</span>
                    }
                </div>
            </div>

            <!-- ТРИ КНОПКИ ДЕЙСТВИЯ -->
            <div class="action-buttons-group" style="grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
                <a href="/auth/console?provider=facebook&botId=@Model.Id&username=@Model.PageName" class="btn btn-console" style="padding: 12px 6px;">
                    💻 Консоль
                </a>
                <a href="/planner?profileId=@Model.ProfileId&network=Facebook&botId=@Model.Id" class="btn btn-autoposting" style="padding: 12px 6px;">
                    📅 Постинг
                </a>
                <a href="/facebook/analytics?botId=@Model.Id" class="btn" style="background: linear-gradient(135deg, #1877F2 0%, #0c56c2 100%); color: white; padding: 12px 6px;">
                    📊 Аналитика
                </a>
            </div>

            <div class="form-section">
                <form action="/facebook/update-settings" method="post">
                    <input type="hidden" name="botId" value="@Model.Id" />

                    <!-- 1. БЛОК АВТООТВЕТОВ В ЛС (MESSENGER) -->
                    <div class="switch-container" style="display: flex; flex-direction: column; align-items: stretch; gap: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <label style="margin:0; font-size: 1.05rem; font-weight: 600; color: var(--text-main); cursor: pointer;">
                                    Автоответы в ЛС (Messenger)
                                </label>
                                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 3px;">
                                    Мгновенный ответ на входящие личные сообщения страницы
                                </div>
                            </div>
                            <label class="switch">
                                <input type="checkbox" id="directToggle" name="isDirectEnabled" value="true"
                                       @(Model.IsDirectEnabled ? "checked" : "")
                                       onchange="document.getElementById('directSettingsBlock').style.display = this.checked ? 'flex' : 'none';">
                                <span class="slider"></span>
                            </label>
                            <input type="hidden" name="isDirectEnabled" value="false">
                        </div>

                        <!-- Выпадающий блок ЛС -->
                        <div id="directSettingsBlock" style="display: @(Model.IsDirectEnabled ? "flex" : "none"); flex-direction: column; gap: 14px; padding-top: 14px; border-top: 1px solid var(--glass-border); width: 100%;">
                            <div style="width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 6px;">Способ генерации ответа в ЛС:</label>
                                <select name="directReplyMode" id="directModeSelect" class="text-input" style="font-weight: 600;" onchange="updateDirectModeUi()">
                                    <option value="2" selected="@(Model.DirectReplyMode == 2)">📝 Только шаблоны (Бесплатно, Spintax)</option>
                                    <option value="3" selected="@(Model.DirectReplyMode == 3)">⚡ Комбинированный (ИИ ➔ при сбое Шаблон)</option>
                                    <option value="1" selected="@(Model.DirectReplyMode == 1)">🤖 Только ИИ (Gemini)</option>
                                </select>
                            </div>

                            <div id="directTemplatesBox" style="display: @(Model.DirectReplyMode == 1 ? "none" : "block"); width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">
                                    Шаблоны ответов для ЛС (Spintax {вариант1|вариант2}):
                                </label>
                                <textarea name="directTemplates" rows="3" class="text-input" style="font-size: 0.9rem;"
                                      placeholder="{Здравствуйте|Привет}! 😊 Чем могу {помочь|быть полезна}?&#10;{Спасибо|Благодарю} за сообщение! ✨">@(Model.DirectTemplates ?? "{Здравствуйте|Привет}! 😊 Чем могу {помочь|быть полезна}?\n{Спасибо|Благодарю} за сообщение! ✨")</textarea>
                            </div>

                            <div style="width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">Системный промпт для ЛС (ИИ)</label>
                                <textarea name="systemPrompt" rows="2" class="text-input" style="font-size: 0.9rem;">@Model.SystemPrompt</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- 2. БЛОК АВТООТВЕТОВ НА КОММЕНТАРИИ -->
                    <div class="switch-container" style="display: flex; flex-direction: column; align-items: stretch; gap: 12px; margin-top: 15px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <label style="margin:0; font-size: 1.05rem; font-weight: 600; color: var(--text-main); cursor: pointer;">
                                    Автоответы на комментарии к публикациям
                                </label>
                                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 3px;">
                                    Мгновенный ответ под постами и Reels на странице Facebook
                                </div>
                            </div>
                            <label class="switch">
                                <input type="checkbox" id="commentsToggle" name="isCommentsEnabled" value="true"
                                       @(Model.IsCommentsEnabled ? "checked" : "")
                                       onchange="document.getElementById('commentsSettingsBlock').style.display = this.checked ? 'flex' : 'none';">
                                <span class="slider"></span>
                            </label>
                            <input type="hidden" name="isCommentsEnabled" value="false">
                        </div>

                        <!-- Выпадающий блок комментариев -->
                        <div id="commentsSettingsBlock" style="display: @(Model.IsCommentsEnabled ? "flex" : "none"); flex-direction: column; gap: 14px; padding-top: 14px; border-top: 1px solid var(--glass-border); width: 100%;">
                            <div style="width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 6px;">Способ генерации ответа на комментарии:</label>
                                <select name="commentReplyMode" id="commentModeSelect" class="text-input" style="font-weight: 600;" onchange="updateFbCommentModeUi()">
                                    <option value="2" selected="@(Model.CommentReplyMode == 2)">📝 Только шаблоны (Бесплатно, Spintax)</option>
                                    <option value="3" selected="@(Model.CommentReplyMode == 3)">⚡ Комбинированный (ИИ ➔ при сбое Шаблон)</option>
                                    <option value="1" selected="@(Model.CommentReplyMode == 1)">🤖 Только ИИ (Gemini)</option>
                                </select>
                            </div>

                            <div id="commentTemplatesBox" style="display: @(Model.CommentReplyMode == 1 ? "none" : "block"); width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">
                                    Шаблоны ответов на комментарии:
                                </label>
                                <textarea name="commentTemplates" rows="3" class="text-input" style="font-size: 0.9rem;">@(Model.CommentTemplates ?? "{Спасибо|Благодарю}! ❤️\nРады видеть вас на нашей странице! ✨")</textarea>
                            </div>

                            <div style="width: 100%;">
                                <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">Промпт для комментариев (ИИ)</label>
                                <textarea name="commentPrompt" rows="2" class="text-input" style="font-size: 0.9rem;">@Model.CommentPrompt</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- 3. БЛОК СТОРИС -->
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">🌟 Ежедневные истории (Stories)</h4>
                    <div class="switch-container" style="display: flex; flex-direction: column; align-items: stretch; gap: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <label style="font-weight: 600; margin: 0; color: var(--text-main); cursor: pointer;" for="dailyStoryToggle">
                                    Автоматические ежедневные сторис
                                </label>
                                <small style="display: block; color: var(--text-secondary); font-size: 0.8rem; margin-top: 4px;">
                                    Бот будет раз в сутки выбирать случайное фото страницы и публиковать его в Истории Facebook.
                                </small>
                            </div>

                            <label class="switch">
                                <input type="checkbox" id="dailyStoryToggle" name="isDailyStoriesEnabled" value="true"
                                       @(Model.IsDailyStoriesEnabled ? "checked" : "")
                                       onchange="document.getElementById('storySettingsBox').style.display = this.checked ? 'flex' : 'none';">
                                <span class="slider"></span>
                            </label>
                            <input type="hidden" name="isDailyStoriesEnabled" value="false">
                        </div>

                        <!-- Разворачивающиеся настройки времени и надписи -->
                        <div id="storySettingsBox" style="display: @(Model.IsDailyStoriesEnabled ? "flex" : "none"); flex-direction: column; gap: 14px; padding-top: 14px; border-top: 1px solid var(--glass-border); width: 100%;">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
                                <label style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">Время публикации (по Минску):</label>
                                <input type="time" name="dailyStoryTime" value="@(Model.DailyStoryTime ?? "12:00")" class="text-input" style="width: 120px; padding: 6px 10px; font-weight: bold; margin: 0;">
                            </div>

                            <!-- ТУМБЛЕР И ПОЛЕ НАДПИСИ ПОВЕРХ ФОТО -->
                            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--glass-border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 10px; width: 100%; box-sizing: border-box;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <label style="font-size: 0.85rem; font-weight: 600; margin: 0; color: var(--text-main); cursor: pointer;" for="overlayTextToggle">
                                        💬 Текст-стикер поверх фото
                                    </label>
                                    <label class="switch">
                                        <input type="checkbox" id="overlayTextToggle" name="isStoryOverlayTextEnabled" value="true"
                                               @(Model.IsStoryOverlayTextEnabled ? "checked" : "")
                                               onchange="document.getElementById('overlayInputBox').style.display = this.checked ? 'block' : 'none';">
                                        <span class="slider"></span>
                                    </label>
                                    <input type="hidden" name="isStoryOverlayTextEnabled" value="false">
                                </div>

                                <div id="overlayInputBox" style="display: @(Model.IsStoryOverlayTextEnabled ? "block" : "none"); width: 100%;">
                                    <label style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 4px; display: block;">
                                        Надписи для историй (каждая с новой строки или со Spintax {вариант1|вариант2}):
                                    </label>
                                    <textarea name="storyOverlayText" rows="3" class="text-input" style="font-size: 0.85rem; font-family: monospace;"
                                          placeholder="Больше интересного в описании!&#10;{Загляни|Переходи} в шапку профиля 👆">@(Model.StoryOverlayText ?? "Больше интересного в описании!\nСсылка на Telegram в шапке профиля 👆")</textarea>
                                    <small style="display: block; font-size: 0.75rem; color: var(--text-secondary); margin-top: 6px;">
                                        🎲 Бот случайным образом выбирает тему оформления, позицию на фото и фразу из списка.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. ПРИВЯЗКА К ПРОФИЛЮ -->
                    <div class="form-group" style="text-align:left; margin-bottom: 1.5rem; margin-top: 20px; width: 100%;">
                        <h4 style="margin-bottom: 8px;">Привязан к профилю</h4>
                        <select name="profileId" class="select-input">
                            @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">@p.Name</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                </form>
            </div>

            <!-- КНОПКА ОТКЛЮЧЕНИЯ СТРАНИЦЫ FACEBOOK С ПРЕДУПРЕЖДЕНИЕМ -->
            <form action="/facebook/disconnect" method="post" onsubmit="return confirmDisconnect(@(ViewBag.LinkedPostsCount ?? 0));" style="margin-top: 2rem;">
                <input type="hidden" name="botId" value="@Model.Id">
                <button type="submit" class="btn btn-danger">Отключить страницу</button>
            </form>
        }
        else
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ === */
            <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="#1877F2">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
            </div>
            <h1 style="text-align: center;">Facebook Pages</h1>
            <p style="color:var(--text-secondary); margin-bottom:2rem; text-align: center;">Подключите страницы Facebook для автоответов в Messenger.</p>

            <a href="@ViewBag.FbLoginUrl" class="btn btn-fb">
                <span>Войти через Facebook</span>
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        function updateFbCommentModeUi() {
            const mode = document.getElementById('commentModeSelect').value;
            const box = document.getElementById('commentTemplatesBox');
            box.style.display = (mode === "2" || mode === "3") ? 'block' : 'none';
        }

        function updateDirectModeUi() {
            const mode = document.getElementById('directModeSelect').value;
            const box = document.getElementById('directTemplatesBox');
            box.style.display = (mode === "2" || mode === "3") ? 'block' : 'none';
        }

        function confirmDisconnect(postsCount) {
            if (postsCount > 0) {
                return confirm(
                    `⚠️ ВНИМАНИЕ!\n\n` +
                    `К этой странице Facebook привязано публикаций в планировщике: ${postsCount} шт.\n\n` +
                    `При отключении страницы эти публикации будут автоматически удалены из календаря, а неиспользуемые файлы очищены из облака.\n\n` +
                    `Вы уверены, что хотите отключить страницу?`
                );
            }
            return confirm('Отключить эту страницу Facebook от CrossChat?');
        }
    </script>
}