@model CrossChat.Data.Entities.FacebookSettings
@{
    ViewData["Title"] = "Управление Facebook Page";
    bool isConnected = Model != null && !string.IsNullOrEmpty(Model.PageAccessToken);
}

@section Styles {
    <style>
        /* Уникальные стили для страницы Facebook */

        /* 1. ИСПРАВЛЕНИЕ ШИРИНЫ И ОТСТУПОВ */
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
        }

        /* 2. ИСПРАВЛЕНИЕ АВАТАРКИ (ЦЕНТРИРОВАНИЕ) */
        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #1877F2;
            padding: 4px;
            background: transparent;
            margin-bottom: 1rem;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }

        /* ФОРМА */
        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
        }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            font-family: inherit;
            resize: vertical;
            min-height: 150px;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        /* Группа верхних кнопок управления */
        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            box-sizing: border-box;
        }

        /* Стилизация кнопки консоли бота (стеклянный стиль) */
        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

            .btn-console:hover {
                background: rgba(15, 23, 42, 0.7) !important;
                border-color: var(--text-secondary) !important;
                transform: translateY(-1px);
            }

        /* Стилизация кнопки автопостинга (Индиго-градиент) */
        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
                transform: translateY(-1px);
            }

        .btn-fb {
            background: #1877F2;
            color: white;
            box-shadow: 0 4px 12px rgba(24, 119, 242, 0.2);
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        /* СТАТУСЫ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* ТОГГЛ */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        /* МОБИЛЬНАЯ АДАПТАЦИЯ */
        @@media (max-width: 600px) {
            .container

        {
            margin-top: 5rem;
        }

        .card {
            padding: 1.5rem;
        }

        /* Складываем кнопки управления в один ряд вертикально на мобилках */
        .action-buttons-group {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        }

        /* --- СВЕТЛАЯ ТЕМА ДЛЯ КНОПОК --- */
        [data-theme="light"] .btn-console {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

            [data-theme="light"] .btn-console:hover {
                background: #f1f5f9 !important;
                border-color: #94a3b8 !important;
            }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Профиль</a>
}

<div class="container">
    <div class="card">
        @if (isConnected)
        {
            /* === РЕЖИМ НАСТРОЕК СТРАНИЦЫ === */
            <div class="connected-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
                }
                <div class="username">@Model.PageName</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот работает</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Отключен</span>
                    }
                </div>
            </div>

            <!-- НОВАЯ СИММЕТРИЧНАЯ ГРУППА КНОПОК ДЕЙСТВИЯ -->
            <div class="action-buttons-group">
                <a href="/auth/console?provider=facebook&botId=@Model.Id&username=@Model.PageName" class="btn btn-console">
                    💻 Консоль бота
                </a>
                <a href="/planner?profileId=@Model.ProfileId&network=Facebook&botId=@Model.Id" class="btn btn-autoposting">
                    📅 Автопостинг
                </a>
            </div>

            <div class="form-section">
                <form action="/facebook/update-settings" method="post">
                    <input type="hidden" name="botId" value="@Model.Id" />

                    <div class="switch-container">
                        <div>
                            <label style="margin:0; font-size: 1.1rem; color: var(--text-main);">Включить автоответы</label>
                            <div style="font-size: 0.8rem; color: var(--text-secondary);">Отвечать в Messenger</div>
                        </div>
                        <label class="switch">
                            <input type="hidden" name="isActive" value="false" />
                            <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Системный промпт (Инструкция)</label>
                        <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                    </div>

                    <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                        <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                        <select name="profileId" class="select-input">
                            @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                    @p.Name
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                </form>

            </div>

            <form action="/facebook/disconnect" method="post" onsubmit="return confirm('Отключить эту страницу?');">
                <input type="hidden" name="botId" value="@Model.Id" />
                <button type="submit" class="btn btn-danger" style="margin-top: 20px;">Удалить интеграцию</button>
            </form>
        }
        else
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ === */
            <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="#1877F2">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
            </div>
            <h1 style="text-align: center;">Facebook Pages</h1>
            <p style="color:var(--text-secondary); margin-bottom:2rem; text-align: center;">Подключите страницы Facebook для автоответов в Messenger.</p>

            <a href="@ViewBag.FbLoginUrl" class="btn btn-fb">
                <span>Войти через Facebook</span>
            </a>
        }
    </div>
</div>