@{
    ViewData["Title"] = "Единый Инбокс";
    int activeProfileId = ViewBag.ActiveProfileId ?? 0;
}

@section Styles {
    <style>
        /* ДЕСКТОП: АККУРАТНОЕ СТЕКЛЯННОЕ ОКНО */
        .inbox-wrapper {
            max-width: 1300px;
            margin: 5rem auto 1.5rem;
            padding: 0 1rem;
            height: calc(100vh - 7.5rem);
            min-height: 550px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        .inbox-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            flex: 1;
            height: 100%;
            min-height: 0;
            display: grid;
            grid-template-columns: 340px 1fr;
            overflow: hidden;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        /* ЛЕВАЯ КОЛОНКА (СПИСОК) */
        .inbox-sidebar {
            border-right: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            background: rgba(15, 23, 42, 0.4);
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .sidebar-header {
            padding: 1rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex-shrink: 0;
        }

        .search-input-box {
            position: relative;
            width: 100%;
        }

            .search-input-box input {
                width: 100%;
                box-sizing: border-box;
                background: var(--input-bg, rgba(255, 255, 255, 0.05));
                border: 1px solid var(--glass-border);
                border-radius: 10px;
                padding: 8px 12px 8px 32px;
                color: var(--text-main);
                font-size: 0.85rem;
                outline: none;
            }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .network-filter-pills {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 2px;
        }

            .network-filter-pills::-webkit-scrollbar {
                display: none;
            }

        .pill-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 4px 10px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .pill-btn:hover, .pill-btn.active {
                background: var(--accent-color, #6366f1);
                border-color: var(--accent-color, #6366f1);
                color: #fff;
            }

        .dialogs-list {
            flex: 1 1 0;
            min-height: 0;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .dialog-item {
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            cursor: pointer;
            transition: background 0.15s;
            position: relative;
        }

            .dialog-item:hover {
                background: rgba(255, 255, 255, 0.03);
            }

            .dialog-item.active {
                background: rgba(99, 102, 241, 0.12);
                border-left: 3px solid var(--accent-color, #6366f1);
            }

        .avatar-wrapper {
            position: relative;
            width: 44px;
            height: 44px;
            flex-shrink: 0;
        }

        .chat-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .network-badge-mini {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--card-bg, #1e293b);
            font-size: 9px;
        }

        .dialog-info {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .dialog-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dialog-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-main);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dialog-time {
            font-size: 0.72rem;
            color: var(--text-secondary);
        }

        .dialog-bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        .dialog-snippet {
            font-size: 0.8rem;
            color: var(--text-secondary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
        }

        .unread-count-badge {
            background: var(--accent-color, #6366f1);
            color: #fff;
            font-size: 0.7rem;
            font-weight: bold;
            border-radius: 10px;
            padding: 2px 6px;
            min-width: 16px;
            text-align: center;
        }

        /* ПРАВАЯ КОЛОНКА (ЧАТ) */
        .inbox-chat-area {
            display: flex;
            flex-direction: column;
            background: rgba(15, 23, 42, 0.15);
            position: relative;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .active-chat-wrapper {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
            width: 100%;
            overflow: hidden;
        }

        /* ШАПКА ДИАЛОГА */
        .chat-header {
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(15, 23, 42, 0.6);
            gap: 8px;
            flex-shrink: 0;
            z-index: 10;
        }

        .chat-user-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            min-width: 0; /* Обязательно для text-overflow у имени */
        }

        .user-text-details {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .user-name-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-handle-subtitle {
            font-size: 0.75rem;
            color: var(--text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .back-to-list-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 1.4rem;
            cursor: pointer;
            padding: 4px;
            line-height: 1;
        }

        /* БЛОК HUMAN TAKEOVER */
        .human-takeover-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            padding: 5px 10px;
            border-radius: 12px;
            flex-shrink: 0;
        }

        .takeover-status-label {
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .3s;
            border-radius: 20px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 14px;
                width: 14px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .3s;
                border-radius: 50%;
            }

        input:checked ~ .slider {
            background-color: #f43f5e;
        }

            input:checked ~ .slider:before {
                transform: translateX(20px);
            }

        /* ЛЕНТА СООБЩЕНИЙ */
        .messages-stream {
            flex: 1 1 0;
            min-height: 0;
            padding: 1rem 1.25rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

        .msg-bubble {
            max-width: 75%;
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 0.9rem;
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            gap: 4px;
            word-wrap: break-word;
        }

        .msg-incoming {
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-bottom-left-radius: 4px;
        }

        .msg-outgoing-bot {
            align-self: flex-end;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(168, 85, 247, 0.25));
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: var(--text-main);
            border-bottom-right-radius: 4px;
        }

        .msg-outgoing-human {
            align-self: flex-end;
            background: var(--accent-color, #6366f1);
            color: #ffffff;
            border-bottom-right-radius: 4px;
        }

        .msg-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 5px;
            font-size: 0.68rem;
            opacity: 0.65;
        }

        .sender-tag {
            font-size: 0.68rem;
            font-weight: bold;
            padding: 1px 5px;
            border-radius: 4px;
            background: rgba(0, 0, 0, 0.25);
        }

        /* ЗАКРЕПЛЕННАЯ ПАНЕЛЬ ВВОДА ВНИЗУ */
        .chat-input-panel {
            padding: 0.75rem 1.25rem;
            border-top: 1px solid var(--glass-border);
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-shrink: 0;
            z-index: 20;
        }

        .input-tools-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .input-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .chat-textarea {
            flex: 1;
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-main);
            padding: 10px 14px;
            font-size: 0.92rem;
            resize: none;
            outline: none;
            height: 42px;
            box-sizing: border-box;
            font-family: inherit;
        }

            .chat-textarea:focus {
                border-color: var(--accent-color, #6366f1);
            }

        .btn-send {
            background: var(--accent-color, #6366f1);
            color: white;
            border: none;
            border-radius: 12px;
            width: 44px;
            height: 42px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: transform 0.15s;
        }

            .btn-send:active {
                transform: scale(0.95);
            }

        .empty-chat-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            gap: 12px;
            text-align: center;
            padding: 2rem;
        }

        /* ========================================================================= */
        /* РЕЖИМ «МОБИЛЬНЫЙ МЕССЕНДЖЕР» (КАК В TELEGRAM / WHATSAPP)                 */
        /* ========================================================================= */
        @@media (max-width: 768px) {
            .inbox-wrapper {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                height: 100dvh !important; /* Настоящая высота мобильного экрана с учетом клавиатуры */
                margin: 0 !important;
                padding: 0 !important;
                z-index: 10000;
                border-radius: 0 !important;
            }

            .inbox-card {
                border: none !important;
                border-radius: 0 !important;
                grid-template-columns: 1fr !important;
                height: 100% !important;
            }
            /* По умолчанию виден список диалогов */
            .inbox-chat-area {
                display: none;
            }

            .inbox-sidebar {
                width: 100% !important;
                height: 100% !important;
            }
            /* Когда открыт чат — список диалогов скрывается, чат занимает весь экран */
            .inbox-card.mobile-chat-open .inbox-sidebar {
                display: none !important;
            }

            .inbox-card.mobile-chat-open .inbox-chat-area {
                display: flex !important;
                width: 100% !important;
            }

            .back-to-list-btn {
                display: block !important;
                margin-right: 4px;
            }
            /* Компактная шапка на телефоне */
            .chat-header {
                padding: 8px 10px !important;
                background: #0f172a !important;
            }

            .chat-user-meta {
                gap: 8px !important;
            }

            .avatar-wrapper {
                width: 34px !important;
                height: 34px !important;
            }

            .user-name-title {
                font-size: 0.88rem !important;
            }

            .user-handle-subtitle {
                font-size: 0.7rem !important;
            }
            /* Скрываем подпись в блоке Takeover, оставляя только статус и свитч */
            #takeoverSubLabel {
                display: none !important;
            }

            .human-takeover-box {
                padding: 4px 8px !important;
                gap: 6px !important;
            }

            .takeover-status-label {
                font-size: 0.72rem !important;
            }
            /* ПАНЕЛЬ ВВОДА СТРОГО НАМЕРТВО ВНИЗУ (УЧЕТ SAFE AREA ДЛЯ IPHONE) */
            .chat-input-panel {
                padding: 8px 10px !important;
                padding-bottom: max(8px, env(safe-area-inset-bottom)) !important;
                background: #0f172a !important;
            }

            .msg-bubble {
                max-width: 85% !important;
                font-size: 0.88rem !important;
            }
        }

        /* МОДАЛЬНОЕ ОКНО ПРЕДУПРЕЖДЕНИЯ 24 ЧАСОВ (ПОВЕРХ ВСЕГО) */
        .meta-window-overlay {
            display: none;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(8px) !important;
            -webkit-backdrop-filter: blur(8px) !important;
            z-index: 999999 !important; /* Поверх любого окна и мобильного чата */
            justify-content: center;
            align-items: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .meta-window-modal {
            background: var(--card-bg, #1e293b);
            border: 1px solid rgba(234, 179, 8, 0.4);
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 2rem 1.75rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
            text-align: center;
            position: relative;
            box-sizing: border-box;
            animation: modalPopIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes modalPopIn {
            from
        {
            opacity: 0;
            transform: scale(0.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
        }

        /* КРАСИВАЯ КНОПКА ДЛЯ МОДАЛКИ 24 ЧАСОВ */
        .btn-modal-action {
            width: 100% !important;
            padding: 12px 20px !important;
            background: var(--accent-color, #6366f1) !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
            font-size: 0.95rem !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3) !important;
        }

        .btn-modal-action:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        /* АНИМАЦИЯ СЕРДЕЧКА INSTAGRAM ПО ДАБЛ-КЛИКУ */
        .msg-bubble {
            position: relative; /* Чтобы сердечко позиционировалось по центру бабла */
            user-select: none; /* Чтобы при дабл-клике не выделялся текст */
        }

        /* Всплывающее и исчезающее сердечко */
        .heart-pop {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            font-size: 2.5rem;
            animation: heartPopAnim 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            pointer-events: none;
            z-index: 50;
        }

        @@keyframes heartPopAnim {
            0% {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }

            50% {
                transform: translate(-50%, -50%) scale(1.4);
                opacity: 1;
            }

            80% {
                transform: translate(-50%, -50%) scale(1.1);
                opacity: 0.9;
            }

            100% {
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0;
            }
        }

        /* Закрепленный маленький бейдж реакции в углу бабла */
        .reaction-badge {
            position: absolute;
            bottom: -8px;
            right: 12px;
            background: #1e293b;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1px 6px;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            animation: reactionBadgePop 0.2s ease-out;
        }

        @@keyframes reactionBadgePop {
            from {
                transform: scale(0);
            }

            to {
                transform: scale(1);
            }
        }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">
        ← Профили
    </a>
}

<div class="inbox-wrapper">
    <div class="inbox-card" id="inboxCard">

        <!-- 1. ЛЕВАЯ КОЛОНКА (ДИАЛОГИ) -->
        <div class="inbox-sidebar">
            <div class="sidebar-header">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div class="search-input-box" style="flex: 1;">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" placeholder="Поиск по имени или тексту..." oninput="onSearchInput(this.value)">
                    </div>
                    <!-- КНОПКА СИНХРОНИЗАЦИИ -->
                    <button type="button" class="pill-btn" onclick="syncInbox()" id="syncBtn" title="Синхронизировать диалоги из соцсетей" style="padding: 8px 10px; font-size: 0.9rem;">
                        🔄
                    </button>
                </div>

                <!-- Фильтры соцсетей -->
                <div class="network-filter-pills">
                    <button type="button" class="pill-btn active" data-net="ALL" onclick="filterNetwork('ALL', this)">Все</button>
                    <button type="button" class="pill-btn" data-net="INSTAGRAM" onclick="filterNetwork('INSTAGRAM', this)">📸 Instagram</button>
                    <button type="button" class="pill-btn" data-net="TELEGRAM" onclick="filterNetwork('TELEGRAM', this)">✈️ Telegram</button>
                    <button type="button" class="pill-btn" data-net="FACEBOOK" onclick="filterNetwork('FACEBOOK', this)">📘 Messenger</button>
                    <button type="button" class="pill-btn" data-net="BLUESKY" onclick="filterNetwork('BLUESKY', this)">🦋 BlueSky</button>
                    <button type="button" class="pill-btn" data-net="THREADS" onclick="filterNetwork('THREADS', this)">🧵 Threads</button>
                </div>
            </div>

            <!-- Список диалогов -->
            <div class="dialogs-list" id="dialogsContainer">
                <div id="dialogsLoading" style="text-align: center; padding: 2rem; color: var(--text-secondary);">
                    ⏳ Загрузка диалогов...
                </div>
            </div>
        </div>

        <!-- 2. ПРАВАЯ КОЛОНКА (ЧАТ) -->
        <div class="inbox-chat-area" id="chatArea">

            <!-- Заглушка, когда диалог не выбран -->
            <div class="empty-chat-state" id="emptyChatState">
                <div style="font-size: 3rem;">💬</div>
                <h3 style="margin: 0; color: var(--text-main);">Выберите диалог</h3>
                <p style="font-size: 0.85rem; max-width: 320px; margin: 0;">
                    Выберите переписку из списка слева, чтобы просмотреть историю и ответить клиенту.
                </p>
            </div>

            <!-- Активный диалог -->
            <div id="activeChatWrapper" class="active-chat-wrapper" style="display: none;">

                <!-- Компактная шапка чата без наложений -->
                <div class="chat-header">
                    <div class="chat-user-meta">
                        <button type="button" class="back-to-list-btn" onclick="closeMobileChat()">←</button>
                        <div class="avatar-wrapper" style="width: 36px; height: 36px;">
                            <div class="chat-avatar" id="activeAvatar">U</div>
                            <div class="network-badge-mini" id="activeNetBadge">📸</div>
                        </div>
                        <div class="user-text-details">
                            <div id="activeChatName" class="user-name-title">Имя Клиента</div>
                            <div id="activeChatHandle" class="user-handle-subtitle">@@username</div>
                        </div>
                    </div>

                    <!-- HUMAN TAKEOVER -->
                    <div class="human-takeover-box">
                        <div style="text-align: right;">
                            <div class="takeover-status-label" id="takeoverLabel" style="color: #10b981;">🤖 ИИ</div>
                            <div style="font-size: 0.65rem; color: var(--text-secondary);" id="takeoverSubLabel">Бот отвечает сам</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="takeoverToggle" onchange="onTakeoverToggleChanged(this.checked)">
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>

                <!-- Скроллящаяся лента сообщений -->
                <div class="messages-stream" id="messagesStream"></div>

                <!-- Намертво закрепленная панель ввода внизу -->
                <div class="chat-input-panel">
                    <div class="input-tools-row">
                        <span style="font-size: 0.72rem; color: var(--text-secondary);" id="replyingAsNotice">
                            ✍️ Ответ клиенту
                        </span>
                    </div>

                    <div class="input-row">
                        <textarea id="messageInput" class="chat-textarea" placeholder="Напишите ответ клиенту..." onkeydown="handleInputKeydown(event)"></textarea>
                        <button type="button" class="btn-send" onclick="sendManualMessage()">➤</button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- МОДАЛКА: 24-ЧАСОВОЕ ОКНО META ЗАКРЫТО (ИСПРАВЛЕННАЯ) -->
<div id="metaWindowModalOverlay" class="meta-window-overlay" onclick="closeMetaWindowModal()">
    <div class="meta-window-modal" onclick="event.stopPropagation()">
        <div style="font-size: 3.5rem; margin-bottom: 0.5rem; line-height: 1;">⏳</div>
        <h3 style="margin: 0 0 10px 0; color: #d97706; font-size: 1.3rem; font-weight: 800;">
            24-часовое окно ответа закрыто
        </h3>

        <p style="color: var(--text-secondary, #64748b); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.25rem;">
            Политика безопасности Meta запрещает отправку сообщений через сторонние сервисы, если с момента последнего сообщения клиента прошло больше 24 часов.
        </p>

        <!-- КОНТРАСТНЫЙ ЧИТАЕМЫЙ БЛОК -->
        <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 14px; padding: 14px; text-align: left; font-size: 0.85rem; color: var(--text-main, #1e293b); line-height: 1.5; margin-bottom: 1.5rem;">
            <div style="color: #d97706; font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                <span>📱</span> Как отправить ответ прямо сейчас:
            </div>
            Откройте официальное приложение <strong>Instagram</strong> на телефоне и отправьте ответ оттуда напрямую. На мобильное приложение это ограничение не действует, а ваш ответ сразу отобразится здесь в чате!
        </div>

        <button type="button" class="btn-modal-action" onclick="closeMetaWindowModal()">
            Понятно
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const profileId = @activeProfileId;
        let currentNetworkFilter = 'ALL';
        let currentConversationId = null;
        let allLoadedDialogs = [];

        // 1. SIGNALR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/inboxHub")
            .withAutomaticReconnect()
            .build();

        // 2. ОБНОВЛЕННЫЙ СЛУШАТЕЛЬ SIGNALR (БЕЗ СДВИГА АРГУМЕНТОВ)
        connection.on("ReceiveInboxMessage", (payload) => {
            console.log("⚡ [SignalR] Новое сообщение:", payload);

            const localTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (currentConversationId && Number(currentConversationId) === Number(payload.conversationId)) {
                const stream = document.getElementById('messagesStream');

                // Защита от дублей своего же сообщения
                if (!payload.isIncoming && !payload.isSentByBot && stream) {
                    const pendingBubble = stream.querySelector('.msg-outgoing-human[data-pending="true"]');
                    if (pendingBubble && pendingBubble.dataset.text === payload.text) {
                        pendingBubble.removeAttribute('data-pending');
                        updateDialogSnippet(payload.conversationId, payload.lastSnippet, localTime, payload.unreadCount);
                        return;
                    }
                }

                // ПРАВИЛЬНЫЙ ПОРЯДОК: messageId, text, isIncoming, isSentByBot, time, reaction
                appendMessageBubble(payload.messageId, payload.text, payload.isIncoming, payload.isSentByBot, localTime, null);
                scrollChatToBottom();
            }

            updateDialogSnippet(payload.conversationId, payload.lastSnippet, localTime, payload.unreadCount);
        });

        connection.on("TakeoverStatusChanged", (conversationId, isTakeover) => {
            if (currentConversationId === conversationId) {
                updateTakeoverUi(isTakeover);
            }
        });

        connection.start().then(() => {
            console.log("✅ SignalR подключен к InboxHub!");
            if (profileId > 0) {
                connection.invoke("JoinProfileRoom", profileId);
            }
        }).catch(err => console.error("Ошибка подключения SignalR:", err));

        // 2. ЗАГРУЗКА ДИАЛОГОВ
        async function loadDialogs() {
            const container = document.getElementById('dialogsContainer');
            container.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">⏳ Загрузка диалогов...</div>';

            try {
                const res = await fetch(`/inbox/dialogs?profileId=${profileId}&network=${currentNetworkFilter}`);
                if (!res.ok) throw new Error("Ошибка запроса");

                allLoadedDialogs = await res.json();
                renderDialogsList(allLoadedDialogs);
            } catch (err) {
                container.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;">❌ Ошибка загрузки диалогов</div>';
            }
        }

        function renderDialogsList(dialogs) {
            const container = document.getElementById('dialogsContainer');
            container.innerHTML = '';

            if (!dialogs || dialogs.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📭</div>
                        <div style="font-weight: 700; color: var(--text-main);">Диалогов пока нет</div>
                        <div style="font-size: 0.75rem; margin-top: 6px; margin-bottom: 15px;">Нажмите кнопку ниже, чтобы синхронизировать диалоги.</div>
                        <button type="button" class="pill-btn" onclick="syncInbox()" style="margin: 0 auto; background: var(--accent-color); color: #fff; padding: 8px 16px;">
                            🔄 Синхронизировать диалоги
                        </button>
                    </div>
                `;
                return;
            }

            dialogs.forEach(d => {
                const item = document.createElement('div');
                item.className = `dialog-item ${currentConversationId === d.id ? 'active' : ''}`;
                item.dataset.id = d.id;
                item.onclick = () => selectDialog(d.id);

                const badge = getNetworkBadge(d.networkType);
                const avatarContent = d.avatar
                    ? `<img src="${d.avatar}" class="chat-avatar" alt="Avatar" referrerpolicy="no-referrer" onerror="this.onerror=null; this.outerHTML='<div class=\\'chat-avatar\\' style=\\'background:${badge.color};\\'>${getInitials(d.name)}</div>';">`
                    : `<div class="chat-avatar" style="background:${badge.color};">${getInitials(d.name)}</div>`;

                item.innerHTML = `
                    <div class="avatar-wrapper">
                        ${avatarContent}
                        <div class="network-badge-mini" style="background:${badge.color};">${badge.icon}</div>
                    </div>
                    <div class="dialog-info">
                        <div class="dialog-top-row">
                            <span class="dialog-title">${escapeHtml(d.name)}</span>
                            <span class="dialog-time" id="time_${d.id}">${d.time}</span>
                        </div>
                        <div class="dialog-bottom-row">
                            <span class="dialog-snippet" id="snippet_${d.id}">${escapeHtml(d.snippet || "Вложение")}</span>
                            ${d.unreadCount > 0 ? `<span class="unread-count-badge" id="unread_${d.id}">${d.unreadCount}</span>` : ''}
                        </div>
                    </div>
                `;

                container.appendChild(item);
            });
        }

        // 3. ОТКРЫТИЕ ДИАЛОГА
        async function selectDialog(conversationId) {
            currentConversationId = conversationId;

            document.querySelectorAll('.dialog-item').forEach(el => el.classList.remove('active'));
            const activeEl = document.querySelector(`.dialog-item[data-id="${conversationId}"]`);
            if (activeEl) {
                activeEl.classList.add('active');
                const unread = document.getElementById(`unread_${conversationId}`);
                if (unread) unread.remove();
            }

            document.getElementById('emptyChatState').style.display = 'none';
            const chatWrapper = document.getElementById('activeChatWrapper');
            chatWrapper.style.display = 'flex';

            const stream = document.getElementById('messagesStream');
            stream.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">⏳ Загрузка сообщений...</div>';

            try {
                const res = await fetch(`/inbox/messages/${conversationId}`);
                if (!res.ok) throw new Error("Не удалось загрузить сообщения");

                const data = await res.json();

                const badge = getNetworkBadge(data.networkType);
                document.getElementById('activeChatName').textContent = data.name;
                document.getElementById('activeChatHandle').textContent = `${badge.name} • ${data.username ? '@@' + data.username : ''}`;
                document.getElementById('activeNetBadge').textContent = badge.icon;
                document.getElementById('activeNetBadge').style.background = badge.color;

                const avatarElem = document.getElementById('activeAvatar');
                if (data.avatar) {
                    avatarElem.outerHTML = `<img src="${data.avatar}" id="activeAvatar" class="chat-avatar" alt="Avatar" referrerpolicy="no-referrer" onerror="this.onerror=null; this.outerHTML='<div class=\\'chat-avatar\\' id=\\'activeAvatar\\' style=\\'background:${badge.color};\\'>${getInitials(data.name)}</div>';">`;
                } else {
                    avatarElem.outerHTML = `<div class="chat-avatar" id="activeAvatar" style="background:${badge.color};">${getInitials(data.name)}</div>`;
                }

                document.getElementById('replyingAsNotice').innerHTML = `✍️ Вы отвечаете в <strong>${badge.name}</strong>`;

                updateTakeoverUi(data.isTakeover);

                stream.innerHTML = '';
                if (data.messages && data.messages.length > 0) {
                    data.messages.forEach(m => {
                        appendMessageBubble(m.id, m.text, m.isIncoming, m.isSentByBot, m.time, m.reaction);
                    });
                } else {
                    stream.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">История сообщений пуста</div>';
                }

                // Прокрутка вниз
                scrollChatToBottom();

                // Мобильный режим: открываем чат на весь экран
                document.getElementById('inboxCard').classList.add('mobile-chat-open');

            } catch (err) {
                stream.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;">❌ Ошибка загрузки переписки</div>';
            }
        }

        // 4. РУЧНАЯ ОТПРАВКА С ЗАЩИТОЙ И КРАСИВОЙ ОБРАБОТКОЙ ОШИБОК
        async function sendManualMessage() {
            if (!currentConversationId) return;

            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if (!text) return;

            // Временно очищаем поле ввода
            input.value = '';

            // Оптимистично отображаем бабл
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            appendMessageBubble(null, text, false, false, timeStr, true);
            scrollChatToBottom();

            updateTakeoverUi(true);

            try {
                const res = await fetch('/inbox/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversationId: currentConversationId, text: text })
                });

                if (!res.ok) {
                    const err = await res.text();

                    // 1. Убираем повисший неотправленный бабл из ленты
                    const stream = document.getElementById('messagesStream');
                    const pendingBubble = stream.querySelector('.msg-outgoing-human[data-pending="true"]');
                    if (pendingBubble) pendingBubble.remove();

                    // 2. ВОЗВРАЩАЕМ ТЕКСТ ОБРАТНО В ПОЛЕ ВВОДА (чтобы менеджер не потерял напечатанное!)
                    input.value = text;

                    // 3. КРАСИВАЯ ОБРАБОТКА ОШИБКИ
                    if (err.includes("OUTSIDE_24H_WINDOW") || err.includes("outside of allowed window") || err.includes("2534022")) {
                        openMetaWindowModal();
                    } else {
                        alert("Ошибка отправки: " + err);
                    }
                }
            } catch (err) {
                // При ошибке сети также возвращаем текст
                const stream = document.getElementById('messagesStream');
                const pendingBubble = stream.querySelector('.msg-outgoing-human[data-pending="true"]');
                if (pendingBubble) pendingBubble.remove();
                input.value = text;
                alert("Ошибка сети при отправке сообщения");
            }
        }

        function openMetaWindowModal() {
            const overlay = document.getElementById('metaWindowModalOverlay');
            if (overlay) {
                overlay.style.display = 'flex';
            }
        }

        function closeMetaWindowModal() {
            const overlay = document.getElementById('metaWindowModalOverlay');
            if (overlay) {
                overlay.style.display = 'none';
            }
        }

        // 5. HUMAN TAKEOVER
        async function onTakeoverToggleChanged(isChecked) {
            if (!currentConversationId) return;
            updateTakeoverUi(isChecked);

            try {
                await fetch('/inbox/takeover', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversationId: currentConversationId, isTakeover: isChecked })
                });
            } catch (err) {
                console.error("Ошибка смены статуса takeover:", err);
            }
        }

        function updateTakeoverUi(isTakeover) {
            const toggle = document.getElementById('takeoverToggle');
            const label = document.getElementById('takeoverLabel');
            const subLabel = document.getElementById('takeoverSubLabel');

            if (toggle) toggle.checked = isTakeover;

            if (isTakeover) {
                label.textContent = "👤 Ручной";
                label.style.color = "#f43f5e";
                if (subLabel) subLabel.textContent = "ИИ отключен";
            } else {
                label.textContent = "🤖 ИИ";
                label.style.color = "#10b981";
                if (subLabel) subLabel.textContent = "Бот отвечает сам";
            }
        }

        // 1. ОБНОВЛЕННАЯ ФУНКЦИЯ ДОБАВЛЕНИЯ БАБЛА (с поддержкой сохраненных сердечек)
        function appendMessageBubble(messageId, text, isIncoming, isSentByBot, time, reaction = null, isPending = false) {
            const stream = document.getElementById('messagesStream');
            const bubble = document.createElement('div');

            if (isPending) {
                bubble.setAttribute('data-pending', 'true');
                bubble.dataset.text = text;
            }

            if (messageId) {
                bubble.dataset.msgId = messageId;
            }

            let reactionHtml = reaction ? `<div class="reaction-badge">${escapeHtml(reaction)}</div>` : '';

            if (isIncoming) {
                bubble.className = 'msg-bubble msg-incoming';
                bubble.innerHTML = `<div>${escapeHtml(text)}</div>${reactionHtml}<div class="msg-footer"><span>${time}</span></div>`;
                bubble.ondblclick = () => handleMessageDoubleClick(bubble, messageId);
            } else if (isSentByBot) {
                bubble.className = 'msg-bubble msg-outgoing-bot';
                bubble.innerHTML = `<div>${escapeHtml(text)}</div>${reactionHtml}<div class="msg-footer"><span class="sender-tag" style="color:#c084fc;">🤖 Бот ИИ</span><span>${time}</span></div>`;
            } else {
                bubble.className = 'msg-bubble msg-outgoing-human';
                bubble.innerHTML = `<div>${escapeHtml(text)}</div>${reactionHtml}<div class="msg-footer"><span class="sender-tag" style="color:#ffffff;">👤 Вы</span><span>${time}</span></div>`;
            }

            stream.appendChild(bubble);
        }

        function updateDialogSnippet(convId, snippet, time, unreadCount) {
            const snipElem = document.getElementById(`snippet_${convId}`);
            const timeElem = document.getElementById(`time_${convId}`);
            if (snipElem) snipElem.textContent = snippet;
            if (timeElem) timeElem.textContent = time;

            const item = document.querySelector(`.dialog-item[data-id="${convId}"]`);
            const container = document.getElementById('dialogsContainer');
            if (item && container) {
                container.prepend(item);
            }
        }

        function getNetworkBadge(networkType) {
            switch (networkType) {
                case 1: return { name: "Instagram Direct", icon: "📸", color: "#e1306c" };
                case 2: return { name: "Facebook Messenger", icon: "📘", color: "#1877F2" };
                case 3: return { name: "Telegram", icon: "✈️", color: "#2AABEE" };
                case 4: return { name: "Threads", icon: "🧵", color: "#000000" };
                case 5: return { name: "BlueSky", icon: "🦋", color: "#0085ff" };
                default: return { name: "Соцсеть", icon: "💬", color: "#6366f1" };
            }
        }

        function getInitials(name) {
            if (!name) return "U";
            const parts = name.trim().split(' ');
            return parts.length > 1 ? (parts[0][0] + parts[1][0]) : name.substring(0, 2);
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        function scrollChatToBottom() {
            const stream = document.getElementById('messagesStream');
            if (stream) {
                setTimeout(() => {
                    stream.scrollTop = stream.scrollHeight;
                }, 80);
            }
        }

        function handleInputKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendManualMessage();
            }
        }

        function closeMobileChat() {
            document.getElementById('inboxCard').classList.remove('mobile-chat-open');
        }

        function filterNetwork(net, btn) {
            currentNetworkFilter = net;
            document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            loadDialogs();
        }

        function onSearchInput(query) {
            query = query.toLowerCase().trim();
            document.querySelectorAll('.dialog-item').forEach(item => {
                const title = item.querySelector('.dialog-title')?.textContent.toLowerCase() || '';
                const snippet = item.querySelector('.dialog-snippet')?.textContent.toLowerCase() || '';
                item.style.display = (title.includes(query) || snippet.includes(query)) ? 'flex' : 'none';
            });
        }

        async function syncInbox() {
            const syncBtn = document.getElementById('syncBtn');
            if (syncBtn) {
                syncBtn.style.transform = 'rotate(360deg)';
                syncBtn.style.transition = 'transform 0.8s ease';
            }

            try {
                const res = await fetch(`/inbox/sync?profileId=${profileId}`, { method: 'POST' });
                if (res.ok) {
                    await loadDialogs();
                } else {
                    alert("Не удалось синхронизировать диалоги");
                }
            } catch {
                alert("Ошибка сети при синхронизации");
            } finally {
                if (syncBtn) {
                    setTimeout(() => {
                        syncBtn.style.transform = 'none';
                        syncBtn.style.transition = 'none';
                    }, 800);
                }
            }
        }

        // Автоматический перезаход в комнату профиля при переподключении сети/сервера:
        connection.onreconnected(async (newConnectionId) => {
            console.log("🔄 [SignalR] Связь восстановлена! Повторный вход в комнату профиля...", newConnectionId);
            if (profileId > 0) {
                try {
                    await connection.invoke("JoinProfileRoom", profileId);
                    console.log("✅ [SignalR] Успешно вернулись в комнату профиля!");
                    // Освежаем список диалогов на случай, если что-то пропустили во время обрыва
                    await loadDialogs();
                } catch (e) {
                    console.error("Ошибка повторного входа в комнату:", e);
                }
            }
        });

        // ОБРАБОТКА ДВОЙНОГО КЛИКА (ЛАЙК СООБЩЕНИЯ)
        async function handleMessageDoubleClick(bubbleElement, messageId) {
            if (!messageId) return;

            // 1. АНИМИРУЕМ ВСПЛЫВАЮЩЕЕ СЕРДЕЧКО В ЦЕНТРЕ БАБЛА
            const heart = document.createElement('div');
            heart.className = 'heart-pop';
            heart.textContent = '❤️';
            bubbleElement.appendChild(heart);

            // Удаляем элемент анимации через 0.7 сек
            setTimeout(() => heart.remove(), 700);

            // 2. ЗАКРЕПЛЯЕМ МАЛЕНЬКИЙ БЕЙДЖ СЕРДЕЧКА В УГЛУ СООБЩЕНИЯ (если его еще нет)
            let badge = bubbleElement.querySelector('.reaction-badge');
            if (!badge) {
                badge = document.createElement('div');
                badge.className = 'reaction-badge';
                badge.textContent = '❤️';
                bubbleElement.appendChild(badge);
            }

            // 3. ОТПРАВЛЯЕМ ЗАПРОС В ИНСТАГРАМ API
            try {
                const res = await fetch('/inbox/react', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: messageId, reaction: 'love' })
                });

                if (!res.ok) {
                    console.warn("Не удалось отправить реакцию в Instagram API");
                }
            } catch (err) {
                console.error("Ошибка сети при отправке реакции:", err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadDialogs();
        });
    </script>
}