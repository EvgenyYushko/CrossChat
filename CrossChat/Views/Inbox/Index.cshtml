@{
    ViewData["Title"] = "Единый Инбокс";
    int activeProfileId = ViewBag.ActiveProfileId ?? 0;
}

@section Styles {
    <style>
        /* ДЕСКТОП: АККУРАТНОЕ СТЕКЛЯННОЕ ОКНО */
        .inbox-wrapper {
            max-width: 1300px;
            margin: 5rem auto 1.5rem;
            padding: 0 1rem;
            height: calc(100vh - 7.5rem);
            min-height: 550px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        .inbox-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            flex: 1;
            height: 100%;
            min-height: 0;
            display: grid;
            grid-template-columns: 340px 1fr;
            overflow: hidden;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        /* ЛЕВАЯ КОЛОНКА (СПИСОК) */
        .inbox-sidebar {
            border-right: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            background: rgba(15, 23, 42, 0.4);
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .sidebar-header {
            padding: 1rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex-shrink: 0;
        }

        .search-input-box {
            position: relative;
            width: 100%;
        }

            .search-input-box input {
                width: 100%;
                box-sizing: border-box;
                background: var(--input-bg, rgba(255, 255, 255, 0.05));
                border: 1px solid var(--glass-border);
                border-radius: 10px;
                padding: 8px 12px 8px 32px;
                color: var(--text-main);
                font-size: 0.85rem;
                outline: none;
            }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

       .network-filter-pills {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 4px;
            /* Разрешаем плавный скролл */
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            /* Тонкий аккуратный скроллбар вместо невидимого */
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
        }

        .network-filter-pills::-webkit-scrollbar {
            height: 4px; /* Тонкая элегантная полоска */
        }

        .network-filter-pills::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

       .pill-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 5px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            /* ГЛАВНОЕ: запрещаем сжимать кнопки! */
            flex-shrink: 0 !important;
        }

        .pill-btn:hover, .pill-btn.active {
            background: var(--accent-color, #6366f1);
            border-color: var(--accent-color, #6366f1);
            color: #fff;
        }

        .dialogs-list {
            flex: 1 1 0;
            min-height: 0;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .dialog-item {
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            cursor: pointer;
            transition: background 0.15s;
            position: relative;
        }

            .dialog-item:hover {
                background: rgba(255, 255, 255, 0.03);
            }

            .dialog-item.active {
                background: rgba(99, 102, 241, 0.12);
                border-left: 3px solid var(--accent-color, #6366f1);
            }

        .avatar-wrapper {
            position: relative;
            width: 44px;
            height: 44px;
            flex-shrink: 0;
        }

        .chat-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .network-badge-mini {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--card-bg, #1e293b);
            font-size: 9px;
        }

        .dialog-info {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .dialog-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dialog-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-main);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dialog-time {
            font-size: 0.72rem;
            color: var(--text-secondary);
        }

        .dialog-bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        .dialog-snippet {
            font-size: 0.8rem;
            color: var(--text-secondary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
        }

        .unread-count-badge {
            background: var(--accent-color, #6366f1);
            color: #fff;
            font-size: 0.7rem;
            font-weight: bold;
            border-radius: 10px;
            padding: 2px 6px;
            min-width: 16px;
            text-align: center;
        }

        /* ПРАВАЯ КОЛОНКА (ЧАТ) */
        .inbox-chat-area {
            display: flex;
            flex-direction: column;
            background: rgba(15, 23, 42, 0.15);
            position: relative;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .active-chat-wrapper {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
            width: 100%;
            overflow: hidden;
        }

        /* ШАПКА ДИАЛОГА */
        .chat-header {
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(15, 23, 42, 0.6);
            gap: 8px;
            flex-shrink: 0;
            z-index: 10;
        }

        .chat-user-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            min-width: 0; /* Обязательно для text-overflow у имени */
        }

        .user-text-details {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .user-name-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-handle-subtitle {
            font-size: 0.75rem;
            color: var(--text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .back-to-list-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 1.4rem;
            cursor: pointer;
            padding: 4px;
            line-height: 1;
        }

        /* БЛОК HUMAN TAKEOVER */
        .human-takeover-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            padding: 5px 10px;
            border-radius: 12px;
            flex-shrink: 0;
        }

        .takeover-status-label {
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .3s;
            border-radius: 20px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 14px;
                width: 14px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .3s;
                border-radius: 50%;
            }

        input:checked ~ .slider {
            background-color: #f43f5e;
        }

            input:checked ~ .slider:before {
                transform: translateX(20px);
            }

        /* ЛЕНТА СООБЩЕНИЙ */
        .messages-stream {
            flex: 1 1 0;
            min-height: 0;
            padding: 1rem 1.25rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

        .msg-bubble {
            max-width: 75%;
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 0.9rem;
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            gap: 4px;
            word-wrap: break-word;
        }

        .msg-incoming {
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-bottom-left-radius: 4px;
        }

        .msg-outgoing-bot {
            align-self: flex-end;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(168, 85, 247, 0.25));
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: var(--text-main);
            border-bottom-right-radius: 4px;
        }

        .msg-outgoing-human {
            align-self: flex-end;
            background: var(--accent-color, #6366f1);
            color: #ffffff;
            border-bottom-right-radius: 4px;
        }

        .msg-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 5px;
            font-size: 0.68rem;
            opacity: 0.65;
        }

        .sender-tag {
            font-size: 0.68rem;
            font-weight: bold;
            padding: 1px 5px;
            border-radius: 4px;
            background: rgba(0, 0, 0, 0.25);
        }

        /* ЗАКРЕПЛЕННАЯ ПАНЕЛЬ ВВОДА ВНИЗУ */
        .chat-input-panel {
            padding: 0.75rem 1.25rem;
            border-top: 1px solid var(--glass-border);
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-shrink: 0;
            z-index: 20;
        }

        .input-tools-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .input-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .chat-textarea {
            flex: 1;
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-main);
            padding: 10px 14px;
            font-size: 0.92rem;
            resize: none;
            outline: none;
            height: 42px;
            box-sizing: border-box;
            font-family: inherit;
        }

            .chat-textarea:focus {
                border-color: var(--accent-color, #6366f1);
            }

        .btn-send {
            background: var(--accent-color, #6366f1);
            color: white;
            border: none;
            border-radius: 12px;
            width: 44px;
            height: 42px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: transform 0.15s;
        }

            .btn-send:active {
                transform: scale(0.95);
            }

        .empty-chat-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            gap: 12px;
            text-align: center;
            padding: 2rem;
        }

        /* ========================================================================= */
        /* РЕЖИМ «МОБИЛЬНЫЙ МЕССЕНДЖЕР» (КАК В TELEGRAM / WHATSAPP)                 */
        /* ========================================================================= */
        @@media (max-width: 768px) {
            .inbox-wrapper {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                height: 100dvh !important; /* Настоящая высота мобильного экрана с учетом клавиатуры */
                margin: 0 !important;
                padding: 0 !important;
                z-index: 10000;
                border-radius: 0 !important;
            }

            .inbox-card {
                border: none !important;
                border-radius: 0 !important;
                grid-template-columns: 1fr !important;
                height: 100% !important;
            }
            /* По умолчанию виден список диалогов */
            .inbox-chat-area {
                display: none;
            }

            .inbox-sidebar {
                width: 100% !important;
                height: 100% !important;
            }
            /* Когда открыт чат — список диалогов скрывается, чат занимает весь экран */
            .inbox-card.mobile-chat-open .inbox-sidebar {
                display: none !important;
            }

            .inbox-card.mobile-chat-open .inbox-chat-area {
                display: flex !important;
                width: 100% !important;
            }

            .back-to-list-btn {
                display: block !important;
                margin-right: 4px;
            }
            /* Компактная шапка на телефоне */
            .chat-header {
                padding: 8px 10px !important;
                background: #0f172a !important;
            }

            .chat-user-meta {
                gap: 8px !important;
            }

            .avatar-wrapper {
                width: 34px !important;
                height: 34px !important;
            }

            .user-name-title {
                font-size: 0.88rem !important;
            }

            .user-handle-subtitle {
                font-size: 0.7rem !important;
            }
            /* Скрываем подпись в блоке Takeover, оставляя только статус и свитч */
            #takeoverSubLabel {
                display: none !important;
            }

            .human-takeover-box {
                padding: 4px 8px !important;
                gap: 6px !important;
            }

            .takeover-status-label {
                font-size: 0.72rem !important;
            }
            /* ПАНЕЛЬ ВВОДА СТРОГО НАМЕРТВО ВНИЗУ (УЧЕТ SAFE AREA ДЛЯ IPHONE) */
            .chat-input-panel {
                padding: 8px 10px !important;
                padding-bottom: max(8px, env(safe-area-inset-bottom)) !important;
                background: #0f172a !important;
            }

            .msg-bubble {
                max-width: 85% !important;
                font-size: 0.88rem !important;
            }
        }

        /* МОДАЛЬНОЕ ОКНО ПРЕДУПРЕЖДЕНИЯ 24 ЧАСОВ (ПОВЕРХ ВСЕГО) */
        .meta-window-overlay {
            display: none;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(8px) !important;
            -webkit-backdrop-filter: blur(8px) !important;
            z-index: 999999 !important; /* Поверх любого окна и мобильного чата */
            justify-content: center;
            align-items: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .meta-window-modal {
            background: var(--card-bg, #1e293b);
            border: 1px solid rgba(234, 179, 8, 0.4);
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 2rem 1.75rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
            text-align: center;
            position: relative;
            box-sizing: border-box;
            animation: modalPopIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes modalPopIn {
            from
        {
            opacity: 0;
            transform: scale(0.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
        }

        /* КРАСИВАЯ КНОПКА ДЛЯ МОДАЛКИ 24 ЧАСОВ */
        .btn-modal-action {
            width: 100% !important;
            padding: 12px 20px !important;
            background: var(--accent-color, #6366f1) !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
            font-size: 0.95rem !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3) !important;
        }

        .btn-modal-action:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        /* АНИМАЦИЯ СЕРДЕЧКА INSTAGRAM ПО ДАБЛ-КЛИКУ */
        .msg-bubble {
            position: relative; /* Чтобы сердечко позиционировалось по центру бабла */
            user-select: none; /* Чтобы при дабл-клике не выделялся текст */
        }

        /* Всплывающее и исчезающее сердечко */
        .heart-pop {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            font-size: 2.5rem;
            animation: heartPopAnim 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            pointer-events: none;
            z-index: 50;
        }

        @@keyframes heartPopAnim {
            0% {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }

            50% {
                transform: translate(-50%, -50%) scale(1.4);
                opacity: 1;
            }

            80% {
                transform: translate(-50%, -50%) scale(1.1);
                opacity: 0.9;
            }

            100% {
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0;
            }
        }

        /* Закрепленный маленький бейдж реакции в углу бабла */
        .reaction-badge {
            position: absolute;
            bottom: -8px;
            right: 12px;
            background: #1e293b;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1px 6px;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            animation: reactionBadgePop 0.2s ease-out;
        }

        @@keyframes reactionBadgePop {
            from {
                transform: scale(0);
            }

            to {
                transform: scale(1);
            }
        }

        /* МЕДИАФАЙЛЫ В СООБЩЕНИЯХ */
        .msg-media-container {
            margin-bottom: 6px;
            border-radius: 10px;
            overflow: hidden;
            max-width: 260px;
        }

        .msg-media-img {
            width: 100%;
            max-height: 260px;
            object-fit: cover;
            border-radius: 10px;
            cursor: zoom-in;
            display: block;
            transition: transform 0.2s ease;
        }

        .msg-media-img:hover {
            transform: scale(1.02);
        }

        .msg-media-video {
            width: 100%;
            max-width: 260px;
            border-radius: 10px;
            outline: none;
            display: block;
        }

        .msg-media-audio {
            width: 100%;
            max-width: 240px;
            height: 36px;
            outline: none;
            margin-top: 4px;
        }

        /* Плашка сгоревшей ссылки */
        .msg-media-expired {
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed var(--glass-border);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.75rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Лайтбокс для просмотра фото на весь экран */
        .inbox-lightbox-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(8px);
            z-index: 1000000;
            justify-content: center;
            align-items: center;
            cursor: zoom-out;
        }

        .inbox-lightbox-img {
            max-width: 90vw;
            max-height: 90vh;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            animation: zoomIn 0.2s ease-out;
        }

        @@keyframes zoomIn {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* === КАСТОМНЫЙ ПЛЕЕР ГОЛОСОВЫХ СООБЩЕНИЙ (КАК В TELEGRAM) === */
        .voice-player-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 10px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            min-width: 220px;
            max-width: 260px;
            box-sizing: border-box;
            user-select: none;
            margin-bottom: 4px;
        }

        /* Круглая кнопка Play / Pause */
        .voice-play-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #2AABEE;
            color: #ffffff;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            font-size: 0.9rem;
            transition: transform 0.15s ease, background 0.2s ease;
            padding-left: 2px; /* Оптическая центровка треугольника Play */
        }

            .voice-play-btn:active {
                transform: scale(0.92);
            }

            .voice-play-btn.playing {
                background: #f43f5e;
                padding-left: 0;
            }

        /* Контейнер дорожки и таймера */
        .voice-track-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
            cursor: pointer;
        }

        /* Звуковая волна из вертикальных полосок */
        .voice-bars-wrap {
            display: flex;
            align-items: center;
            gap: 2.5px;
            height: 20px;
            width: 100%;
        }

        .voice-bar {
            flex: 1;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 2px;
            transition: background 0.15s ease;
            pointer-events: none;
        }

            .voice-bar.active {
                background: #38bdf8; /* Неоново-голубой цвет прослушанной части */
            }

        /* Таймер */
        .voice-time-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-secondary);
            font-family: monospace;
        }

        /* АНИМАЦИЯ РАСТВОРЕНИЯ СООБЩЕНИЯ */
        .msg-bubble.deleting {
            animation: fadeOutShrink 0.35s ease forwards;
            pointer-events: none;
        }

        @@keyframes fadeOutShrink {
            0% {
                opacity: 1;
                transform: scale(1);
                max-height: 200px;
            }

            100% {
                opacity: 0;
                transform: scale(0.8);
                max-height: 0;
                padding-top: 0;
                padding-bottom: 0;
                margin-bottom: 0;
            }
        }

        /* КОНТЕКСТНОЕ МЕНЮ СООБЩЕНИЯ (ПКМ И LONG-PRESS) */
        .msg-context-menu {
            display: none;
            position: fixed;
            background: #1e293b;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 6px;
            z-index: 1000000;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            min-width: 160px;
            animation: menuPop 0.15s ease-out;
        }

        .msg-context-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 8px 12px;
            background: none;
            border: none;
            color: #ef4444; /* Красный цвет удаления */
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border-radius: 8px;
            transition: background 0.15s ease;
            text-align: left;
        }

            .msg-context-btn:hover {
                background: rgba(239, 68, 68, 0.15);
            }

        @@keyframes menuPop {
            from {
                opacity: 0;
                transform: scale(0.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* КНОПКА ПРИКРЕПЛЕНИЯ ФАЙЛА (СКРЕПОЧКА) */
        .btn-attach {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 1.3rem;
            cursor: pointer;
            padding: 0 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s, transform 0.15s;
            flex-shrink: 0;
            line-height: 1;
        }

            .btn-attach:hover {
                color: var(--accent-color, #6366f1);
                transform: scale(1.15);
            }

            .btn-attach:active {
                transform: scale(0.95);
            }

        /* КНОПКА МИКРОФОНА */
        .btn-mic {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s, transform 0.15s;
            flex-shrink: 0;
            line-height: 1;
        }

            .btn-mic:hover {
                color: #ef4444;
                transform: scale(1.15);
            }

        /* ПАНЕЛЬ ЗАПИСИ ГОЛОСОВОГО */
        .voice-recording-ui {
            display: none;
            align-items: center;
            justify-content: space-between;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 12px;
            padding: 8px 14px;
            flex: 1;
            color: #f87171;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .rec-pulse-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ef4444;
            display: inline-block;
            animation: recPulse 1s infinite alternate;
        }

        @@keyframes recPulse {
            from {
                opacity: 0.3;
                transform: scale(0.8);
            }

            to {
                opacity: 1;
                transform: scale(1.2);
            }
        }

        .voice-rec-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-rec-action {
            background: none;
            border: none;
            font-size: 1.1rem;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: background 0.15s;
        }

        .btn-rec-cancel:hover {
            background: rgba(239, 68, 68, 0.2);
        }

        .btn-rec-send:hover {
            background: rgba(16, 185, 129, 0.2);
        }

        /* КАРТОЧКА ПРОГРЕССА ЗАГРУЗКИ ВНУТРИ ЧАТА */
        .upload-progress-card {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 220px;
            max-width: 280px;
        }

        .upload-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .upload-cancel-btn {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 6px;
            line-height: 1;
            transition: background 0.15s;
        }

            .upload-cancel-btn:hover {
                background: rgba(239, 68, 68, 0.2);
            }

        .upload-bar-bg {
            background: rgba(255, 255, 255, 0.1);
            height: 6px;
            border-radius: 6px;
            overflow: hidden;
            position: relative;
        }

        .upload-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            border-radius: 6px;
            transition: width 0.15s ease;
        }

            .upload-bar-fill.processing {
                width: 100% !important;
                background: linear-gradient(90deg, #6366f1, #a855f7);
                animation: barPulse 1.2s infinite ease-in-out;
            }

        @@keyframes barPulse {
            0% {
                opacity: 0.5;
            }

            50% {
                opacity: 1;
            }

            100% {
                opacity: 0.5;
            }
        }

        .upload-footer-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-secondary);
            font-family: monospace;
        }

        .btn-translate {
            background: none;
            border: none;
            color: var(--accent-color, #6366f1);
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            padding: 0;
            opacity: 0.75;
            transition: opacity 0.2s;
        }

        .btn-translate:hover {
            opacity: 1;
            text-decoration: underline;
        }

        /* Кнопка перевода внутри наших исходящих сообщений */
        .msg-outgoing-human .btn-translate,
        .msg-outgoing-bot .btn-translate {
            color: rgba(255, 255, 255, 0.85);
        }

            .msg-outgoing-human .btn-translate:hover,
            .msg-outgoing-bot .btn-translate:hover {
                color: #ffffff;
            }

        /* Цвет переведенного текста внутри исходящих сообщений */
        .msg-outgoing-human .translated-text-block,
        .msg-outgoing-bot .translated-text-block {
            color: #e0e7ff !important;
            border-top-color: rgba(255, 255, 255, 0.25) !important;
        }

        /* БЛОК СИНХРОННОГО ПЕРЕВОДЧИКА В ШАПКЕ */
        .sync-translator-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(56, 189, 248, 0.08);
            border: 1px solid rgba(56, 189, 248, 0.25);
            padding: 5px 10px;
            border-radius: 12px;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .sync-translator-box.active {
            background: rgba(56, 189, 248, 0.18);
            border-color: #38bdf8;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
        }

        .sync-trans-status-label {
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
            color: #38bdf8;
        }

        /* Цвет ползунка при включенном автопереводе */
        input:checked + .slider-trans {
            background-color: #38bdf8 !important;
        }

        /* Маленький бейдж языка у переведенного сообщения */
        .msg-trans-badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 4px;
            background: rgba(56, 189, 248, 0.2);
            color: #38bdf8;
            cursor: help;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            margin-right: 4px;
        }

        .msg-outgoing-human .msg-trans-badge {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        /* 🚀 ГЛОБАЛЬНЫЙ СТИЛЬ: На компьютере тумблеры СТРОГО в один ряд друг за другом! */
        .chat-header-controls {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 10px !important;
            flex-shrink: 0 !important;
        }

        .sync-translator-box, 
        .human-takeover-box {
            display: flex !important;
            align-items: center !important;
            flex-shrink: 0 !important;
            margin: 0 !important;
        }

        /* Адаптив для телефонов */
        @@media (max-width: 768px) {
            .sync-translator-box {
                padding: 4px 6px !important;
                gap: 4px !important;
            }

            #syncTransSubLabel {
                display: none !important;
            }
            /* Контейнер тумблеров */
            .chat-header-controls {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
            }

            .control-label-wrap {
                text-align: right;
                line-height: 1.1;
            }
            /* === МОБИЛЬНАЯ ОПТИМИЗАЦИЯ ДЛЯ ЭКРАНОВ ДО 768px === */
            @@media (max-width: 768px) {
                .chat-header {
                    padding: 6px 8px !important;
                    gap: 6px !important;
                }

                .chat-user-meta {
                    gap: 6px !important;
                    min-width: 0 !important;
                    flex: 1 1 auto !important;
                }

                .user-text-details {
                    min-width: 0 !important;
                    flex: 1 !important;
                }

                .user-name-title {
                    font-size: 0.8rem !important;
                    max-width: 90px !important;
                    white-space: nowrap !important;
                    overflow: hidden !important;
                    text-overflow: ellipsis !important;
                }

                .user-handle-subtitle {
                    font-size: 0.65rem !important;
                }
                /* Ультра-компактные тумблеры */
                .chat-header-controls {
                    gap: 4px !important;
                }

                .sync-translator-box,
                .human-takeover-box {
                    padding: 3px 6px !important;
                    border-radius: 8px !important;
                    gap: 4px !important;
                }
                /* Прячем длинные подписи на телефоне */
                .control-sublabel,
                #takeoverSubLabel,
                #syncTransSubLabel {
                    display: none !important;
                }

                .takeover-status-label {
                    font-size: 0.68rem !important;
                }

                .sync-trans-status-label {
                    font-size: 0.68rem !important;
                }
                /* 🚀 УМЕНЬШЕННЫЙ МОБИЛЬНЫЙ ПЕРЕКЛЮЧАТЕЛЬ (30x16px вместо 40x20px) */
                .switch.mini-switch {
                    width: 30px !important;
                    height: 16px !important;
                }

                .switch.mini-switch .slider:before {
                    height: 12px !important;
                    width: 12px !important;
                    left: 2px !important;
                    bottom: 2px !important;
                }

                .switch.mini-switch input:checked + .slider:before {
                    transform: translateX(14px) !important;
                }
            }
        }

    </style>
}

@section NavbarActions {
    @{
        var network = Context.Request.Query["network"].ToString();
        var botId = Context.Request.Query["botId"].ToString();
        var qProfileId = Context.Request.Query["profileId"].ToString();

        // Подхватываем profileId из query или из текущего активного профиля
        string effectiveProfileId = !string.IsNullOrEmpty(qProfileId) && qProfileId != "0"
            ? qProfileId
            : (ViewBag.ActiveProfileId?.ToString() ?? "0");

        string backUrl;
        string backText = "← Назад";

        // 1. Пришли из конкретной соцсети:
        if (!string.IsNullOrEmpty(network) && !network.Equals("All", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(botId))
        {
            backUrl = network.ToLowerInvariant() switch
            {
                "instagram" => $"/instagram?botId={botId}",
                "facebook" => $"/facebook?botId={botId}",
                "threads" => $"/threads?botId={botId}",
                "telegramchannel" or "telegram" => $"/telegram-channel?botId={botId}",
                "bluesky" => $"/bluesky?botId={botId}",
                "x" or "twitter" => $"/x?botId={botId}",
                "youtube" => $"/youtube?botId={botId}",
                _ => effectiveProfileId != "0" ? $"/profile?profileId={effectiveProfileId}" : "/profiles"
            };
        }
        // 2. Пришли из общего профиля (со всеми соцсетями):
        else if (effectiveProfileId != "0")
        {
            backUrl = $"/profile?profileId={effectiveProfileId}";
        }
        // 3. Запасной фоллбек (на список всех профилей):
        else
        {
            backText = "← Все профили";
            backUrl = "/profiles";
        }
    }

    <a href="@backUrl"
       style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem; font-weight:600; display:inline-flex; align-items:center; gap:4px; transition:color 0.2s ease, transform 0.15s ease;"
       onmouseover="this.style.color='var(--text-main)'; this.style.transform='translateX(-2px)';"
       onmouseout="this.style.color='var(--text-secondary)'; this.style.transform='none';">
        @backText
    </a>
}

<div class="inbox-wrapper">
    <div class="inbox-card" id="inboxCard">

        <!-- 1. ЛЕВАЯ КОЛОНКА (ДИАЛОГИ) -->
        <div class="inbox-sidebar">
            <div class="sidebar-header">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div class="search-input-box" style="flex: 1;">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" placeholder="Поиск по имени или тексту..." oninput="onSearchInput(this.value)">
                    </div>
                    <!-- КНОПКА СИНХРОНИЗАЦИИ -->
                    <button type="button" class="pill-btn" onclick="syncInbox()" id="syncBtn" title="Синхронизировать диалоги из соцсетей" style="padding: 8px 10px; font-size: 0.9rem;">
                        🔄
                    </button>
                </div>

                <!-- ПЛАШКА ЖИВОГО ПРОГРЕССА СИНХРОНИЗАЦИИ (СКРЫТА ПО УМОЛЧАНИЮ) -->
                <div id="syncProgressBanner" style="display:none; margin-top:8px; background:rgba(99,102,241,0.15); border:1px solid rgba(99,102,241,0.3); border-radius:10px; padding:6px 10px; font-size:0.75rem; color:#818cf8; flex-direction:column; gap:4px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span id="syncProgressText">🔄 Синхронизация...</span>
                        <span id="syncProgressPercent" style="font-weight:bold;">0%</span>
                    </div>
                    <div style="background:rgba(255,255,255,0.1); height:3px; border-radius:3px; overflow:hidden;">
                        <div id="syncProgressBar" style="width:0%; height:100%; background:#818cf8; transition:width 0.3s ease;"></div>
                    </div>
                </div>

                <!-- Фильтры соцсетей -->
                <div class="network-filter-pills">
                    <button type="button" class="pill-btn active" data-net="ALL" onclick="filterNetwork('ALL', this)">Все</button>
                    <button type="button" class="pill-btn" data-net="INSTAGRAM" onclick="filterNetwork('INSTAGRAM', this)">📸 Instagram</button>
                    <button type="button" class="pill-btn" data-net="FACEBOOK" onclick="filterNetwork('FACEBOOK', this)">📘 Facebook</button>
                    <button type="button" class="pill-btn" data-net="BLUESKY" onclick="filterNetwork('BLUESKY', this)">🦋 BlueSky</button>
                    <button type="button" class="pill-btn" data-net="TELEGRAM" onclick="filterNetwork('TELEGRAM', this)">✈️ Telegram</button>
                    <button type="button" class="pill-btn" data-net="THREADS" onclick="filterNetwork('THREADS', this)">🧵 Threads</button>
                </div>
            </div>

            <!-- Список диалогов -->
            <div class="dialogs-list" id="dialogsContainer">
                <div id="dialogsLoading" style="text-align: center; padding: 2rem; color: var(--text-secondary);">
                    ⏳ Загрузка диалогов...
                </div>
            </div>
        </div>

        <!-- 2. ПРАВАЯ КОЛОНКА (ЧАТ) -->
        <div class="inbox-chat-area" id="chatArea">

            <!-- Заглушка, когда диалог не выбран -->
            <div class="empty-chat-state" id="emptyChatState">
                <div style="font-size: 3rem;">💬</div>
                <h3 style="margin: 0; color: var(--text-main);">Выберите диалог</h3>
                <p style="font-size: 0.85rem; max-width: 320px; margin: 0;">
                    Выберите переписку из списка слева, чтобы просмотреть историю и ответить клиенту.
                </p>
            </div>

            <!-- Активный диалог -->
            <div id="activeChatWrapper" class="active-chat-wrapper" style="display: none;">

                <!-- Компактная шапка чата без наложений -->
                <div class="chat-header">
                    <div class="chat-user-meta">
                        <button type="button" class="back-to-list-btn" onclick="closeMobileChat()">←</button>
                        <div class="avatar-wrapper" style="width: 36px; height: 36px;">
                            <div class="chat-avatar" id="activeAvatar">U</div>
                            <div class="network-badge-mini" id="activeNetBadge">📸</div>
                        </div>
                        <div class="user-text-details">
                            <div id="activeChatName" class="user-name-title">Имя Клиента</div>
                            <div id="activeChatHandle" class="user-handle-subtitle">@@username</div>
                        </div>
                    </div>

                    <!-- КОМПАКТНЫЙ ПРАВЫЙ ТУЛБАР ДЛЯ ТУМБЛЕРОВ -->
                    <div class="chat-header-controls">
                        <!-- 1. ТУМБЛЕР СИНХРОННОГО ПЕРЕВОДЧИКА -->
                        <div class="sync-translator-box" id="syncTranslatorBox" style="display: none;">
                            <div class="control-label-wrap">
                                <div class="sync-trans-status-label" id="syncTransLabel">🌐 Синхронный</div>
                                <div class="control-sublabel" id="syncTransSubLabel">RU ➔ EN</div>
                            </div>
                            <label class="switch mini-switch">
                                <input type="checkbox" id="syncTransToggle" onchange="toggleSyncTranslator(this.checked)">
                                <span class="slider slider-trans"></span>
                            </label>
                        </div>

                        <!-- 2. HUMAN TAKEOVER -->
                        <div class="human-takeover-box">
                            <div class="control-label-wrap">
                                <div class="takeover-status-label" id="takeoverLabel" style="color: #10b981;">🤖 ИИ</div>
                                <div class="control-sublabel" id="takeoverSubLabel">Бот отвечает сам</div>
                            </div>
                            <label class="switch mini-switch">
                                <input type="checkbox" id="takeoverToggle" onchange="onTakeoverToggleChanged(this.checked)">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Скроллящаяся лента сообщений -->
                <div class="messages-stream" id="messagesStream"></div>

                <!-- Намертво закрепленная панель ввода внизу -->
                <div class="chat-input-panel">
                    <div class="input-tools-row" style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.72rem; color: var(--text-secondary);" id="replyingAsNotice">
                            ✍️ Ответ клиенту
                        </span>

                        <!-- 🌐 УМНЫЙ ВИДЖЕТ ПЕРЕВОДА НА ЯЗЫК СОБЕСЕДНИКА -->
                        <div id="outgoingTranslateWidget" style="display: none; align-items: center; gap: 6px;">
                            <button type="button" id="btnTranslateOutgoing" onclick="translateOutgoingText()"
                                    style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.35); color: #818cf8; border-radius: 8px; padding: 2px 8px; font-size: 0.72rem; font-weight: 700; cursor: pointer; transition: all 0.2s ease;">
                                🌐 RU ➔ EN
                            </button>
                            <button type="button" id="btnRevertOutgoing" onclick="revertOutgoingText()" style="display: none; background: rgba(255, 255, 255, 0.08); border: 1px solid var(--glass-border); color: var(--text-secondary); border-radius: 8px; padding: 2px 6px; font-size: 0.72rem; cursor: pointer;" title="Вернуть русский текст">
                                ↩️ RU
                            </button>
                        </div>
                    </div>

                    <div class="input-row" id="normalInputRow">
                        <!-- СКРЕПКА -->
                        <button type="button" class="btn-attach" onclick="triggerFileInput()" title="Прикрепить файл">
                            📎
                        </button>
                        <input type="file" id="mediaFileInput" style="display: none;"
                               accept="image/*,video/*,audio/*" onchange="uploadAndSendMedia(this)">

                        <!-- МИКРОФОН ДЛЯ ЗАПИСИ ГОЛОСОВОГО -->
                        <button type="button" class="btn-mic" onclick="startVoiceRecording()" title="Записать голосовое сообщение">
                            🎙️
                        </button>

                        <textarea id="messageInput" class="chat-textarea" placeholder="Напишите сообщение..." onkeydown="handleInputKeydown(event)"></textarea>
                        <!-- Кнопка отправки с защитой от закрытия клавиатуры на телефоне -->
                        <button type="button" class="btn-send" id="btnSendManual" 
                                onpointerdown="preventSendBlur(event)" 
                                onclick="sendManualMessage()">➤</button>
                    </div>

                    <!-- ИНТЕРФЕЙС ИДЕТ ЗАПИСЬ (СКРЫТ ПО УМОЛЧАНИЮ) -->
                    <div class="voice-recording-ui" id="voiceRecordingUi">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="rec-pulse-dot"></span>
                            <span>Запись: <strong id="voiceRecTimer">0:00</strong></span>
                        </div>
                        <div class="voice-rec-actions">
                            <button type="button" class="btn-rec-action btn-rec-cancel" onclick="cancelVoiceRecording()" title="Отменить">❌</button>
                            <button type="button" class="btn-rec-action btn-rec-send" onclick="stopAndSendVoiceRecording()" title="Отправить голосовое">✅</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- МОДАЛКА: 24-ЧАСОВОЕ ОКНО META ЗАКРЫТО (ИСПРАВЛЕННАЯ) -->
<div id="metaWindowModalOverlay" class="meta-window-overlay" onclick="closeMetaWindowModal()">
    <div class="meta-window-modal" onclick="event.stopPropagation()">
        <div style="font-size: 3.5rem; margin-bottom: 0.5rem; line-height: 1;">⏳</div>
        <h3 style="margin: 0 0 10px 0; color: #d97706; font-size: 1.3rem; font-weight: 800;">
            24-часовое окно ответа закрыто
        </h3>

        <p style="color: var(--text-secondary, #64748b); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.25rem;">
            Политика безопасности Meta запрещает отправку сообщений через сторонние сервисы, если с момента последнего сообщения клиента прошло больше 24 часов.
        </p>

        <!-- КОНТРАСТНЫЙ ЧИТАЕМЫЙ БЛОК -->
        <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 14px; padding: 14px; text-align: left; font-size: 0.85rem; color: var(--text-main, #1e293b); line-height: 1.5; margin-bottom: 1.5rem;">
            <div style="color: #d97706; font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                <span>📱</span> Как отправить ответ прямо сейчас:
            </div>
            Откройте официальное приложение <strong>Instagram</strong> на телефоне и отправьте ответ оттуда напрямую. На мобильное приложение это ограничение не действует, а ваш ответ сразу отобразится здесь в чате!
        </div>

        <button type="button" class="btn-modal-action" onclick="closeMetaWindowModal()">
            Понятно
        </button>
    </div>
</div>

<!-- ЛАЙТБОКС ДЛЯ ПРОСМОТРА ФОТО -->
<div id="inboxLightbox" class="inbox-lightbox-overlay" onclick="closeInboxLightbox()">
    <img id="inboxLightboxImg" src="" class="inbox-lightbox-img" alt="Enlarged photo">
</div>

<!-- КОНТЕКСТНОЕ МЕНЮ СООБЩЕНИЯ (ПКМ / LONG PRESS) -->
<div id="msgContextMenu" class="msg-context-menu" onclick="event.stopPropagation()">
    <button type="button" class="msg-context-btn" onclick="executeDeleteMessage()">
        <span>🗑️</span> <span>Удалить сообщение</span>
    </button>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const profileId = @activeProfileId;
        let currentNetworkFilter = 'ALL';
        let currentConversationId = null;
        let allLoadedDialogs = [];

        // 1. SIGNALR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/inboxHub")
            .withAutomaticReconnect()
            .build();

        // 2. ОБНОВЛЕННЫЙ СЛУШАТЕЛЬ SIGNALR (БЕЗ СДВИГА АРГУМЕНТОВ)
        connection.on("ReceiveInboxMessage", async (payload) => {
            console.log("⚡ [SignalR] Новое сообщение:", payload);

            const localTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (currentConversationId && Number(currentConversationId) === Number(payload.conversationId)) {
                const stream = document.getElementById('messagesStream');

                // =========================================================================
                // ЗАЩИТА: ЕСЛИ ЭТО СООБЩЕНИЕ МЫ САМИ ТОЛЬКО ЧТО ОТПРАВИЛИ С ЭТОЙ ВКЛАДКИ
                // =========================================================================
                if (!payload.isIncoming && !payload.isSentByBot && stream) {
                    const pendingBubble = stream.querySelector(`.msg-outgoing-human[data-pending="true"]`);
                    if (pendingBubble && pendingBubble.dataset.text === payload.text) {
                        // Снимаем метку ожидания, привязываем ID и ВЫХОДИМ (дубль не создается!)
                        pendingBubble.removeAttribute('data-pending');
                        pendingBubble.dataset.msgId = payload.messageId;
                        updateDialogSnippet(payload.conversationId, payload.lastSnippet, localTime, payload.unreadCount);
                        return; // <-- ВТОРОЙ БАБЛ НЕ РИСУЕТСЯ!
                    }
                }

                if (payload.isIncoming && payload.text) {
                    // Если клиент прислал просто смайлик (нет букв) — НЕ сбрасываем язык, оставляем прежний!
                    if (/\p{L}/u.test(payload.text)) {
                        updateClientLanguage(payload.text);
                    }
                }

                // 🚀 ЕСЛИ ЭТО ВХОДЯЩЕЕ СООБЩЕНИЕ И ВКЛЮЧЕН СИНХРОННЫЙ ПЕРЕВОДЧИК:
                let textToDisplay = payload.text;
                let isAutoTranslated = false;

                if (payload.isIncoming && isSyncTranslateActive && payload.text) {
                    // Если в тексте иностранные буквы (нет кириллицы)
                    if (!/[а-яА-ЯёЁ]/.test(payload.text) && /\p{L}/u.test(payload.text)) {
                        const trans = await quickGoogleTranslate(payload.text, 'auto', 'ru');
                        if (trans) {
                            textToDisplay = trans; // Будем показывать русский перевод!
                            isAutoTranslated = true;
                        }
                    }
                }

                // Вставляем бабл (в rawText сохраняем оригинал на случай выключения тумблера)
                appendMessageBubble(
                    payload.messageId,
                    payload.text,
                    payload.isIncoming,
                    payload.isSentByBot,
                    localTime,
                    payload.reaction,
                    false,
                    payload.mediaUrl,
                    payload.mediaType
                );

                // Если сообщение перевелось на лету — подставляем русский текст и бейдж:
                if (isAutoTranslated && stream) {
                    const lastBubble = stream.lastElementChild;
                    if (lastBubble) {
                        const textNode = Array.from(lastBubble.children).find(c =>
                            c.tagName === 'DIV' &&
                            !c.classList.contains('msg-footer') &&
                            !c.classList.contains('msg-media-container') &&
                            !c.classList.contains('reaction-badge') &&
                            !c.classList.contains('translated-text-block')
                        );
                        if (textNode) {
                            textNode.innerHTML = escapeHtml(textToDisplay);
                            addOrUpdateTransBadge(lastBubble, activeClientLang || 'lang', payload.text);
                        }
                    }
                }

                scrollChatToBottom();
            }

            updateDialogSnippet(payload.conversationId, payload.lastSnippet, localTime, payload.unreadCount);
        });

        // СЛУШАТЕЛЬ ОБНОВЛЕНИЯ РЕАКЦИЙ В РЕАЛЬНОМ ВРЕМЕНИ
        connection.on("UpdateMessageReaction", (conversationId, messageId, reaction) => {
            console.log("⚡ [SignalR] Обновление реакции:", { conversationId, messageId, reaction });

            if (currentConversationId && Number(currentConversationId) === Number(conversationId)) {
                const bubble = document.querySelector(`.msg-bubble[data-msg-id="${messageId}"]`);
                if (bubble) {
                    let badge = bubble.querySelector('.reaction-badge');
                    if (reaction) {
                        if (!badge) {
                            badge = document.createElement('div');
                            badge.className = 'reaction-badge';
                            bubble.appendChild(badge);
                        }
                        badge.textContent = reaction;
                    } else {
                        if (badge) badge.remove(); // Сняли реакцию
                    }
                }
            }
        });

        // Слушатель прогресса синхронизации из SignalR:
        connection.on("SyncStatusProgress", (payload) => {
            const banner = document.getElementById('syncProgressBanner');
            const text = document.getElementById('syncProgressText');
            const percent = document.getElementById('syncProgressPercent');
            const bar = document.getElementById('syncProgressBar');

            if (banner) banner.style.display = 'flex';
            if (text) text.textContent = payload.text;
            if (percent) percent.textContent = payload.percent + '%';
            if (bar) bar.style.width = payload.percent + '%';
        });


        // ЖИВОЙ ПРОГРЕСС СЖАТИЯ ВИДЕО С СЕРВЕРА
        connection.on("ServerProcessingProgress", (payload) => {
            console.log("⚙️ [Server Progress]:", payload);

            if (currentConversationId && Number(currentConversationId) === Number(payload.conversationId)) {
                const fill = document.getElementById('uploadFill');
                const statusText = document.getElementById('uploadStatusText');
                const bytesText = document.getElementById('uploadBytesText');

                if (fill) {
                    // Переключаем полоску в фиолетовый градиент обработки сервера
                    fill.classList.remove('processing');
                    fill.style.width = payload.percent + '%';
                    fill.style.background = 'linear-gradient(90deg, #6366f1, #a855f7)';
                }

                if (statusText) {
                    statusText.textContent = payload.text;
                }

                if (bytesText) {
                    bytesText.textContent = payload.percent + '%';
                }
            }
        });

        connection.on("TakeoverStatusChanged", (conversationId, isTakeover) => {
            if (currentConversationId === conversationId) {
                updateTakeoverUi(isTakeover);
            }
        });

        connection.start().then(() => {
            console.log("✅ SignalR подключен к InboxHub!");
            if (profileId > 0) {
                connection.invoke("JoinProfileRoom", profileId);
            }
        }).catch(err => console.error("Ошибка подключения SignalR:", err));

        // Поддержка прокрутки фильтров колесиком мыши на компьютере:
        const pillsBar = document.querySelector('.network-filter-pills');
        if (pillsBar) {
            pillsBar.addEventListener('wheel', (e) => {
                if (e.deltaY !== 0) {
                    e.preventDefault();
                    pillsBar.scrollLeft += e.deltaY;
                }
            }, { passive: false });
        }

        // 2. ЗАГРУЗКА ДИАЛОГОВ
        async function loadDialogs() {
            const container = document.getElementById('dialogsContainer');
            container.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">⏳ Загрузка диалогов...</div>';

            try {
                const res = await fetch(`/inbox/dialogs?profileId=${profileId}&network=${currentNetworkFilter}`);
                if (!res.ok) throw new Error("Ошибка запроса");

                allLoadedDialogs = await res.json();
                renderDialogsList(allLoadedDialogs);
            } catch (err) {
                container.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;">❌ Ошибка загрузки диалогов</div>';
            }
        }

        function renderDialogsList(dialogs) {
            const container = document.getElementById('dialogsContainer');
            container.innerHTML = '';

            if (!dialogs || dialogs.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📭</div>
                        <div style="font-weight: 700; color: var(--text-main);">Диалогов пока нет</div>
                        <div style="font-size: 0.75rem; margin-top: 6px; margin-bottom: 15px;">Нажмите кнопку ниже, чтобы синхронизировать диалоги.</div>
                        <button type="button" class="pill-btn" onclick="syncInbox()" style="margin: 0 auto; background: var(--accent-color); color: #fff; padding: 8px 16px;">
                            🔄 Синхронизировать диалоги
                        </button>
                    </div>
                `;
                return;
            }

            dialogs.forEach(d => {
                const item = document.createElement('div');
                item.className = `dialog-item ${currentConversationId === d.id ? 'active' : ''}`;
                item.dataset.id = d.id;
                item.onclick = () => selectDialog(d.id);

                const badge = getNetworkBadge(d.networkType);
                const avatarContent = d.avatar
                    ? `<img src="${d.avatar}" class="chat-avatar" alt="Avatar" referrerpolicy="no-referrer" onerror="this.onerror=null; this.outerHTML='<div class=\\'chat-avatar\\' style=\\'background:${badge.color};\\'>${getInitials(d.name)}</div>';">`
                    : `<div class="chat-avatar" style="background:${badge.color};">${getInitials(d.name)}</div>`;

                item.innerHTML = `
                    <div class="avatar-wrapper">
                        ${avatarContent}
                        <div class="network-badge-mini" style="background:${badge.color};">${badge.icon}</div>
                    </div>
                    <div class="dialog-info">
                        <div class="dialog-top-row">
                            <span class="dialog-title">${escapeHtml(d.name)}</span>
                            <span class="dialog-time" id="time_${d.id}">${d.time}</span>
                        </div>
                        <div class="dialog-bottom-row">
                            <span class="dialog-snippet" id="snippet_${d.id}">${escapeHtml(d.snippet || "Вложение")}</span>
                            ${d.unreadCount > 0 ? `<span class="unread-count-badge" id="unread_${d.id}">${d.unreadCount}</span>` : ''}
                        </div>
                    </div>
                `;

                container.appendChild(item);
            });
        }

        // 3. ОТКРЫТИЕ ДИАЛОГА
        async function selectDialog(conversationId) {

            // 🚀 МГНОВЕННЫЙ ПОКАЗ ТУМБЛЕРА ИЗ ПАМЯТИ (0 мс задержки!):
            if (convoLangCache.has(conversationId)) {
                const cachedLang = convoLangCache.get(conversationId);
                activeClientLang = cachedLang;

                const transBox = document.getElementById('syncTranslatorBox');
                const subLabel = document.getElementById('syncTransSubLabel');
                const btn = document.getElementById('btnTranslateOutgoing');
                const widget = document.getElementById('outgoingTranslateWidget');

                if (transBox) transBox.style.display = 'flex';
                if (subLabel) subLabel.textContent = `RU ➔ ${cachedLang.toUpperCase()}`;
                if (btn) btn.textContent = `🌐 RU ➔ ${cachedLang.toUpperCase()}`;
                if (widget) widget.style.display = 'inline-flex';
            }

            currentConversationId = conversationId;

            document.querySelectorAll('.dialog-item').forEach(el => el.classList.remove('active'));
            const activeEl = document.querySelector(`.dialog-item[data-id="${conversationId}"]`);
            if (activeEl) {
                activeEl.classList.add('active');
                const unread = document.getElementById(`unread_${conversationId}`);
                if (unread) unread.remove();
            }

            document.getElementById('emptyChatState').style.display = 'none';
            const chatWrapper = document.getElementById('activeChatWrapper');
            chatWrapper.style.display = 'flex';

            const stream = document.getElementById('messagesStream');
            stream.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">⏳ Загрузка сообщений...</div>';

            try {
                const res = await fetch(`/inbox/messages/${conversationId}`);
                if (!res.ok) throw new Error("Не удалось загрузить сообщения");

                const data = await res.json();

                const badge = getNetworkBadge(data.networkType);
                document.getElementById('activeChatName').textContent = data.name;
                document.getElementById('activeChatHandle').textContent = `${badge.name} • ${data.username ? '@@' + data.username : ''}`;
                document.getElementById('activeNetBadge').textContent = badge.icon;
                document.getElementById('activeNetBadge').style.background = badge.color;

                const avatarElem = document.getElementById('activeAvatar');
                if (data.avatar) {
                    avatarElem.outerHTML = `<img src="${data.avatar}" id="activeAvatar" class="chat-avatar" alt="Avatar" referrerpolicy="no-referrer" onerror="this.onerror=null; this.outerHTML='<div class=\\'chat-avatar\\' id=\\'activeAvatar\\' style=\\'background:${badge.color};\\'>${getInitials(data.name)}</div>';">`;
                } else {
                    avatarElem.outerHTML = `<div class="chat-avatar" id="activeAvatar" style="background:${badge.color};">${getInitials(data.name)}</div>`;
                }

                document.getElementById('replyingAsNotice').innerHTML = `✍️ Вы отвечаете в <strong>${badge.name}</strong>`;

                updateTakeoverUi(data.isTakeover);

                stream.innerHTML = '';
                if (data.messages && data.messages.length > 0) {
                    data.messages.forEach(m => {
                        appendMessageBubble(
                            m.id,
                            m.text,
                            m.isIncoming,
                            m.isSentByBot,
                            m.time,
                            m.reaction,
                            false,
                            m.mediaUrl,
                            m.mediaType
                        );
                    });

                    // 1. Ищем язык по истории назад сквозь смайлики:
                    const meaningfulText = findClientMessageWithLetters(data.messages);
                    if (meaningfulText) {
                        await updateClientLanguage(meaningfulText);
                    } else {
                        await updateClientLanguage(null);
                    }

                    // 2. 🚀 ЕСЛИ ТУМБЛЕР ВКЛЮЧЕН — АВТОМАТИЧЕСКИ ПЕРЕВОДИМ ВСЮ ПЕРЕПИСКУ НА РУССКИЙ ПРИ ВХОДЕ!
                    const toggle = document.getElementById('syncTransToggle');
                    if (isSyncTranslateActive || (toggle && toggle.checked)) {
                        isSyncTranslateActive = true;
                        if (toggle) toggle.checked = true;
                        const box = document.getElementById('syncTranslatorBox');
                        if (box) box.classList.add('active');

                        // Переводим все сообщения диалога на русский сразу (из кэша за 0 мс!):
                        await applySyncTranslationToAllBubbles(true);
                    }
                } 
                else {
                    stream.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-secondary);">История сообщений пуста</div>';
                }

                // Прокрутка вниз
                scrollChatToBottom();

                // Мобильный режим: открываем чат на весь экран и фиксируем состояние в истории
                const card = document.getElementById('inboxCard');
                if (card) {
                    card.classList.add('mobile-chat-open');
                    if (window.innerWidth <= 768) {
                        history.pushState({ mobileChatOpen: true }, "");
                    }
                }

            } catch (err) {
                stream.innerHTML = '<div style="text-align:center; padding:2rem; color:#ef4444;">❌ Ошибка загрузки переписки</div>';
            }
        }

        // 4. РУЧНАЯ ОТПРАВКА С ЗАЩИТОЙ ОТ ДУБЛЕЙ
        // Запрещаем кнопке отправки отбирать фокус у поля ввода (клавиатура не дергается!)
        function preventSendBlur(e) {
            e.preventDefault();
        }

        async function sendManualMessage() {
            if (!currentConversationId) return;

            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if (!text) return;

            input.value = '';
            // Удерживаем клавиатуру на телефоне открытой:
            input.focus();

            // Текст для отображения у нас (русский) и для отправки клиенту (иностранный)
            let textToDisplay = text;
            let textToSend = text;

            // 🚀 1. ПЕРЕВОДИМ ДО ОТПРАВКИ, ЧТОБЫ БАБЛ СРАЗУ ПОЛУЧИЛ ПРАВИЛЬНЫЙ ВИД:
            if (isSyncTranslateActive && activeClientLang && activeClientLang !== 'ru') {
                const translated = await quickGoogleTranslate(text, 'ru', activeClientLang);
                if (translated) {
                    textToSend = translated; // Клиенту пойдет иностранный текст
                    translationCache.set(`auto_ru_${translated}`, textToDisplay);
                }
            }

            // 🚀 2. СОЗДАЕМ БАБЛ (Записываем textToSend в dataset.text для защиты от дублей в SignalR!):
            const stream = document.getElementById('messagesStream');
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const tempBubble = document.createElement('div');
            tempBubble.className = 'msg-bubble msg-outgoing-human';
            tempBubble.setAttribute('data-pending', 'true');
            // ВАЖНО: textToSend совпадет с тем, что вернет SignalR:
            tempBubble.dataset.text = textToSend;
            tempBubble.dataset.rawText = textToSend;

            if (isSyncTranslateActive && activeClientLang && activeClientLang !== 'ru') {
                tempBubble.innerHTML = `<div>${escapeHtml(textToDisplay)}</div><div class="msg-footer"><span class="msg-trans-badge">🌐 ${activeClientLang.toUpperCase()}</span><span class="sender-tag" style="color:#ffffff;">👤 Вы</span><span>${timeStr}</span></div>`;
            } else {
                tempBubble.innerHTML = `<div>${escapeHtml(textToDisplay)}</div><div class="msg-footer"><span class="sender-tag" style="color:#ffffff;">👤 Вы</span><span>${timeStr}</span></div>`;
            }

            stream.appendChild(tempBubble);
            scrollChatToBottom();
            updateTakeoverUi(true);

            try {
                const res = await fetch('/inbox/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversationId: currentConversationId, text: textToSend })
                });

                if (!res.ok) {
                    const err = await res.text();
                    tempBubble.remove();
                    input.value = text;

                    if (err.includes("OUTSIDE_24H_WINDOW") || err.includes("outside of allowed window") || err.includes("2534022") || err.includes("2018278")) {
                        openMetaWindowModal();
                    } else {
                        alert("Ошибка отправки: " + err);
                    }
                } else {
                    originalRussianDraft = '';
                    document.getElementById('btnRevertOutgoing')?.style.setProperty('display', 'none');
                }
            } catch (err) {
                tempBubble.remove();
                input.value = text;
                alert("Ошибка сети при отправке сообщения");
            }
        }

        function openMetaWindowModal() {
            const overlay = document.getElementById('metaWindowModalOverlay');
            if (overlay) {
                overlay.style.display = 'flex';
            }
        }

        function closeMetaWindowModal() {
            const overlay = document.getElementById('metaWindowModalOverlay');
            if (overlay) {
                overlay.style.display = 'none';
            }
        }

        // 5. HUMAN TAKEOVER
        async function onTakeoverToggleChanged(isChecked) {
            if (!currentConversationId) return;
            updateTakeoverUi(isChecked);

            try {
                await fetch('/inbox/takeover', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversationId: currentConversationId, isTakeover: isChecked })
                });
            } catch (err) {
                console.error("Ошибка смены статуса takeover:", err);
            }
        }

        function updateTakeoverUi(isTakeover) {
            const toggle = document.getElementById('takeoverToggle');
            const label = document.getElementById('takeoverLabel');
            const subLabel = document.getElementById('takeoverSubLabel');

            if (toggle) toggle.checked = isTakeover;

            if (isTakeover) {
                label.textContent = "👤 Ручной";
                label.style.color = "#f43f5e";
                if (subLabel) subLabel.textContent = "ИИ отключен";
            } else {
                label.textContent = "🤖 ИИ";
                label.style.color = "#10b981";
                if (subLabel) subLabel.textContent = "Бот отвечает сам";
            }
        }

        let targetContextMessageId = null;
        let longPressTimer = null;

        // СЛУШАТЕЛЬ УДАЛЕНИЯ СООБЩЕНИЯ (ИЗ ИНСТАГРАМ ИЛИ С САЙТА)
        connection.on("MessageDeleted", (conversationId, messageId, lastSnippet) => {
            console.log("🗑️ [SignalR] Сообщение удалено:", { conversationId, messageId });

            if (currentConversationId && Number(currentConversationId) === Number(conversationId)) {
                const bubble = document.querySelector(`.msg-bubble[data-msg-id="${messageId}"]`);
                if (bubble) {
                    // Анимация плавного исчезновения
                    bubble.classList.add('deleting');
                    setTimeout(() => bubble.remove(), 350);
                }
            }

            // Обновляем превью слева
            const snipElem = document.getElementById(`snippet_${conversationId}`);
            if (snipElem && lastSnippet !== undefined) {
                snipElem.textContent = lastSnippet;
            }
        });

        // ОБНОВЛЕННЫЙ РЕНДЕР БАБЛА С ПКМ, ДОЛГИМ НАЖАТИЕМ И ПЕРЕВОДОМ
        function appendMessageBubble(messageId, text, isIncoming, isSentByBot, time, reaction = null, isPending = false, mediaUrl = null, mediaType = null) {
            const stream = document.getElementById('messagesStream');
            const bubble = document.createElement('div');

            if (isPending) {
                bubble.setAttribute('data-pending', 'true');
                bubble.dataset.text = text;
            }

            if (messageId) {
                bubble.dataset.msgId = messageId;

                // 1. ПКМ ДЛЯ КОМПЬЮТЕРА:
                bubble.oncontextmenu = (e) => {
                    e.preventDefault();
                    showMsgContextMenu(e.clientX, e.clientY, messageId);
                };

                // 2. LONG PRESS ДЛЯ СМАРТФОНА (500 мс):
                bubble.addEventListener('touchstart', (e) => {
                    longPressTimer = setTimeout(() => {
                        const touch = e.touches[0];
                        showMsgContextMenu(touch.clientX, touch.clientY, messageId);
                    }, 500);
                }, { passive: true });

                bubble.addEventListener('touchend', () => clearTimeout(longPressTimer), { passive: true });
                bubble.addEventListener('touchmove', () => clearTimeout(longPressTimer), { passive: true });
            }

            // Сохраняем исходный текст в data-атрибут (безопасно для кавычек и переносов строк!)
            if (text) {
                bubble.dataset.rawText = text;
            }

            let mediaHtml = '';
            if (mediaUrl || mediaType) {
                const cleanType = (mediaType || '').toLowerCase();
                const srcUrl = messageId ? `/inbox/media/${messageId}` : mediaUrl;

                if (cleanType.includes('image') || cleanType === 'photo') {
                    mediaHtml = `
                        <div class="msg-media-container">
                            <img src="${srcUrl}" class="msg-media-img" alt="Photo"
                                 onclick="openInboxLightbox('${srcUrl}')"
                                 onerror="handleMediaExpired(this, '📷 Фотография')">
                        </div>
                    `;
                } else if (cleanType.includes('video')) {
                    mediaHtml = `
                        <div class="msg-media-container">
                            <video src="${srcUrl}" class="msg-media-video" controls preload="metadata" playsinline
                                   onerror="handleMediaExpired(this, '🎬 Видеозапись')"></video>
                        </div>
                    `;
                } else if (cleanType.includes('audio') || cleanType === 'voice') {
                    const playerId = 'vp_' + Math.random().toString(36).substring(2, 9);
                    mediaHtml = `
                        <div class="voice-player-card" id="${playerId}">
                            <button type="button" class="voice-play-btn" onclick="toggleVoicePlay('${playerId}')">▶</button>
                            <div class="voice-track-box" onclick="seekVoice(event, '${playerId}')">
                                <div class="voice-bars-wrap">${generateWaveformBars()}</div>
                                <div class="voice-time-row">
                                    <span class="voice-current-time">0:00</span>
                                    <span class="voice-total-time">🎙️ Голосовое</span>
                                </div>
                            </div>
                            <audio src="${srcUrl}" preload="metadata" style="display:none;"
                                   onloadedmetadata="initVoiceDuration('${playerId}', this)"
                                   ontimeupdate="updateVoiceProgress('${playerId}', this)"
                                   onended="resetVoicePlayer('${playerId}', this)"
                                   onerror="handleMediaExpired(this, '🎙️ Голосовое сообщение')"></audio>
                        </div>
                    `;
                }
            }

            let reactionHtml = reaction ? `<div class="reaction-badge">${escapeHtml(reaction)}</div>` : '';
            const hasRealText = text && !text.startsWith('📷') && !text.startsWith('🎬') && !text.startsWith('🎙️') && text !== '[Медиа]' && text !== '[image]';
            let textHtml = hasRealText ? `<div>${escapeHtml(text)}</div>` : (!mediaHtml ? `<div>${escapeHtml(text)}</div>` : '');

            // 🚀 Показываем кнопку для ВСЕХ входящих И для наших исходящих на иностранном языке:
            const isForeignOutgoing = !isIncoming && hasRealText && !/[а-яА-ЯёЁ]/.test(text) && /\p{L}/u.test(text);
            const canTranslate = hasRealText && (isIncoming || isForeignOutgoing);

            let translateBtnHtml = canTranslate
                ? `<div style="margin-top: 4px;"><button type="button" class="btn-translate" onclick="translateBubble(this)">🌐 Перевести</button></div>`
                : '';

            if (isIncoming) {
                bubble.className = 'msg-bubble msg-incoming';
                // ВСТАВЛЯЕМ ${translateBtnHtml} ПЕРЕД РЕАКЦИЯМИ И ФУТЕРОМ:
                bubble.innerHTML = `${mediaHtml}${textHtml}${translateBtnHtml}${reactionHtml}<div class="msg-footer"><span>${time}</span></div>`;
                bubble.ondblclick = () => handleMessageDoubleClick(bubble, messageId);

            } else if (isSentByBot) {
                bubble.className = 'msg-bubble msg-outgoing-bot';
                // Добавили ${translateBtnHtml}:
                bubble.innerHTML = `${mediaHtml}${textHtml}${translateBtnHtml}${reactionHtml}<div class="msg-footer"><span class="sender-tag" style="color:#c084fc;">🤖 Бот ИИ</span><span>${time}</span></div>`;
            } else {
                bubble.className = 'msg-bubble msg-outgoing-human';
                // Добавили ${translateBtnHtml}:
                bubble.innerHTML = `${mediaHtml}${textHtml}${translateBtnHtml}${reactionHtml}<div class="msg-footer"><span class="sender-tag" style="color:#ffffff;">👤 Вы</span><span>${time}</span></div>`;
            }

            stream.appendChild(bubble);
        }

        // УПРАВЛЕНИЕ КОНТЕКСТНЫМ МЕНЮ
        function showMsgContextMenu(x, y, messageId) {
            targetContextMessageId = messageId;
            const menu = document.getElementById('msgContextMenu');
            if (!menu) return;

            // Защита от вылета за правый край экрана
            const menuWidth = 170;
            const posX = (x + menuWidth > window.innerWidth) ? (window.innerWidth - menuWidth - 10) : x;

            menu.style.left = posX + 'px';
            menu.style.top = y + 'px';
            menu.style.display = 'block';
        }

        function hideMsgContextMenu() {
            const menu = document.getElementById('msgContextMenu');
            if (menu) menu.style.display = 'none';
            targetContextMessageId = null;
        }

        // Закрываем меню при клике в любое место экрана
        document.addEventListener('click', hideMsgContextMenu);
        document.addEventListener('scroll', hideMsgContextMenu, true);

        // ВЫПОЛНЕНИЕ УДАЛЕНИЯ СООБЩЕНИЯ
        async function executeDeleteMessage() {
            if (!targetContextMessageId) return;
            const msgId = targetContextMessageId;
            hideMsgContextMenu();

            if (!confirm("Удалить это сообщение из Инбокса?")) return;

            // Оптимистичная анимация растворения
            const bubble = document.querySelector(`.msg-bubble[data-msg-id="${msgId}"]`);
            if (bubble) bubble.classList.add('deleting');

            try {
                const res = await fetch('/inbox/delete-message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: msgId })
                });

                if (res.ok) {
                    setTimeout(() => { if (bubble) bubble.remove(); }, 350);
                } else {
                    if (bubble) bubble.classList.remove('deleting');
                    alert("Не удалось удалить сообщение");
                }
            } catch {
                if (bubble) bubble.classList.remove('deleting');
                alert("Ошибка сети при удалении");
            }
        }

        // Фоллбек при сгорании ссылки в Meta CDN через 1-2 недели
        function handleMediaExpired(element, label) {
            const parent = element.closest('.msg-media-container');
            if (parent) {
                parent.innerHTML = `<div class="msg-media-expired"><span>⚠️</span> <span>${label} (срок ссылки в Instagram истёк)</span></div>`;
            }
        }

        // Открытие фото в лайтбоксе
        function openInboxLightbox(url) {
            const box = document.getElementById('inboxLightbox');
            const img = document.getElementById('inboxLightboxImg');
            if (box && img) {
                img.src = url;
                box.style.display = 'flex';
            }
        }

        function closeInboxLightbox() {
            const box = document.getElementById('inboxLightbox');
            if (box) box.style.display = 'none';
        }

        function updateDialogSnippet(convId, snippet, time, unreadCount) {
            const snipElem = document.getElementById(`snippet_${convId}`);
            const timeElem = document.getElementById(`time_${convId}`);
            if (snipElem) snipElem.textContent = snippet;
            if (timeElem) timeElem.textContent = time;

            const item = document.querySelector(`.dialog-item[data-id="${convId}"]`);
            const container = document.getElementById('dialogsContainer');
            if (item && container) {
                container.prepend(item);
            }
        }

        function getNetworkBadge(networkType) {
            switch (networkType) {
                case 1: return { name: "Instagram Direct", icon: "📸", color: "#e1306c" };
                case 2: return { name: "Facebook", icon: "📘", color: "#1877F2" }; // <-- Переименовали в Facebook
                case 3: return { name: "BlueSky", icon: "🦋", color: "#0085ff" };
                case 4:
                case 5:
                case 6: return { name: "Telegram", icon: "✈️", color: "#2AABEE" };
                case 7: return { name: "X (Twitter)", icon: "✖️", color: "#000000" };
                case 8: return { name: "Threads", icon: "🧵", color: "#000000" };
                default: return { name: "Соцсеть", icon: "💬", color: "#6366f1" };
            }
        }

        function getInitials(name) {
            if (!name) return "U";
            const parts = name.trim().split(' ');
            return parts.length > 1 ? (parts[0][0] + parts[1][0]) : name.substring(0, 2);
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        function scrollChatToBottom() {
            const stream = document.getElementById('messagesStream');
            if (stream) {
                setTimeout(() => {
                    stream.scrollTop = stream.scrollHeight;
                }, 80);
            }
        }

        function handleInputKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendManualMessage();
            }
        }

        function closeMobileChat(shouldHistoryBack = true) {
            // 1. Сначала прячем клавиатуру, если она открыта
            document.getElementById('messageInput')?.blur();

            // 2. Закрываем окно чата
            const card = document.getElementById('inboxCard');
            if (card) card.classList.remove('mobile-chat-open');

            // 3. Синхронизируем историю браузера (для системной кнопки Назад)
            if (shouldHistoryBack && history.state && history.state.mobileChatOpen) {
                history.back();
            }
        }

        // Перехват системной кнопки "Назад" на Android и свайпа назад на iPhone
        window.addEventListener('popstate', (e) => {
            const card = document.getElementById('inboxCard');
            if (card && card.classList.contains('mobile-chat-open')) {
                // Если клавиатура открыта — сначала закрываем её
                const input = document.getElementById('messageInput');
                if (document.activeElement === input) {
                    input.blur();
                    // Возвращаем состояние, чтобы остаться в чате:
                    history.pushState({ mobileChatOpen: true }, "");
                    return;
                }
                // Если клавиатура уже закрыта — выходим к списку диалогов
                closeMobileChat(false);
            }
        });

        function filterNetwork(net, btn) {
            currentNetworkFilter = net;
            document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            loadDialogs();
        }

        function onSearchInput(query) {
            query = query.toLowerCase().trim();
            document.querySelectorAll('.dialog-item').forEach(item => {
                const title = item.querySelector('.dialog-title')?.textContent.toLowerCase() || '';
                const snippet = item.querySelector('.dialog-snippet')?.textContent.toLowerCase() || '';
                item.style.display = (title.includes(query) || snippet.includes(query)) ? 'flex' : 'none';
            });
        }

        // Обновленная функция синхронизации с защитой от спама (Cooldown 15 сек):
        let isSyncing = false;
        async function syncInbox() {
            if (isSyncing) return;
            isSyncing = true;

            const syncBtn = document.getElementById('syncBtn');
            const banner = document.getElementById('syncProgressBanner');
            const text = document.getElementById('syncProgressText');
            const bar = document.getElementById('syncProgressBar');

            if (syncBtn) syncBtn.disabled = true;
            if (banner) {
                banner.style.display = 'flex';
                bar.style.width = '5%';
                text.textContent = '🔄 Подключение к соцсетям...';
            }

            try {
                const res = await fetch(`/inbox/sync?profileId=${profileId}`, { method: 'POST' });
                const data = await res.json();

                if (res.ok) {
                    if (text) text.textContent = `✅ Готово! Синхронизировано: ${data.count || 0}`;
                    if (bar) bar.style.width = '100%';
                    await loadDialogs();
                } else {
                    if (text) text.textContent = '❌ Ошибка синхронизации';
                }
            } catch {
                if (text) text.textContent = '❌ Сбой сети';
            } finally {
                // Плавное скрытие плашки через 3 секунды
                setTimeout(() => {
                    if (banner) banner.style.display = 'none';
                }, 3000);

                // Обратный отсчет кулдауна на кнопке (15 секунд):
                let countdown = 15;
                const timer = setInterval(() => {
                    if (syncBtn) syncBtn.textContent = `⏳ ${countdown}s`;
                    countdown--;
                    if (countdown < 0) {
                        clearInterval(timer);
                        if (syncBtn) {
                            syncBtn.textContent = '🔄';
                            syncBtn.disabled = false;
                        }
                        isSyncing = false;
                    }
                }, 1000);
            }
        }

        // Автоматический перезаход в комнату профиля при переподключении сети/сервера:
        connection.onreconnected(async (newConnectionId) => {
            console.log("🔄 [SignalR] Связь восстановлена! Повторный вход в комнату профиля...", newConnectionId);
            if (profileId > 0) {
                try {
                    await connection.invoke("JoinProfileRoom", profileId);
                    console.log("✅ [SignalR] Успешно вернулись в комнату профиля!");
                    // Освежаем список диалогов на случай, если что-то пропустили во время обрыва
                    await loadDialogs();
                } catch (e) {
                    console.error("Ошибка повторного входа в комнату:", e);
                }
            }
        });

        // ОБРАБОТКА ДВОЙНОГО КЛИКА (ПОСТАВИТЬ / СНЯТЬ ЛАЙК)
        async function handleMessageDoubleClick(bubbleElement, messageId) {
            if (!messageId) return;

            let badge = bubbleElement.querySelector('.reaction-badge');
            const isCurrentlyLiked = !!badge;

            // ОПТИМИСТИЧНЫЙ UI:
            if (isCurrentlyLiked) {
                // Если лайк уже стоял — сразу убираем бейдж
                badge.remove();
            } else {
                // Если лайка не было — запускаем красивую анимацию всплывающего сердца
                const heart = document.createElement('div');
                heart.className = 'heart-pop';
                heart.textContent = '❤️';
                bubbleElement.appendChild(heart);
                setTimeout(() => heart.remove(), 700);

                // Прикрепляем бейдж
                badge = document.createElement('div');
                badge.className = 'reaction-badge';
                badge.textContent = '❤️';
                bubbleElement.appendChild(badge);
            }

            try {
                const res = await fetch('/inbox/toggle-reaction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageId: messageId })
                });

                if (!res.ok) {
                    console.warn("Не удалось синхронизировать реакцию с Meta API");
                }
            } catch (err) {
                console.error("Ошибка сети при переключении реакции:", err);
            }
        }

        // 1. Генерация 24 полосок разной высоты для звуковой волны
        function generateWaveformBars() {
            const heights = [4, 8, 14, 18, 12, 6, 16, 20, 10, 6, 12, 18, 8, 14, 10, 16, 8, 4, 12, 6, 10, 14, 8, 4];
            return heights.map(h => `<span class="voice-bar" style="height:${h}px;"></span>`).join('');
        }

        // 2. Старт / Пауза воспроизведения
        function toggleVoicePlay(playerId) {
            const card = document.getElementById(playerId);
            if (!card) return;

            const audio = card.querySelector('audio');
            const btn = card.querySelector('.voice-play-btn');

            // Если этот плеер уже играет — ставим на паузу
            if (!audio.paused) {
                audio.pause();
                btn.textContent = '▶';
                btn.classList.remove('playing');
                return;
            }

            // Останавливаем все другие играющие голосовые (чтобы не играли хором!)
            document.querySelectorAll('.voice-player-card').forEach(c => {
                if (c.id !== playerId) {
                    const otherAudio = c.querySelector('audio');
                    const otherBtn = c.querySelector('.voice-play-btn');
                    if (otherAudio && !otherAudio.paused) {
                        otherAudio.pause();
                        otherBtn.textContent = '▶';
                        otherBtn.classList.remove('playing');
                    }
                }
            });

            audio.play();
            btn.textContent = '⏸';
            btn.classList.add('playing');
        }

        // 3. Обновление прогресса и подсветка полосок волны
        function updateVoiceProgress(playerId, audio) {
            const card = document.getElementById(playerId);
            if (!card || !audio.duration) return;

            const currentSpan = card.querySelector('.voice-current-time');
            currentSpan.textContent = formatAudioSeconds(audio.currentTime);

            // Подсвечиваем полоски
            const bars = card.querySelectorAll('.voice-bar');
            const progressPercent = audio.currentTime / audio.duration;
            const activeBarsCount = Math.floor(progressPercent * bars.length);

            bars.forEach((bar, index) => {
                if (index <= activeBarsCount) {
                    bar.classList.add('active');
                } else {
                    bar.classList.remove('active');
                }
            });
        }

        // 4. Инициализация длительности аудиозаписи
        function initVoiceDuration(playerId, audio) {
            const card = document.getElementById(playerId);
            if (!card) return;
            if (audio.duration && isFinite(audio.duration)) {
                card.querySelector('.voice-total-time').textContent = formatAudioSeconds(audio.duration);
            }
        }

        // 5. Окончание прослушивания
        function resetVoicePlayer(playerId, audio) {
            const card = document.getElementById(playerId);
            if (!card) return;

            const btn = card.querySelector('.voice-play-btn');
            btn.textContent = '▶';
            btn.classList.remove('playing');

            card.querySelectorAll('.voice-bar').forEach(b => b.classList.remove('active'));
            card.querySelector('.voice-current-time').textContent = '0:00';
        }

        // 6. Перемотка кликом по дорожке
        function seekVoice(event, playerId) {
            const card = document.getElementById(playerId);
            if (!card) return;

            const audio = card.querySelector('audio');
            if (!audio.duration) return;

            const trackBox = card.querySelector('.voice-bars-wrap');
            const rect = trackBox.getBoundingClientRect();
            const clickX = event.clientX - rect.left;
            const percent = Math.max(0, Math.min(1, clickX / rect.width));

            audio.currentTime = percent * audio.duration;
            updateVoiceProgress(playerId, audio);
        }

        function formatAudioSeconds(sec) {
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60);
            return `${m}:${s < 10 ? '0' : ''}${s}`;
        }

        // ОТКРЫТИЕ ПРОВОДНИКА ПРИ КЛИКЕ НА СКРЕПКУ
        function triggerFileInput() {
            if (!currentConversationId) {
                alert("Сначала выберите диалог!");
                return;
            }
            document.getElementById('mediaFileInput').click();
        }

        // Глобальная переменная для отмены текущей загрузки
        let currentMediaUploadXhr = null;

        // ОТПРАВКА МЕДИА С РЕАЛЬНЫМ ПРОГРЕСС-БАРОМ И ОТМЕНОЙ
        async function uploadAndSendMedia(input) {
            if (!input.files || input.files.length === 0 || !currentConversationId) return;

            const file = input.files[0];
            const targetConversationId = currentConversationId;

            // Сбрасываем инпут выбора файла
            input.value = '';

            // Валидация размера: предупреждаем, если видео больше 100 МБ
            if (file.size > 100 * 1024 * 1024) {
                alert("Файл слишком большой (> 100 МБ). Пожалуйста, выберите файл меньшего размера.");
                return;
            }

            const formData = new FormData();
            formData.append('conversationId', targetConversationId);
            formData.append('file', file);

            const stream = document.getElementById('messagesStream');
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // 1. Создаем бабл с красивым прогресс-баром
            const uploadBubble = document.createElement('div');
            uploadBubble.className = 'msg-bubble msg-outgoing-human';
            uploadBubble.id = 'activeUploadBubble';

            const fileSizeFormatted = formatBytesSimple(file.size);

            uploadBubble.innerHTML = `
                <div class="upload-progress-card">
                    <div class="upload-header-row">
                        <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:200px;">
                            📎 ${escapeHtml(file.name)}
                        </span>
                        <button type="button" class="upload-cancel-btn" onclick="abortMediaUpload()" title="Отменить отправку">✕</button>
                    </div>
                    <div class="upload-bar-bg">
                        <div class="upload-bar-fill" id="uploadFill"></div>
                    </div>
                    <div class="upload-footer-row">
                        <span id="uploadStatusText">Загрузка: 0%</span>
                        <span id="uploadBytesText">0 / ${fileSizeFormatted}</span>
                    </div>
                </div>
                <div class="msg-footer"><span>${timeStr}</span></div>
            `;

            stream.appendChild(uploadBubble);
            scrollChatToBottom();
            updateTakeoverUi(true);

            // 2. Запускаем передачу через XMLHttpRequest для точного трекинга прогресса
            currentMediaUploadXhr = new XMLHttpRequest();
            currentMediaUploadXhr.open('POST', '/inbox/send-media', true);

            // Отслеживаем реальные отправленные байты
            currentMediaUploadXhr.upload.onprogress = function (e) {
                if (e.lengthComputable) {
                    const percent = Math.round((e.loaded / e.total) * 100);
                    const fill = document.getElementById('uploadFill');
                    const statusText = document.getElementById('uploadStatusText');
                    const bytesText = document.getElementById('uploadBytesText');

                    if (percent < 100) {
                        if (fill) fill.style.width = percent + '%';
                        if (statusText) statusText.textContent = `Загрузка: ${percent}%`;
                        if (bytesText) bytesText.textContent = `${formatBytesSimple(e.loaded)} / ${fileSizeFormatted}`;
                    } else {
                        // Байты улетели на сервер: переключаем индикатор на 5% сжатия сервера
                        if (fill) {
                            fill.style.width = '5%';
                            fill.style.background = 'linear-gradient(90deg, #6366f1, #a855f7)';
                        }
                        if (statusText) {
                            statusText.textContent = file.type.startsWith('video') ? "⚙️ Сжатие видео: 5%..." : "⚙️ Обработка...";
                        }
                        if (bytesText) bytesText.textContent = "Начало сжатия";
                    }
                }
            };

            currentMediaUploadXhr.onload = function () {
                currentMediaUploadXhr = null;

                if (this.status >= 200 && this.status < 300) {
                    // Успех: временный бабл прогресса растворяется, а вместо него встает готовый медиа-бабл из SignalR
                    setTimeout(() => {
                        if (uploadBubble) uploadBubble.remove();
                    }, 600);
                } else {
                    const err = this.responseText;
                    if (uploadBubble) uploadBubble.remove();

                    if (err.includes("OUTSIDE_24H_WINDOW") || err.includes("outside of allowed window") || err.includes("2534022")) {
                        openMetaWindowModal();
                    } else {
                        alert("Ошибка отправки: " + err);
                    }
                }
            };

            currentMediaUploadXhr.onerror = function () {
                currentMediaUploadXhr = null;
                if (uploadBubble) uploadBubble.remove();
                alert("Сетевая ошибка при передаче файла.");
            };

            currentMediaUploadXhr.onabort = function () {
                currentMediaUploadXhr = null;
                if (uploadBubble) uploadBubble.remove();
                console.log("Загрузка отменена пользователем.");
            };

            currentMediaUploadXhr.send(formData);
        }

        // ФУНКЦИЯ КНОПКИ ОТМЕНЫ
        function abortMediaUpload() {
            if (currentMediaUploadXhr) {
                currentMediaUploadXhr.abort();
            }
        }

        function formatBytesSimple(bytes) {
            if (bytes === 0) return '0 Б';
            const k = 1024;
            const sizes = ['Б', 'КБ', 'МБ', 'ГБ'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        let mediaRecorder = null;
        let audioChunks = [];
        let recordingTimerInterval = null;
        let recordingSeconds = 0;

        // 1. СТАРТ ЗАПИСИ С МИКРОФОНА
        async function startVoiceRecording() {
            if (!currentConversationId) {
                alert("Сначала выберите диалог!");
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) audioChunks.push(e.data);
                };

                mediaRecorder.start();

                // Переключаем интерфейс ввода в режим записи
                document.getElementById('normalInputRow').style.display = 'none';
                document.getElementById('voiceRecordingUi').style.display = 'flex';

                // Запускаем таймер записи
                recordingSeconds = 0;
                document.getElementById('voiceRecTimer').textContent = "0:00";
                recordingTimerInterval = setInterval(() => {
                    recordingSeconds++;
                    const m = Math.floor(recordingSeconds / 60);
                    const s = recordingSeconds % 60;
                    document.getElementById('voiceRecTimer').textContent = `${m}:${s < 10 ? '0' : ''}${s}`;
                }, 1000);

            } catch (err) {
                alert("Не удалось получить доступ к микрофону. Разрешите доступ в браузере.");
            }
        }

        // 2. ОТМЕНА ЗАПИСИ
        function cancelVoiceRecording() {
            stopRecordingCleanup();
        }

        // 3. ОСТАНОВКА И ОТПРАВКА ГОЛОСОВОГО В ЧАТ
        function stopAndSendVoiceRecording() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') return;

            mediaRecorder.onstop = async () => {
                // Создаем Blob из записанного звука
                const audioBlob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });

                // Называем voice_*.webm - бэкенд переведет его в идеальный Instagram M4A
                const audioFile = new File([audioBlob], `voice_${Date.now()}.webm`, { type: audioBlob.type });

                const fakeInput = { files: [audioFile], value: '' };
                await uploadAndSendMedia(fakeInput);
            };

            mediaRecorder.stop();
            stopRecordingCleanup();
        }

        function stopRecordingCleanup() {
            if (recordingTimerInterval) clearInterval(recordingTimerInterval);
            if (mediaRecorder && mediaRecorder.stream) {
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
            }
            document.getElementById('voiceRecordingUi').style.display = 'none';
            document.getElementById('normalInputRow').style.display = 'flex';
        }

        async function translateBubble(btn) {
            const parent = btn.closest('.msg-bubble');
            if (!parent) return;

            const originalText = parent.dataset.rawText;
            if (!originalText) return;

            // Повторный клик скрывает открытый перевод:
            let existingTrans = parent.querySelector('.translated-text-block');
            if (existingTrans) {
                existingTrans.remove();
                btn.textContent = '🌐 Перевести';
                return;
            }

            btn.textContent = '⏳ Перевод...';

            // Вспомогательная функция отрисовки блока перевода:
            function showTranslation(translatedText) {
                const transDiv = document.createElement('div');
                transDiv.className = 'translated-text-block';
                transDiv.style.cssText = 'margin-top: 6px; padding-top: 4px; border-top: 1px dashed rgba(255,255,255,0.15); font-size: 0.82rem; color: #38bdf8; line-height: 1.3; font-style: italic;';
                transDiv.innerHTML = `<span>🌐 ${escapeHtml(translatedText)}</span>`;

                btn.parentElement.insertBefore(transDiv, btn);
                btn.textContent = '✕ Скрыть перевод';
            }

            // ===================================================================
            // 1. НАСТОЯЩИЙ БЕСПЛАТНЫЙ GOOGLE TRANSLATE НАПРЯМУЮ ИЗ БРАУЗЕРА!
            // ===================================================================
            try {
                // Запрос к Google Translate с автоопределением языка (sl=auto -> tl=ru)
                const googleUrl = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=ru&dt=t&q=${encodeURIComponent(originalText)}`;
                const directRes = await fetch(googleUrl);

                if (directRes.ok) {
                    const data = await directRes.json();
                    // Google возвращает структуру [[[ "Переведенный текст", "Оригинал", ... ]]]
                    if (Array.isArray(data) && data[0]) {
                        const trans = data[0].map(item => item[0]).filter(Boolean).join('');

                        if (trans && trans.trim().toLowerCase() !== originalText.trim().toLowerCase()) {
                            console.log("✅ Google Translate перевел за 0 руб прямо из браузера:", trans);
                            showTranslation(trans);
                            return;
                        }
                    }
                }
            } catch (e) {
                console.warn("Прямой вызов Google заблокирован блокировщиком рекламы, переходим на сервер...", e);
            }

            // ===================================================================
            // 2. ЗАПАСНОЙ ВАРИАНТ ЧЕРЕЗ СЕРВЕР (ТОЛЬКО ЕСЛИ БРАУЗЕР НЕ СМОГ)
            // ===================================================================
            try {
                const res = await fetch('/inbox/translate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: originalText })
                });

                if (res.ok) {
                    const data = await res.json();
                    showTranslation(data.translation);
                } else {
                    btn.textContent = '⚠️ Ошибка перевода';
                }
            } catch {
                btn.textContent = '⚠️ Сбой сети';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadDialogs();

            // 📱 NATIVE UX: Скрытие клавиатуры при касании и прокрутке переписки
            const messagesStream = document.getElementById('messagesStream');
            if (messagesStream) {
                let touchStartY = 0;

                messagesStream.addEventListener('touchstart', (e) => {
                    touchStartY = e.touches[0].clientY;
                }, { passive: true });

                messagesStream.addEventListener('touchmove', (e) => {
                    const diffY = Math.abs(e.touches[0].clientY - touchStartY);
                    // Если пользователь свайпнул переписку больше чем на 8px — плавно прячем клавиатуру
                    if (diffY > 8) {
                        const input = document.getElementById('messageInput');
                        if (document.activeElement === input) {
                            input.blur();
                        }
                    }
                }, { passive: true });
            }
        });

        // Переменные переводчика собеседника:
        let activeClientLang = null; // Текущий язык клиента (pt, en, es, de...)
        let originalRussianDraft = ''; // Запоминает русский текст до перевода
        const convoLangCache = new Map(); // 🚀 Мгновенная память: ID диалога -> код языка

        // 1. АВТООПРЕДЕЛЕНИЕ ЯЗЫКА КЛИЕНТА (ПО ПОСЛЕДНЕМУ СООБЩЕНИЮ)
        async function updateClientLanguage(incomingText) {
            const widget = document.getElementById('outgoingTranslateWidget');
            const btn = document.getElementById('btnTranslateOutgoing');
            const revertBtn = document.getElementById('btnRevertOutgoing');
            const transBox = document.getElementById('syncTranslatorBox');
            const subLabel = document.getElementById('syncTransSubLabel');

            if (!widget || !btn) return;

            // Вспомогательное скрытие всех переводчиков (если язык русский или нет текста)
            function hideAllTranslators() {
                widget.style.display = 'none';
                if (transBox) transBox.style.display = 'none';
                if (revertBtn) revertBtn.style.display = 'none';
                activeClientLang = null;
            }

            if (!incomingText || typeof incomingText !== 'string') {
                hideAllTranslators();
                return;
            }

            const clean = incomingText.trim();

            // Быстрая проверка: если текст содержит преимущественно кириллицу — это русский!
            const cyrillicMatch = clean.match(/[а-яА-ЯёЁ]/g);
            if (cyrillicMatch && cyrillicMatch.length > clean.length * 0.3) {
                hideAllTranslators();
                return;
            }

            // Если это иностранный текст — за 30 мс узнаем точный код языка через Google Translate:
            try {
                const detectUrl = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=ru&dt=t&q=${encodeURIComponent(clean.substring(0, 80))}`;
                const res = await fetch(detectUrl);
                if (res.ok) {
                    const data = await res.json();
                    const detectedCode = data[2];

                    if (detectedCode && detectedCode !== 'ru') {
                        activeClientLang = detectedCode.toLowerCase();

                        // Запоминаем для этого диалога:
                        if (currentConversationId) {
                            convoLangCache.set(currentConversationId, activeClientLang);
                        }

                        // Показываем тумблер в шапке чата:
                        if (transBox) transBox.style.display = 'flex';
                        if (subLabel) subLabel.textContent = `RU ➔ ${activeClientLang.toUpperCase()}`;

                        // 🚀 На телефонах делаем супер-компактный текст кнопки:
                        const label = document.getElementById('syncTransLabel');
                        if (label) {
                            label.textContent = window.innerWidth <= 768
                                ? `🌐 ${activeClientLang.toUpperCase()}`
                                : "🌐 Синхронный";
                        }

                        // Показываем кнопку быстрого перевода над полем ввода:
                        btn.textContent = `🌐 RU ➔ ${activeClientLang.toUpperCase()}`;
                        widget.style.display = 'inline-flex';
                        if (revertBtn) revertBtn.style.display = 'none';
                        return;
                    }
                }
            } catch { }

            hideAllTranslators();
        }

        // 2. ПЕРЕВОД НАПИСАННОГО РУССКОГО ТЕКСТА НА ЯЗЫК КЛИЕНТА
        async function translateOutgoingText() {
            const input = document.getElementById('messageInput');
            const btn = document.getElementById('btnTranslateOutgoing');
            const revertBtn = document.getElementById('btnRevertOutgoing');
            if (!input || !activeClientLang) return;

            const currentText = input.value.trim();
            if (!currentText) {
                alert("Сначала напишите текст ответа по-русски!");
                return;
            }

            // Запоминаем исходный русский черновик:
            originalRussianDraft = currentText;

            const originalBtnText = btn.textContent;
            btn.textContent = '⏳ Перевод...';

            try {
                const translateUrl = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=ru&tl=${activeClientLang}&dt=t&q=${encodeURIComponent(currentText)}`;
                const res = await fetch(translateUrl);
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data[0]) {
                        const translated = data[0].map(item => item[0]).filter(Boolean).join('');
                        if (translated) {
                            input.value = translated; // Заменяем текст прямо в поле ввода!
                            btn.textContent = originalBtnText;
                            if (revertBtn) revertBtn.style.display = 'inline-block';
                            input.focus();
                            return;
                        }
                    }
                }
            } catch (e) {
                console.error("Ошибка перевода исходящего сообщения:", e);
            }

            btn.textContent = originalBtnText;
            alert("Не удалось перевести текст на язык собеседника.");
        }

        // 3. ОТКАТ ОБРАТНО НА РУССКИЙ ТЕКСТ
        function revertOutgoingText() {
            const input = document.getElementById('messageInput');
            const revertBtn = document.getElementById('btnRevertOutgoing');

            if (input && originalRussianDraft) {
                input.value = originalRussianDraft;
                originalRussianDraft = '';
                if (revertBtn) revertBtn.style.display = 'none';
                input.focus();
            }
        }

        // Функция умного поиска языка: ищет назад по истории первое входящее сообщение с БУКВАМИ (игнорируя смайлы)
        function findClientMessageWithLetters(messages) {
            if (!messages || !messages.length) return null;

            // Идем с самого конца (от свежих к старым)
            for (let i = messages.length - 1; i >= 0; i--) {
                const m = messages[i];
                // \p{L} в Юникоде означает любую букву любого алфавита мира (латиница, арабский, иероглифы и т.д.)
                if (m.isIncoming && m.text && /\p{L}/u.test(m.text)) {
                    return m.text;
                }
            }
            return null;
        }
        
        // === СИНХРОННЫЙ ПЕРЕВОДЧИК В РЕАЛЬНОМ ВРЕМЕНИ ===
        let isSyncTranslateActive = false; // Состояние тумблера
        const translationCache = new Map(); // Кэш: исходный текст -> русский перевод

        // Вспомогательная быстрая функция перевода через Google Translate (0 руб)
        async function quickGoogleTranslate(text, sl, tl) {
            if (!text || !text.trim()) return null;
            const clean = text.trim();
            const cacheKey = `${sl}_${tl}_${clean}`;
            if (translationCache.has(cacheKey)) {
                return translationCache.get(cacheKey);
            }

            try {
                const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${sl}&tl=${tl}&dt=t&q=${encodeURIComponent(clean)}`;
                const res = await fetch(url);
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data[0]) {
                        const trans = data[0].map(item => item[0]).filter(Boolean).join('');
                        if (trans && trans.toLowerCase() !== clean.toLowerCase()) {
                            translationCache.set(cacheKey, trans);
                            return trans;
                        }
                    }
                }
            } catch (e) {
                console.warn("Ошибка быстрого перевода:", e);
            }
            return null;
        }

        // 1. ПЕРЕКЛЮЧЕНИЕ ТУМБЛЕРА СИНХРОННОГО ПЕРЕВОДЧИКА
        async function toggleSyncTranslator(isOn) {
            isSyncTranslateActive = isOn;
            const box = document.getElementById('syncTranslatorBox');
            const label = document.getElementById('syncTransLabel');
            if (box) box.classList.toggle('active', isOn);

            if (isOn) {
                if (label) {
                    if (window.innerWidth <= 768 && activeClientLang) {
                        label.textContent = `🌐 ${activeClientLang.toUpperCase()}`;
                    } else {
                        label.textContent = isOn ? "🌐 Включен" : "🌐 Синхронный";
                    }
                }
                    await applySyncTranslationToAllBubbles(true);
                } else {
                if (label) {
                    if (window.innerWidth <= 768 && activeClientLang) {
                        label.textContent = `🌐 ${activeClientLang.toUpperCase()}`;
                    } else {
                        label.textContent = isOn ? "🌐 Включен" : "🌐 Синхронный";
                    }
                }
                applySyncTranslationToAllBubbles(false);
            }
        }

        // 2. ПРИМЕНЕНИЕ ИЛИ ОТКАТ ПЕРЕВОДА ДЛЯ ВСЕХ СООБЩЕНИЙ В ЧАТЕ
        async function applySyncTranslationToAllBubbles(enable) {
            const bubbles = document.querySelectorAll('#messagesStream .msg-bubble');

            for (const bubble of bubbles) {
                const rawText = bubble.dataset.rawText;
                if (!rawText) continue;

                // Находим контейнер самого текста внутри бабла
                const textNode = Array.from(bubble.children).find(c =>
                    c.tagName === 'DIV' &&
                    !c.classList.contains('msg-footer') &&
                    !c.classList.contains('msg-media-container') &&
                    !c.classList.contains('reaction-badge') &&
                    !c.classList.contains('translated-text-block')
                );

                if (!textNode) continue;

                if (enable) {
                    // Если текст иностранный (нет кириллицы, но есть буквы)
                    const isForeign = !/[а-яА-ЯёЁ]/.test(rawText) && /\p{L}/u.test(rawText);
                    if (isForeign) {
                        // Берем перевод из кэша или запрашиваем
                        let trans = await quickGoogleTranslate(rawText, 'auto', 'ru');
                        if (trans) {
                            textNode.innerHTML = escapeHtml(trans);
                            // Добавляем маленький бейдж оригинала
                            addOrUpdateTransBadge(bubble, activeClientLang || 'lang', rawText);
                        }
                    }
                } else {
                    // ВОЗВРАЩАЕМ ИСХОДНЫЙ ТЕКСТ:
                    textNode.innerHTML = escapeHtml(rawText);
                    removeTransBadge(bubble);
                }
            }
        }

        function addOrUpdateTransBadge(bubble, langCode, originalText) {
            let footer = bubble.querySelector('.msg-footer');
            if (!footer) return;

            let badge = footer.querySelector('.msg-trans-badge');
            if (!badge) {
                badge = document.createElement('span');
                badge.className = 'msg-trans-badge';
                footer.insertBefore(badge, footer.firstChild);
            }
            badge.textContent = `🌐 ${langCode.toUpperCase()}`;
            badge.title = `Оригинал: ${originalText}`;
        }

        function removeTransBadge(bubble) {
            let badge = bubble.querySelector('.msg-trans-badge');
            if (badge) badge.remove();
        }

    </script>
}