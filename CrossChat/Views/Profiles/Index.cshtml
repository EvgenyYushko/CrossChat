@model CrossChat.Controllers.AuthUser
@{
    ViewData["Title"] = "Выбор профиля";
}

@section Styles {
    <style>
        .container { max-width: 900px; margin: 6rem auto 3rem; padding: 0 1rem; }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            display: block;
            color: var(--text-main);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3);
            border-color: var(--accent-color);
        }

        .card-dashed {
            border: 2px dashed var(--glass-border);
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-dashed:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .avatar-lg {
            width: 100px; height: 100px;
            border-radius: 50%; object-fit: cover;
            margin-bottom: 1rem; border: 3px solid var(--accent-color);
        }

        h1 { color: var(--text-main); margin-bottom: 1rem; }
        h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
        p { color: var(--text-secondary); font-size: 0.9rem; }


        .logout-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: white;
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .card-actions {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .dots-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 1.5rem;
            padding: 5px 10px;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            background: #1a1a1a;
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            z-index: 10;
        }

            .dropdown-menu.show {
                display: block;
            }

        .dropdown-item {
            display: block;
            padding: 8px 15px;
            color: white;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .dropdown-item:hover {
                background: #333;
            }
    </style>
}

@section NavbarActions {
    <!-- Вставляем меню пользователя в Навбар Лейаута -->
    <div style="display: flex; align-items: center;">
        @* <span class="user-email">@Model.User.Email</span> *@
        <form action="/auth/logout" method="post" style="margin:0">
            <button class="logout-btn">Выйти</button>
        </form>
    </div>
}
 
<div class="container">
    <!-- Карточка Приветствия -->
    <div class="card" style="display:flex; align-items:center; gap:15px;">
        @if (!string.IsNullOrEmpty(Model.User.AvatarUrl))
        {
            <img src="@Model.User.AvatarUrl" style="width:50px; height:50px; border-radius:50%;" alt="Avatar">
        }
        else
        {
            <div style="width:50px; height:50px; border-radius:50%; background:#333; display:flex; align-items:center; justify-content:center;">
                @Model.User.Name.Substring(0, 1)
            </div>
        }
        <div>
            <h2 style="margin:0; font-size:1.2rem;">@Model.User.Name</h2>
        </div>
       @*  <a href="/auth/console" class="logout-btn" style="border-color:var(--accent-color); color:var(--accent-color);">
            💻 Открыть консоль разработчика
        </a> *@
    </div>

    <br/>

    <h1 style="text-align: center;">Ваши профили</h1>

    <div class="grid">
        @foreach (var profile in Model.User.Profile)
        {
            <div class="card" style="position: relative;">
                <!-- 1. Меню трех точек (ВНЕ ссылки) -->
                <div class="card-actions" style="position: absolute; top: 10px; right: 10px;">
                    <button class="dots-btn" onclick="toggleMenu(@profile.Id)">⋮</button>
                    <div id="menu-@profile.Id" class="dropdown-menu">
                        <a href="/profile/edit/@profile.Id" class="dropdown-item">Редактировать</a>
                        <form action="/profile/delete" method="post" onsubmit="return confirm('Удалить профиль?');">
                            <input type="hidden" name="id" value="@profile.Id" />
                            <button type="submit" class="dropdown-item" style="color:red; background:none; border:none; width:100%; text-align:left;">Удалить</button>
                        </form>
                    </div>
                </div>

                <!-- 2. Кликабельная часть (ССЫЛКА) -->
                <a href="/profile?profileId=@profile.Id" style="text-decoration:none; color:inherit; display:block;">
                    @if (!string.IsNullOrEmpty(profile.AvatarUrl))
                    {
                        <img src="@profile.AvatarUrl" class="avatar-lg" alt="@profile.Name">
                    }
                    else
                    {
                        <div class="avatar-lg" style="background:#333; display:flex; align-items:center; justify-content:center; font-size:2rem; margin: 0 auto 1rem;">
                            @profile.Name.Substring(0, 1)
                        </div>
                    }
                    <h3>@profile.Name</h3>
                </a>
            </div>
        }

        <a href="/profile/create" class="card card-dashed">
            <h3>+ Добавить профиль</h3>
        </a>
    </div>
</div>

    

@section Scripts {
    <script>
        function toggleMenu(id) {
            // Закрываем другие меню, если открыты
            document.querySelectorAll('.dropdown-menu').forEach(m => {
                if(m.id !== 'menu-' + id) m.classList.remove('show');
            });
            document.getElementById('menu-' + id).classList.toggle('show');
        }

        // Закрыть меню при клике в любое другое место
        window.onclick = function(event) {
            if (!event.target.matches('.dots-btn')) {
                document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
            }
        }
    </script>
}