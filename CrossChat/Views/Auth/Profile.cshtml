@model CrossChat.Data.Entities.User
@{
    ViewData["Title"] = "Личный кабинет";
}

@section Styles {
    <style>
        /* Специфичные стили ТОЛЬКО для Профиля */
        .container {
            max-width: 600px;
            margin: 6rem auto 2rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg); /* Теперь используется переменная! */
            border: 1px solid var(--glass-border);
            border-radius: 16px; /* или 20px, как было */
            padding: 1.5rem;
        }

        /* Кнопки сервисов */
        .btn-instagram, .btn-telegram {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            font-weight: 600;
            margin-top: 1rem;
            transition: background 0.2s;
            box-sizing: border-box;
        }

        .btn-instagram {
            background: #262626;
            border: 1px solid #404040;
        }

            .btn-instagram:hover {
                background: #333;
            }

        .btn-telegram {
            background: #262626;
            border: 1px solid #404040;
            cursor: pointer;
        }

            .btn-telegram:hover {
                background: #2AABEE;
                border-color: #2AABEE;
            }

        /* Иконки */
        .service-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-right: 12px;
        }

            .service-icon svg {
                width: 22px;
                height: 22px;
                fill: white;
            }

        .icon-insta {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
            box-shadow: 0 4px 12px rgba(220, 39, 67, 0.3);
        }

        .icon-tg {
            background: linear-gradient(135deg, #2AABEE 0%, #229ED9 100%);
            box-shadow: 0 4px 12px rgba(34, 158, 217, 0.3);
        }

        /* Статусы */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-disconnected {
            background: rgba(255,255,255,0.1);
            color: #888;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .status-soon {
            background: rgba(124, 58, 237, 0.15);
            color: #a78bfa;
            border: 1px solid rgba(124, 58, 237, 0.2);
        }

        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .status-active .dot {
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }

            100% {
                opacity: 1;
            }
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: white;
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .user-email {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-right: 1rem;
        }

        @@media(max-width: 600px) {
            .user-email {
                display: none;
            }
        }

        /* === СТИЛИ КНОПОК ДЛЯ СВЕТЛОЙ ТЕМЫ === */
        [data-theme="light"] .btn-instagram,
        [data-theme="light"] .btn-telegram {
            background: #f1f5f9; /* Очень светлый серо-синий фон */
            border: 1px solid #e2e8f0; /* Светлая рамка */
            color: #0f172a; /* Темно-синий/почти черный текст */
            box-shadow: 0 1px 2px rgba(0,0,0,0.05); /* Легкая тенюшка */
        }

        /* Эффект наведения в светлой теме */
        [data-theme="light"] .btn-instagram:hover,
        [data-theme="light"] .btn-telegram:hover {
            background: #e2e8f0; /* Чуть темнее при наведении */
            color: #000000;
        }

        /* Для кнопки выхода в шапке (если она тоже темная) */
        [data-theme="light"] .logout-btn {
            border-color: #cbd5e1;
            color: #475569;
        }
        [data-theme="light"] .logout-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

    </style>
}

@section NavbarActions {
    <!-- Вставляем меню пользователя в Навбар Лейаута -->
    <div style="display: flex; align-items: center;">
        <span class="user-email">@Model.Email</span>
        <form action="/auth/logout" method="post" style="margin:0">
            <button class="logout-btn">Выйти</button>
        </form>
    </div>
}

<div class="container">
    <!-- Карточка Приветствия -->
    <div class="card" style="display:flex; align-items:center; gap:15px;">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" style="width:50px; height:50px; border-radius:50%;" alt="Avatar">
        }
        else
        {
            <div style="width:50px; height:50px; border-radius:50%; background:#333; display:flex; align-items:center; justify-content:center;">
                @Model.Name.Substring(0, 1)
            </div>
        }
        <div>
            <h2 style="margin:0; font-size:1.2rem;">Привет, @Model.Name!</h2>
        </div>
    </div>

    <!-- Карточка Instagram -->
    <div class="card" >
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">

        <div style="display:flex; align-items:center;">
            <div class="service-icon icon-insta">
                <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" /></svg>
            </div>
            <h3 style="margin:0; font-size:1.2rem;">Instagram</h3>
        </div>

            @if (Model.InstagramSettingsList == null || !Model.InstagramSettingsList.Any())
            {
                <span class="status-badge status-disconnected">Не подключено</span>

            }
        </div>

        <a href="/instagram" class="btn-instagram">+ Подключить аккаунт</a>        

        @if (Model.InstagramSettingsList != null && Model.InstagramSettingsList.Any())
        {
            <br />
            @foreach (var bot in Model.InstagramSettingsList)
            {
                <div class="card" style="margin-bottom: 20px;">
                    

                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom:1rem;">
                        @if (!string.IsNullOrEmpty(@bot.ProfilePictureUrl))
                        {
                            <img src="@bot.ProfilePictureUrl" style="width: 48px; height: 48px; border-radius: 50%;">
                        }
                        <div>
                            <div style="font-weight:600;">@bot.Username</div>
                            <div style="margin-top:2px;">
                                @(bot.IsActive? Html.Raw("<span style='color:#10b981;'>● Бот работает</span>") : Html.Raw("<span style='color:#fbbf24;'>⚠️ Бот выключен</span>"))
                            </div>
                        </div>
                    </div>

                    <a href="/instagram?botId=@bot.Id" class="btn-instagram">⚙️ Настроить бота</a>
                </div>
            }
        } 
    </div>

     <br />

    <!-- Карточка Threads -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
            <div style="display:flex; align-items:center;">
                <!-- Иконка Threads (Черный фон, белая спираль) -->
                <div class="service-icon" style="background: #000; box-shadow: 0 4px 12px rgba(255,255,255,0.1);">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 24c6.627 0 12-5.373 12-12S18.627 0 12 0 0 5.373 0 12s5.373 12 12 12zm0-22c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z" />
                    </svg>
                </div>
                <h3 style="margin:0; font-size:1.2rem;">Threads</h3>
            </div>

            @if (Model.ThreadsSettingsList == null || !Model.ThreadsSettingsList.Any())
            {
                <span class="status-badge status-disconnected">Не подключено</span>
            }
        </div>

        <!-- Кнопка подключения нового аккаунта -->
        <a href="/threads" class="btn-instagram" style="background: #000; border: 1px solid #333;">+ Подключить Threads</a>

        @if (Model.ThreadsSettingsList != null && Model.ThreadsSettingsList.Any())
        {
            <br />
            @foreach (var bot in Model.ThreadsSettingsList)
            {
                <!-- Вложенная карточка конкретного аккаунта Threads -->
                <div class="card" style="margin-bottom: 20px; background: rgba(255,255,255,0.02);">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom:1rem;">
                        @if (!string.IsNullOrEmpty(bot.ProfilePictureUrl))
                        {
                            <img src="@bot.ProfilePictureUrl" style="width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--glass-border);">
                        }
                        else
                        {
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #333; display:flex; align-items:center; justify-content:center;">TH</div>
                        }
                        <div>
                            <div style="font-weight:600;">@@@bot.Username</div>
                            <div style="margin-top:2px;">
                                @if (bot.IsActive)
                                {
                                    <span style='color:#10b981; font-size: 0.85rem;'>● Бот работает</span>
                                }
                                else
                                {
                                    <span style='color:#fbbf24; font-size: 0.85rem;'>⚠️ Бот выключен</span>
                                }
                            </div>
                        </div>
                    </div>

                    <a href="/threads?botId=@bot.Id" class="btn-instagram" style="background: #222;">⚙️ Настроить бота</a>
                </div>
            }
        }
    </div>

    <br/>

    <!-- Карточка Telegram -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
            <div style="display:flex; align-items:center;">
                <div class="service-icon icon-tg">
                    <svg viewBox="0 0 24 24" style="margin-left:-2px;"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.441z" /></svg>
                </div>
                <h3 style="margin:0; font-size:1.2rem;">Telegram</h3>
            </div>

            @if (Model.TelegramSettings != null && !string.IsNullOrEmpty(Model.TelegramSettings.BotToken))
            {
                <span class="status-badge @(Model.TelegramSettings.IsActive ? "status-active" : "status-paused")">
                    <span class="dot"></span>@(Model.TelegramSettings.IsActive ? "Активен" : "На паузе")
                </span>
            }
            else
            {
                <span class="status-badge status-disconnected">Не подключено</span>
            }
        </div>

        @if (Model.TelegramSettings != null && !string.IsNullOrEmpty(Model.TelegramSettings.BotToken))
        {
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom:1rem;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #2AABEE; display:flex; align-items:center; justify-content:center; color:white; font-size: 1.2rem;">
                    @Model.TelegramSettings.BotUsername?.Substring(0, 1)
                </div>
                <div>
                    <div style="font-weight:600;">@@@Model.TelegramSettings.BotUsername</div>
                    <div style="font-size:0.85rem; margin-top:2px;">
                        @(Model.TelegramSettings.IsActive? Html.Raw("<span style='color:#10b981;'>● Бот работает</span>") : Html.Raw("<span style='color:#fbbf24;'>⚠️ Бот выключен</span>"))
                    </div>
                </div>
            </div>

            <a href="/telegram" class="btn-telegram">
                ⚙️ Настроить и @(Model.TelegramSettings.IsActive ? "Выключить" : "Включить")
            </a>
        }
        else
        {
            <p style="color:#aaa; font-size:0.9rem; margin-bottom:0;">Подключите бота через API токен.</p>
            <a href="/telegram" class="btn-telegram">+ Подключить Telegram</a>
        }
    </div>
</div>