@model CrossChat.Data.Entities.BlueSkySettings
@{
    ViewData["Title"] = "Управление BlueSky";
    bool isConnected = !string.IsNullOrEmpty(Model?.AccessToken);
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Профиль</a>
}

@section Styles {
    <style>
        /* Уникальные стили для страницы BlueSky */

        /* 1. ИСПРАВЛЕНИЕ ШИРИНЫ */
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
        }

        /* 2. ИСПРАВЛЕНИЕ АВАТАРКИ (ЦЕНТРИРОВАНИЕ) */
        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #0085ff; /* ИСПРАВЛЕНИЕ: Фирменный синий цвет BlueSky вместо Instagram */
            padding: 4px;
            background: transparent;
            margin-bottom: 1rem;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }

        .user-id {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-family: monospace;
        }

        /* ФОРМА */
        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
        }

        /* СТИЛИЗАЦИЯ ИСПРАВЛЕННЫХ ТЕКСТОВЫХ ПОЛЕЙ ВВОДА */
        .text-input {
            width: 100%;
            box-sizing: border-box; /* Исключает вылет полей за рамки */
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .text-input:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            font-family: inherit;
            resize: vertical;
            min-height: 120px;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        /* Группа верхних кнопок управления */
        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            box-sizing: border-box;
        }

        /* Стилизация кнопки консоли бота (стеклянный стиль) */
        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

            .btn-console:hover {
                background: rgba(15, 23, 42, 0.7) !important;
                border-color: var(--text-secondary) !important;
                transform: translateY(-1px);
            }

        /* Стилизация кнопки автопостинга (Индиго-градиент) */
        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
                transform: translateY(-1px);
            }

        .btn-bsky {
            background: #0085ff;
            color: white;
            box-shadow: 0 4px 12px rgba(0, 133, 255, 0.2);
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        .login-buttons {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1rem;
        }

        .separator {
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--text-secondary);
            margin: 20px 0;
            font-size: 13px;
        }

            .separator::before, .separator::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid var(--glass-border);
            }

            .separator::before {
                margin-right: 10px;
            }

            .separator::after {
                margin-left: 10px;
            }

        /* СТАТУСЫ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* ТОГГЛ */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        /* ИНСТРУКЦИЯ */
        .instruction-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 0.95rem;
            cursor: pointer;
            margin-bottom: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

            .instruction-btn:hover {
                border-color: var(--text-main);
                color: var(--text-main);
                background: rgba(255,255,255,0.05);
            }

        .instruction-content {
            display: none;
            text-align: left;
            background: #121212;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid var(--glass-border);
        }

        .safety-note {
            background: rgba(16, 185, 129, 0.1);
            border-left: 4px solid #10b981;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            font-size: 0.9rem;
            line-height: 1.6;
            color: #d1fae5;
        }

        .instruction-step {
            margin-bottom: 2rem;
        }

        .step-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: white;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .step-num {
            background: linear-gradient(45deg, #f09433, #bc1888);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: bold;
            flex-shrink: 0;
        }

        .step-list {
            margin-left: 10px;
            padding-left: 15px;
            border-left: 2px solid #333;
        }

            .step-list li {
                margin-bottom: 8px;
                color: var(--text-secondary);
                font-size: 0.95rem;
                list-style: none;
            }

                .step-list li strong {
                    color: white;
                }

        .open {
            display: block;
            animation: fadeIn 0.4s ease-in-out;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* МОБИЛЬНАЯ АДАПТАЦИЯ */
        @@media (max-width: 600px) {
            .container

        {
            margin-top: 5rem;
        }

        .card {
            padding: 1.5rem;
        }

        .instruction-content {
            padding: 1rem;
        }

        .btn {
            padding: 12px 10px;
            font-size: 0.9rem;
        }

        /* Складываем кнопки управления в один ряд вертикально на мобилках */
        .action-buttons-group {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        }

        .reactions-input {
            width: 100%;
            min-height: 50px;
            font-size: 1.2rem;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            background: var(--input-bg);
        }

        /* --- СВЕТЛАЯ ТЕМА ДЛЯ КНОПОК --- */
        [data-theme="light"] .btn-console {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

            [data-theme="light"] .btn-console:hover {
                background: #f1f5f9 !important;
                border-color: #94a3b8 !important;
            }
    </style>
}

@section Scripts {
    <script>
        // Показ уведомления "Сохранено"
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('saved')) {
            const toast = document.getElementById('toast');
            if(toast) {
                toast.style.display = 'block';
                setTimeout(() => toast.style.display = 'none', 3000);
            }
        }

        function toggleInstruction() {
            var block = document.getElementById('instructionBlock');
            if (block.style.display === 'block') {
                block.style.display = 'none';
            } else {
                block.style.display = 'block';
                block.classList.add('open');
            }
        }
    </script>
}

<div class="container">
    <div class="card">
        @if (!isConnected)
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ === */
            <div style="text-align: center;">
                <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
                    <svg width="50" height="50" viewBox="0 0 24 24" fill="#0085ff" style="color: #0085ff; filter: drop-shadow(0 4px 12px rgba(0, 133, 255, 0.25));">
                        <path d="M12 10.57c2.16-3.85 4.97-6.9 7.32-6.9 2.92 0 4.68 2.65 4.68 5.38 0 4.42-4.14 7.91-7.31 9.77-1.17.68-2.53 1.12-3.89 1.12h-.8c-1.36 0-2.72-.44-3.89-1.12C4.84 16.96.7 13.47.7 9.05c0-2.73 1.76-5.38 4.68-5.38 2.35 0 5.16 3.05 7.32 6.9z" />
                    </svg>
                </div>
                <h1 style="margin-bottom: 10px;">Подключение BlueSky</h1>
                <p style="color:var(--text-secondary); margin-bottom:2rem;">
                    Введите ваш Handle (например, username.bsky.social) для подключения.
                </p>

                <form action="/bluesky/connect" method="post" style="text-align: left;">
                    <div class="form-group">
                        <label>Никнейм (Handle)</label>
                        <input type="text" name="handle" class="text-input" placeholder="username.bsky.social" required>
                    </div>
                    <button type="submit" class="btn btn-bsky" style="margin-top: 15px;">Авторизоваться</button>
                </form>
            </div>
        }
        else
        {
            /* === РЕЖИМ НАСТРОЕК === */
            <div id="toast" style="display:none; background:#10b981; color:white; padding:10px; border-radius:8px; margin-bottom:1rem; text-align: center;">
                Настройки сохранены!
            </div>

            <div class="connected-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
                }
                else
                {
                    <div class="big-avatar" style="display:flex;align-items:center;justify-content:center;font-size:2rem;border-color:white;color:white;">BS</div>
                }
                <div class="username">@@@Model.Handle</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот в сети</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Отключен</span>
                    }
                </div>
            </div>

            <!-- НОВАЯ СИММЕТРИЧНАЯ ГРУППА КНОПОК ДЕЙСТВИЯ -->
            <div class="action-buttons-group">
                <a href="/auth/console?provider=bluesky&botId=@Model.Id&username=@Model.Handle" class="btn btn-console">
                    💻 Консоль бота
                </a>
                <a href="/planner?profileId=@Model.ProfileId&network=BlueSky&botId=@Model.Id" class="btn btn-autoposting">
                    📅 Автопостинг
                </a>
            </div>

            <form action="/bluesky/update" method="post" class="form-section">
                <input type="hidden" name="botId" value="@Model.Id" />

                <!-- Переключатель активности -->
                <div class="switch-container">
                    <div>
                        <label style="margin:0; font-size: 1.1rem; color: white;">Автоответы</label>
                        <div style="font-size: 0.8rem; color: var(--text-secondary);">Обрабатывать упоминания и реплаи</div>
                    </div>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="form-group">
                    <label>Системный промпт для ИИ</label>
                    <textarea name="systemPrompt" placeholder="Опишите поведение бота...">@Model.SystemPrompt</textarea>
                    <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:0.5rem;">
                        Инструкция, которой будет следовать Gemini при ответах в BlueSky.
                    </p>
                </div>

                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            </form>

            <form action="/bluesky/disconnect" method="post" onsubmit="return confirm('Отключить аккаунт BlueSky?');" style="margin-top: 1rem;">
                <input type="hidden" name="botId" value="@Model.Id" />
                <button type="submit" class="btn btn-danger" style="margin-top: 20px;">Удалить интеграцию</button>
            </form>
        }
    </div>
</div>