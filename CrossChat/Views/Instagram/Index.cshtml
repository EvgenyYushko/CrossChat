    <a href="/auth/profile" class="back-link">← Назад в профиль</a>
} *@

@section Scripts {
    <script>
        function toggleInstruction() {
            var block = document.getElementById('instructionBlock');
            if (block.style.display === 'block') {
                block.style.display = 'none';
            } else {
                block.style.display = 'block';
                block.classList.add('open');
            }
        }
    </script>
}

<div class="container">
    <div class="card">
        @if (isConnected)
        {
            /* === ПОДКЛЮЧЕНО === */
            <div class="connected-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
                }
                else
                {
                    <div class="big-avatar" style="display:flex;align-items:center;justify-content:center;font-size:2rem;border-color:white;color:white;">IG</div>
                }

                <div class="username">@@@(Model.Username ?? "Instagram User")</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот работает</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Требует включения</span>
                        <p style="color: #fbbf24; font-size: 0.85rem; margin-top: 8px;">
                            Подписка на сообщения отключена.
                        </p>
                    }
                </div>
            </div>

            <div class="form-section">
                <form action="/instagram/update-settings" method="post">

                    <div class="switch-container">
                        <div>
                            <label style="margin:0; font-size: 1.1rem; color: white; cursor: pointer;" for="isActiveCheck">Включить автоответы</label>
                            <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                                @(Model.IsActive ? "Бот читает сообщения и отвечает." : "Передвиньте, чтобы активировать.")
                            </div>
                        </div>

                        <label class="switch">
                            <input type="checkbox" id="isActiveCheck" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Системный промпт</label>
                        <textarea name="systemPrompt" placeholder="Опишите поведение бота...">@(Model.SystemPrompt)</textarea>
                        <p style="font-size:0.85rem; color:#666; margin-top:0.5rem;">
                            Инструкция для ИИ (Gemini).
                        </p>
                    </div>

                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                </form>
            </div>

            <form action="/instagram/disconnect" method="post" onsubmit="return confirm('Вы уверены? Бот перестанет отвечать.');">
                <button type="submit" class="btn btn-danger">Отключить аккаунт</button>
            </form>
        }
        else
        {
            /* === НЕ ПОДКЛЮЧЕНО === */
            <div>
                <h1>Подключение Instagram</h1>
                <p style="color:var(--text-secondary); margin-bottom:2rem;">
                    Чтобы бот заработал, аккаунт должен быть правильно настроен.
                </p>

                <button class="instruction-btn" onclick="toggleInstruction()">
                    <span>📖</span> Инструкция: Как подготовить аккаунт?
                </button>

                <div id="instructionBlock" class="instruction-content">
                    <!-- Вступление про безопасность -->
                    <div class="safety-note">
                        <strong>Безопасно и официально</strong><br>
                        CrossChat работает по официальному API Instagram. Блокировки аккаунта за использование нашего сервиса исключены. Мы соблюдаем все правила компании Meta.
                    </div>

                    <!-- Шаг 1 -->
                    <div class="instruction-step">
                        <div class="step-title"><div class="step-num">1</div> Перевод в профессиональный режим</div>
                        <ul class="step-list">
                            <li>В профиле Instagram откройте <strong>"Настройки и действия"</strong></li>
                            <li>Перейдите в пункт <strong>"Тип аккаунта и инструменты"</strong></li>
                            <li>Нажмите <strong>"Переключиться на профессиональный аккаунт"</strong> (Бизнес).</li>
                        </ul>

                        <div class="tip-box">
                            <strong>💡 Как проверить, что у вас уже профи-аккаунт?</strong><br>
                            Если в настройках вы видите раздел "Для профессиональных аккаунтов" и пункт "Инструменты для бизнеса/автора" — значит, всё уже готово.
                        </div>
                    </div>

                    <!-- Шаг 2 -->
                    <div class="instruction-step">
                        <div class="step-title"><div class="step-num">2</div> Разрешение доступа к сообщениям</div>
                        <p class="step-desc" style="color:#fbbf24; margin-bottom:10px;">⚠️ Это самый важный шаг!</p>
                        <ul class="step-list">
                            <li>В профиле откройте <strong>"Настройки и действия"</strong></li>
                            <li>Перейдите в пункт <strong>"Сообщения и ответы на истории"</strong></li>
                            <li>Откройте <strong>"Управление сообщениями"</strong> (Message Controls)</li>
                            <li>Включите переключатель <strong>"Разрешить доступ к сообщениям"</strong> (Allow Access to Messages).</li>
                        </ul>
                    </div>

                    <!-- Шаг 3 -->
                    <div class="instruction-step">
                        <div class="step-title"><div class="step-num">3</div> Подключение</div>
                        <p class="step-desc">
                            Теперь нажмите кнопку ниже.
                        </p>
                    </div>
                </div>

                <div class="login-buttons">
                    <a href="@ViewBag.InstaLoginUrl" class="btn btn-insta">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                        </svg>
                        <span>Войти через Instagram</span>
                    </a>
                    <div class="separator">ИЛИ</div>
                    <a href="@ViewBag.FbLoginUrl" class="btn btn-fb">
                        <svg viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                        <span>Войти через Facebook</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

