@model List<CrossChat.Controllers.InstagramController.InstagramCustomerAnalysisDto>
@{
    var settings = ViewBag.Settings as CrossChat.Data.Entities.InstagramSettings;
    var botUsername = settings?.Username ?? "Instagram";
    var currentProfileId = settings?.ProfileId ?? 0;
    var currentBotId = ViewBag.BotId ?? 0;
    ViewData["Title"] = "AI Диалоги — @" + botUsername;

    int filterMode = ViewBag.BotFilterMode ?? 0;
    string whitelistStr = ViewBag.BotWhitelist as string ?? "";

    int totalCustomers = Model.Count;
    int activeToday = Model.Count(c => c.TodayResponsesCount > 0);
    int totalResponses = Model.Sum(c => c.TotalResponsesCount);
    int withVision = Model.Count(c => !string.IsNullOrEmpty(c.AiContext) || !string.IsNullOrEmpty(c.AppearanceDescription));
    int totalGallery = ViewBag.TotalGalleryItemsCount ?? 0;
    int totalMediaSent = Model.Sum(c => c.SentMediaCount);
    long botTotalTokens = Model.Sum(c => c.TotalTokensSpent);
    long botTodayTokens = Model.Sum(c => c.TodayTokensSpent);
    var modelStats = ViewBag.ModelBreakdown as List<CrossChat.Controllers.InstagramController.ModelUsageStatDto> ?? new();
    double botEstimatedUsd = modelStats.Sum(x => x.EstimatedUsd);
}

@section Styles {
    <style>
        .ai-chats-container {
            max-width: 1120px;
            margin: 5rem auto 3rem;
            padding: 0 1rem;
            box-sizing: border-box;
        }

        .header-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 1.4rem 1.75rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .header-btn {
            padding: 9px 14px;
            font-size: 0.85rem;
            border-radius: 11px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: transform 0.15s ease, opacity 0.15s ease;
            border: none;
        }

            .header-btn:hover {
                transform: translateY(-1px);
                opacity: 0.95;
            }

        .filter-banner {
            background: var(--card-bg, #1e293b);
            border-radius: 16px;
            padding: 12px 18px;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .kpi-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
            margin-bottom: 1.25rem;
        }

        .kpi-box {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 0.95rem 1.15rem;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .kpi-num {
            font-size: 1.45rem;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1.2;
        }

        .kpi-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            line-height: 1.3;
        }

        .search-box {
            width: 100%;
            margin-bottom: 1rem;
        }

        .search-input {
            width: 100%;
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 11px 16px;
            color: var(--text-main);
            font-size: 0.92rem;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .search-input:focus {
                border-color: #10b981;
            }

        .customers-table-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .table-chats {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            text-align: left;
        }

            .table-chats th {
                padding: 12px 14px;
                background: rgba(255, 255, 255, 0.02);
                border-bottom: 1px solid var(--glass-border);
                color: var(--text-secondary);
                font-size: 0.74rem;
                text-transform: uppercase;
                font-weight: 700;
                white-space: nowrap;
            }

            .table-chats td {
                padding: 13px 14px;
                border-bottom: 1px solid var(--glass-border);
                color: var(--text-main);
                vertical-align: middle;
            }

        .table-row-customer {
            cursor: pointer;
            transition: background 0.15s ease;
        }

            .table-row-customer:hover {
                background: rgba(255, 255, 255, 0.03);
            }

            .table-row-customer.expanded {
                background: rgba(16, 185, 129, 0.06);
                border-bottom-color: transparent;
            }

        .cust-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--glass-border);
            flex-shrink: 0;
            background: linear-gradient(135deg, #e1306c, #8b5cf6);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.9rem;
        }

        .badges-stack {
            display: flex;
            flex-direction: column;
            gap: 5px;
            align-items: flex-start;
        }

        .badge-responses {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 8px;
            font-size: 0.74rem;
            font-weight: 700;
            background: rgba(99, 102, 241, 0.12);
            color: #818cf8;
            border: 1px solid rgba(99, 102, 241, 0.25);
            white-space: nowrap;
        }

        .badge-today {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .btn-view-vision {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #10b981;
            border-radius: 8px;
            padding: 6px 11px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
            white-space: nowrap;
        }

            .btn-view-vision:hover {
                background: #10b981;
                color: #ffffff;
            }

        .actions-cell-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .act-btn {
            padding: 6px 9px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: opacity 0.15s ease, transform 0.15s ease;
        }

            .act-btn:hover {
                transform: translateY(-1px);
            }

        .arrow-indicator {
            font-size: 0.9rem;
            color: var(--text-secondary);
            transition: transform 0.2s;
            margin-left: auto;
            padding-left: 4px;
        }

        .row-details-chat {
            display: none;
            background: rgba(15, 23, 42, 0.45);
            border-bottom: 1px solid var(--glass-border);
        }

            .row-details-chat.is-open {
                display: table-row;
            }

        .chat-preview-box {
            padding: 1rem 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 9px;
            max-height: 360px;
            overflow-y: auto;
        }

        .mini-bubble {
            max-width: 78%;
            padding: 9px 13px;
            border-radius: 13px;
            font-size: 0.85rem;
            line-height: 1.4;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .mini-incoming {
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-main);
            border-bottom-left-radius: 3px;
        }

        .mini-outgoing {
            align-self: flex-end;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.35), rgba(168, 85, 247, 0.35));
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: #ffffff;
            border-bottom-right-radius: 3px;
        }

        .modal-vision-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            z-index: 10000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-vision-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 1.5rem;
            max-width: 560px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            box-sizing: border-box;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
            position: relative;
        }

        /* === МОБИЛЬНАЯ АДАПТАЦИЯ (КАРТОЧКИ ВМЕСТО ТАБЛИЦЫ) === */
        @@media (max-width: 768px) {
            .ai-chats-container {
                margin: 4.5rem auto 2rem;
                padding: 0 0.75rem;
            }

            .header-card {
                padding: 1.15rem;
            }

            .header-actions {
                width: 100%;
            }

            .header-btn {
                flex: 1 1 auto;
            }

            .kpi-row {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }

            .kpi-box {
                padding: 0.8rem 0.9rem;
            }

            .kpi-num {
                font-size: 1.2rem;
            }

            .customers-table-card {
                background: transparent;
                border: none;
                box-shadow: none;
                overflow: visible;
            }

            .table-responsive {
                overflow-x: visible;
            }

            .table-chats, .table-chats tbody {
                display: block;
                width: 100%;
            }

                .table-chats thead {
                    display: none;
                }

            .table-row-customer {
                display: block;
                background: var(--card-bg, #1e293b);
                border: 1px solid var(--glass-border);
                border-radius: 16px;
                margin-bottom: 10px;
                padding: 12px 14px;
            }

                .table-row-customer.expanded {
                    margin-bottom: 0;
                    border-bottom-left-radius: 0;
                    border-bottom-right-radius: 0;
                    border-bottom-color: rgba(16, 185, 129, 0.3);
                }

                .table-row-customer td {
                    display: block;
                    width: 100%;
                    padding: 6px 0;
                    border-bottom: none;
                    box-sizing: border-box;
                }

            .badges-stack {
                flex-direction: row;
                flex-wrap: wrap;
                gap: 6px;
            }

            .badge-responses {
                white-space: normal;
            }

            .actions-cell-wrap {
                padding-top: 6px;
                border-top: 1px solid rgba(255, 255, 255, 0.06);
            }

            .act-btn {
                flex: 1 1 auto;
                text-align: center;
                padding: 8px 10px;
            }

            .row-details-chat.is-open {
                display: block;
                width: 100%;
                background: var(--card-bg, #1e293b);
                border: 1px solid rgba(16, 185, 129, 0.3);
                border-top: none;
                border-bottom-left-radius: 16px;
                border-bottom-right-radius: 16px;
                margin-bottom: 12px;
            }

            .row-details-chat td {
                display: block;
                width: 100%;
                padding: 0 !important;
                border: none;
            }

            .chat-preview-box {
                padding: 0.85rem;
                max-height: 340px;
            }

            .mini-bubble {
                max-width: 90%;
            }
        }
    </style>
}

@section NavbarActions {
    <div style="display:flex; align-items:center; gap:8px;">
        <a href="/instagram?botId=@currentBotId" style="color:var(--text-secondary); text-decoration:none; font-size:0.88rem; font-weight:600;">
            ← Настройки Instagram
        </a>
    </div>
}

<div class="ai-chats-container">

    <!-- ШАПКА -->
    <div class="header-card">
        <div>
            <h2 style="margin: 0; font-size: 1.35rem; font-weight: 800; color: var(--text-main);">
                🤖 Анализ AI Общения
            </h2>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">
                Бот: <strong style="color: #e1306c;">&#64;@botUsername</strong> • История контактов, досье и токены
            </div>
        </div>

        <div class="header-actions">
            <button type="button" onclick="document.getElementById('modelsStatsModal').style.display='flex'"
                    class="header-btn"
                    style="background:rgba(99,102,241,0.18); border:1px solid rgba(99,102,241,0.4); color:#a5b4fc;">
                📊 Расход по моделям
            </button>

            <a href="/inbox?profileId=@currentProfileId&network=INSTAGRAM"
               class="header-btn btn-autoposting">
                💬 Открыть Инбокс
            </a>
        </div>
    </div>

    <!-- БАННЕР РЕЖИМА ФИЛЬТРАЦИИ -->
    <div class="filter-banner" style="border: 1px solid @(filterMode == 1 ? "rgba(245,158,11,0.5)" : "var(--glass-border)");">
        <div style="font-size: 0.85rem; color: var(--text-main);">
            @if (filterMode == 1)
            {
                <span style="color:#fbbf24; font-weight:700;">🧪 Включён ТЕСТ-РЕЖИМ (Белый список):</span>
                <span style="color:var(--text-secondary); font-family:monospace; margin-left:6px; word-break:break-word;">@(string.IsNullOrWhiteSpace(whitelistStr) ? "пока никого не выбрано" : whitelistStr)</span>
            }
            else
            {
                <span style="color:#10b981; font-weight:700;">🌍 Рабочий режим:</span>
                <span style="color:var(--text-secondary); margin-left:6px;">ИИ отвечает всем, кроме тех, у кого включён «🚫 Игнор».</span>
            }
        </div>
        <button type="button" onclick="setFilterMode(@(filterMode == 1 ? 0 : 1))"
                style="padding:7px 12px; border-radius:10px; border:1px solid var(--glass-border); cursor:pointer; font-weight:700; font-size:0.8rem; background:@(filterMode == 1 ? "#10b981" : "rgba(245,158,11,0.18)"); color:@(filterMode == 1 ? "#fff" : "#fbbf24");">
            @(filterMode == 1 ? "🌍 Вернуть рабочий режим (Всем)" : "🧪 Включить Тест-режим (Только белый список)")
        </button>
    </div>

    <!-- KPI РЯД -->
    <div class="kpi-row">
        <div class="kpi-box">
            <span class="kpi-num" style="color: #10b981;">@totalCustomers</span>
            <span class="kpi-label">Собеседников</span>
        </div>
        <div class="kpi-box">
            <span class="kpi-num" style="color: #38bdf8;">@activeToday</span>
            <span class="kpi-label">Общались сегодня</span>
        </div>
        <div class="kpi-box">
            <span class="kpi-num" style="color: #a855f7;">@totalResponses</span>
            <span class="kpi-label">Всего ответов ИИ</span>
        </div>
        <div class="kpi-box">
            <span class="kpi-num" style="color: #ec4899;">@withVision</span>
            <span class="kpi-label">Досье сохранено</span>
        </div>
        <div class="kpi-box">
            <span class="kpi-num" style="color: #f59e0b;">@totalMediaSent</span>
            <span class="kpi-label">Медиа отправлено</span>
        </div>
        <div class="kpi-box">
            <span class="kpi-num" style="color: #fbbf24;">@botTotalTokens.ToString("N0")</span>
            <span class="kpi-label">Токенов (сег: @botTodayTokens.ToString("N0") • ~$@botEstimatedUsd.ToString("F4"))</span>
        </div>
    </div>

    <!-- ПОИСК ПО ИМЕНИ/ID -->
    <div class="search-box">
        <input type="text" id="searchInput" class="search-input" placeholder="🔍 Поиск по никнейму или ID пользователя..." oninput="onSearchTable(this.value)">
    </div>

    <!-- ТАБЛИЦА / КАРТОЧКИ НА МОБИЛЬНОМ -->
    <div class="customers-table-card">
        <div class="table-responsive">
            <table class="table-chats">
                <thead>
                    <tr>
                        <th>Клиент</th>
                        <th>Статистика и токены</th>
                        <th>Последний диалог</th>
                        <th>Досье</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody id="customersTableBody">
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                                📭 Пока не было диалогов. Как только бот ответит первому человеку в Direct, он появится здесь!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            string lastDateText = c.LastRespondedAt.HasValue
                            ? c.LastRespondedAt.Value.ToString("dd.MM.yyyy HH:mm")
                            : "Ещё не ответил";

                            string displayName = !string.IsNullOrEmpty(c.Username) ? ("@" + c.Username) : "Instagram User";
                            string avatarInitial = string.IsNullOrEmpty(c.Username) ? "U" : c.Username.Substring(0, 1).ToUpper();

                            string dossierText = !string.IsNullOrWhiteSpace(c.AiContext)
                            ? c.AiContext
                            : (!string.IsNullOrWhiteSpace(c.AppearanceDescription)
                            ? c.AppearanceDescription
                            : $"ИНФОРМАЦИЯ О СОБЕСЕДНИКЕ:\nНикнейм: @{c.Username ?? "не указан"}\nID в Instagram: {c.SenderId}\nОтветов бота: {c.TotalResponsesCount}\nДата первого контакта: {c.CreatedAt:dd.MM.yyyy HH:mm}\nВнешность: Фото-анализ выключен в настройках.");

                            <tr class="table-row-customer" id="row_@c.CustomerId" onclick="toggleChatHistory(@c.CustomerId, '@c.SenderId', this)">
                                <!-- 1. КЛИЕНТ -->
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        @if (!string.IsNullOrEmpty(c.ProfilePictureUrl))
                                        {
                                            <img src="@c.ProfilePictureUrl"
                                                 class="cust-avatar"
                                                 alt="@avatarInitial"
                                                 referrerpolicy="no-referrer"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">
                                            <div class="cust-avatar" style="display:none;">@avatarInitial</div>
                                        }
                                        else
                                        {
                                            <div class="cust-avatar">@avatarInitial</div>
                                        }
                                        <div style="display:flex; flex-direction:column; min-width:0;">
                                            <span style="font-weight:700; color:var(--text-main); word-break:break-word;" class="cust-name">
                                                @displayName
                                            </span>
                                            <span style="font-size:0.73rem; color:var(--text-secondary); font-family:monospace;">
                                                ID: @c.SenderId
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- 2. СТАТИСТИКА И ТОКЕНЫ -->
                                <td>
                                    <div class="badges-stack">
                                        <span class="badge-responses badge-today" title="Ответов за последние 24 часа">
                                            ⚡ Сегодня: @c.TodayResponsesCount
                                        </span>
                                        <span class="badge-responses" title="Всего ответов за всё время">
                                            Всего: @c.TotalResponsesCount
                                        </span>
                                        <span class="badge-responses" id="mediaBadge_@c.CustomerId"
                                              style="background: rgba(245, 158, 11, 0.14); color: #fbbf24; border-color: rgba(245, 158, 11, 0.35);"
                                              title="Отправлено фото/видео из Медиатеки этому клиенту">
                                            🖼️ Медиа: <span class="media-count-val">@c.SentMediaCount</span>/@totalGallery
                                        </span>
                                        <span class="badge-responses"
                                              style="background: rgba(56, 189, 248, 0.12); color: #38bdf8; border-color: rgba(56, 189, 248, 0.3);"
                                              title="Входных: @c.TotalInputTokens.ToString("N0") | Выходных: @c.TotalOutputTokens.ToString("N0")">
                                            🪙 @c.TotalTokensSpent.ToString("N0") (сег: @c.TodayTokensSpent.ToString("N0")) • ~$@c.EstimatedCostUsd.ToString("F4")
                                        </span>
                                    </div>
                                </td>

                                <!-- 3. ПОСЛЕДНИЙ ДИАЛОГ -->
                                <td>
                                    <div style="font-size:0.84rem; font-weight:600; color:var(--text-main); white-space:nowrap;">
                                        @lastDateText
                                    </div>
                                    <div style="font-size:0.72rem; color:var(--text-secondary); white-space:nowrap;">
                                        Создан: @c.CreatedAt.ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <!-- 4. ДОСЬЕ ИИ -->
                                <td>
                                    <button type="button" class="btn-view-vision" id="dossierBtn_@c.CustomerId"
                                            data-username="@(c.Username ?? "Клиент")"
                                            data-description="@dossierText"
                                            onclick="openVisionModalFromBtn(this, event)">
                                        <span>🧠</span> Досье ИИ
                                    </button>
                                </td>

                                <!-- 5. ДЕЙСТВИЯ + СТРЕЛКА -->
                                <td>
                                    <div class="actions-cell-wrap">
                                        <button type="button"
                                                class="act-btn"
                                                onclick="toggleIgnore(@c.CustomerId, this, event)"
                                                title="Игнорировать этого пользователя (в Direct и Комментариях)"
                                                style="border:1px solid @(c.IsIgnored ? "rgba(239,68,68,0.5)" : "var(--glass-border)"); background:@(c.IsIgnored ? "rgba(239,68,68,0.2)" : "rgba(255,255,255,0.04)"); color:@(c.IsIgnored ? "#f87171" : "var(--text-secondary)");">
                                            @(c.IsIgnored ? "🚫 В игноре" : "🚫 Игнор")
                                        </button>

                                        <button type="button"
                                                class="act-btn"
                                                onclick="toggleWhitelist(@c.CustomerId, this, event)"
                                                title="Добавить/убрать из белого списка для Тест-режима"
                                                style="border:1px solid @(c.IsWhitelisted ? "rgba(245,158,11,0.55)" : "var(--glass-border)"); background:@(c.IsWhitelisted ? "rgba(245,158,11,0.2)" : "rgba(255,255,255,0.04)"); color:@(c.IsWhitelisted ? "#fbbf24" : "var(--text-secondary)");">
                                            @(c.IsWhitelisted ? "🧪 В тесте" : "🧪 В тест")
                                        </button>

                                        <button type="button"
                                                class="act-btn"
                                                id="resetMediaBtn_@c.CustomerId"
                                                onclick="resetSentMedia(@c.CustomerId, this, event)"
                                                title="Сбросить счётчик отправленных фото/видео и кулдаун"
                                                style="border:1px solid rgba(56,189,248,0.4); background:rgba(56,189,248,0.12); color:#38bdf8; @(c.SentMediaCount == 0 ? "opacity:0.45;" : "")">
                                            🔄 Сброс фото
                                        </button>

                                        <span class="arrow-indicator">▼</span>
                                    </div>
                                </td>
                            </tr>

                            <tr class="row-details-chat" id="details_@c.CustomerId">
                                <td colspan="5" style="padding: 0;">
                                    <div class="chat-preview-box" id="chatBox_@c.CustomerId">
                                        <div style="color:var(--text-secondary); font-size:0.8rem; text-align:center; padding:10px;">
                                            ⏳ Загрузка сообщений из Инбокса...
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- МОДАЛЬНОЕ ОКНО ДОСЬЕ ИИ -->
<div id="visionModal" class="modal-vision-overlay" onclick="closeVisionModal()">
    <div class="modal-vision-card" onclick="event.stopPropagation()">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; border-bottom:1px solid var(--glass-border); padding-bottom:8px;">
            <h3 id="visionModalTitle" style="margin:0; font-size:1.1rem; color:#10b981; font-weight:800;">🧠 Досье клиента в памяти ИИ</h3>
            <button type="button" onclick="closeVisionModal()" style="background:none; border:none; color:var(--text-secondary); font-size:1.4rem; cursor:pointer;">&times;</button>
        </div>
        <div id="visionModalText" style="font-size:0.85rem; line-height:1.6; color:var(--text-main); background:rgba(0,0,0,0.3); padding:14px; border-radius:12px; border:1px solid var(--glass-border); white-space:pre-wrap; word-break:break-word; font-family:monospace;"></div>
    </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО СВОДКИ ПО МОДЕЛЯМ -->
<div id="modelsStatsModal" class="modal-vision-overlay" onclick="this.style.display='none'">
    <div class="modal-vision-card" style="max-width: 650px;" onclick="event.stopPropagation()">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; border-bottom:1px solid var(--glass-border); padding-bottom:8px;">
            <h3 style="margin:0; font-size:1.1rem; color:#a5b4fc; font-weight:800;">📊 Расход токенов по моделям и этапам</h3>
            <button type="button" onclick="document.getElementById('modelsStatsModal').style.display='none'" style="background:none; border:none; color:var(--text-secondary); font-size:1.4rem; cursor:pointer;">&times;</button>
        </div>
        @if (modelStats.Count == 0)
        {
            <div style="color:var(--text-secondary); padding:1rem; text-align:center;">Пока нет записей с расходом токенов.</div>
        }
        else
        {
            <div style="max-height:360px; overflow:auto;">
                <table style="width:100%; border-collapse:collapse; font-size:0.82rem; color:var(--text-main);">
                    <thead>
                        <tr style="border-bottom:1px solid var(--glass-border); color:var(--text-secondary); text-align:left;">
                            <th style="padding:8px;">Модель (этап)</th>
                            <th style="padding:8px;">Вызовов</th>
                            <th style="padding:8px;">In / Out</th>
                            <th style="padding:8px;">~$</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ms in modelStats)
                        {
                            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
                                <td style="padding:8px; font-family:monospace; word-break:break-word;">@ms.Label</td>
                                <td style="padding:8px;">@ms.CallsCount</td>
                                <td style="padding:8px; white-space:nowrap;">@ms.InputTokens.ToString("N0") / @ms.OutputTokens.ToString("N0")</td>
                                <td style="padding:8px; color:#10b981; font-weight:700; white-space:nowrap;">$@ms.EstimatedUsd.ToString("F4")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const botId = Number('@currentBotId') || 0;
        const profileId = Number('@currentProfileId') || 0;
        const loadedChatsCache = new Set();

        async function toggleChatHistory(customerId, senderId, rowElement) {
            const detailsRow = document.getElementById(`details_${customerId}`);
            const arrow = rowElement.querySelector('.arrow-indicator');
            const chatBox = document.getElementById(`chatBox_${customerId}`);

            const isCurrentlyOpen = detailsRow.classList.contains('is-open');

            if (isCurrentlyOpen) {
                detailsRow.classList.remove('is-open');
                rowElement.classList.remove('expanded');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
                return;
            }

            detailsRow.classList.add('is-open');
            rowElement.classList.add('expanded');
            if (arrow) arrow.style.transform = 'rotate(180deg)';

            if (loadedChatsCache.has(customerId)) return;

            try {
                const res = await fetch(`/instagram/ai-chats/messages?botId=${botId}&senderId=${encodeURIComponent(senderId)}`);
                const data = await res.json();

                chatBox.innerHTML = '';

                if (data && data.messages && data.messages.length > 0) {
                    data.messages.forEach(m => {
                        const bubble = document.createElement('div');
                        bubble.className = `mini-bubble ${m.isIncoming ? 'mini-incoming' : 'mini-outgoing'}`;
                        const prefix = m.isIncoming ? '👤 Клиент' : (m.isSentByBot ? '🤖 ИИ-Бот' : '👤 Вы');

                        let tokenBadgeHtml = '';
                        if (!m.isIncoming && m.isSentByBot && m.tokensSpent > 0) {
                            let breakdownTip = `Input: ${m.inputTokens} | Output: ${m.outputTokens}`;
                            if (m.usageDetailsJson) {
                                try {
                                    const steps = JSON.parse(m.usageDetailsJson);
                                    breakdownTip = steps.map(s => `${s.step} [${s.model || '?'}]: ${s.input} in / ${s.output} out`).join('\n');
                                } catch {}
                            }
                            const modelLabel = m.modelName ? ` • ${escapeHtml(m.modelName)}` : '';
                            tokenBadgeHtml = `
                                <div title="${escapeHtml(breakdownTip)}"
                                     style="margin-top:6px; padding-top:4px; border-top:1px solid rgba(255,255,255,0.12); font-size:0.7rem; color:#fde68a; opacity:0.9; cursor:help;">
                                    🪙 ${m.tokensSpent.toLocaleString()} ток. (${m.inputTokens} in / ${m.outputTokens} out)${modelLabel}
                                </div>`;
                        }

                        bubble.innerHTML = `
                            <div style="font-size:0.7rem; opacity:0.65; margin-bottom:2px;">${prefix} • ${m.time}</div>
                            <div>${escapeHtml(m.text || '[Медиа]')}</div>
                            ${tokenBadgeHtml}
                        `;
                        chatBox.appendChild(bubble);
                    });

                    const footerLink = document.createElement('div');
                    footerLink.style.cssText = 'text-align:center; padding-top:6px;';
                    footerLink.innerHTML = `<a href="/inbox?profileId=${profileId}&network=INSTAGRAM" target="_blank" style="color:#10b981; font-size:0.78rem; text-decoration:none; font-weight:700;">Перейти к полному диалогу в Инбоксе ↗️</a>`;
                    chatBox.appendChild(footerLink);

                    loadedChatsCache.add(customerId);
                } else {
                    chatBox.innerHTML = `
                        <div style="color:var(--text-secondary); font-size:0.8rem; text-align:center; padding:12px;">
                            Диалог чист (сообщения были архивированы или ещё не сохранены в Инбокс).
                        </div>
                    `;
                }
            } catch (err) {
                chatBox.innerHTML = '<div style="color:#ef4444; font-size:0.8rem; text-align:center;">Ошибка загрузки сообщений</div>';
            }
        }

        function openVisionModalFromBtn(btn, e) {
            if (e) e.stopPropagation();
            const username = btn.getAttribute('data-username') || 'Клиент';
            const description = btn.getAttribute('data-description') || 'Досье отсутствует';
            showVisionModal(username, description);
        }

        function showVisionModal(username, description) {
            document.getElementById('visionModalTitle').textContent = "🧠 Досье клиента @@" + username;
            document.getElementById('visionModalText').textContent = description;
            document.getElementById('visionModal').style.display = 'flex';
        }

        function closeVisionModal() {
            document.getElementById('visionModal').style.display = 'none';
        }

        function onSearchTable(query) {
            query = query.toLowerCase().trim();
            const rows = document.querySelectorAll('.table-row-customer');
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                const match = text.includes(query);
                r.style.display = match ? '' : 'none';
                const detailsId = r.id.replace('row_', 'details_');
                const details = document.getElementById(detailsId);
                if (details && !match) {
                    details.classList.remove('is-open');
                    r.classList.remove('expanded');
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        async function toggleIgnore(customerId, btn, e) {
            if (e) e.stopPropagation();
            const res = await fetch('/instagram/ai-chats/toggle-ignore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, customerId })
            });
            const data = await res.json();
            if (data.success) {
                btn.textContent = data.isIgnored ? '🚫 В игноре' : '🚫 Игнор';
                btn.style.background = data.isIgnored ? 'rgba(239,68,68,0.2)' : 'rgba(255,255,255,0.04)';
                btn.style.borderColor = data.isIgnored ? 'rgba(239,68,68,0.5)' : 'var(--glass-border)';
                btn.style.color = data.isIgnored ? '#f87171' : 'var(--text-secondary)';
            }
        }

        async function toggleWhitelist(customerId, btn, e) {
            if (e) e.stopPropagation();
            const res = await fetch('/instagram/ai-chats/toggle-whitelist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, customerId })
            });
            const data = await res.json();
            if (data.success) {
                btn.textContent = data.isWhitelisted ? '🧪 В тесте' : '🧪 В тест';
                btn.style.background = data.isWhitelisted ? 'rgba(245,158,11,0.2)' : 'rgba(255,255,255,0.04)';
                btn.style.borderColor = data.isWhitelisted ? 'rgba(245,158,11,0.55)' : 'var(--glass-border)';
                btn.style.color = data.isWhitelisted ? '#fbbf24' : 'var(--text-secondary)';
            }
        }

        async function setFilterMode(mode) {
            const res = await fetch('/instagram/ai-chats/set-filter-mode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, mode })
            });
            const data = await res.json();
            if (data.success) location.reload();
        }

        async function resetSentMedia(customerId, btn, e) {
            if (e) e.stopPropagation();
            if (!confirm('Сбросить историю отправленных фото/видео и кулдаун для этого клиента?')) return;

            const res = await fetch('/instagram/ai-chats/reset-sent-media', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, customerId })
            });

            const data = await res.json();
            if (data.success) {
                const badge = document.querySelector(`#mediaBadge_${customerId} .media-count-val`);
                if (badge) badge.textContent = '0';
                btn.style.opacity = '0.45';

                const dossierBtn = document.getElementById(`dossierBtn_${customerId}`);
                if (dossierBtn) {
                    dossierBtn.setAttribute('data-description', data.aiContext || 'Досье отсутствует');
                }
            }
        }
    </script>
}