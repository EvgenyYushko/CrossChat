@model CrossChat.Data.Entities.TelegramSettings
@{
    bool isConnected = !string.IsNullOrEmpty(Model?.BotToken);
}

@section Styles {
    <style>
        /* Уникальные стили для страницы Telegram Bot */
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        h1 {
            color: var(--text-main);
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            text-align: center;
        }

        /* HEADER ПОДКЛЮЧЕННОГО */
        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #2AABEE; /* Фирменный цвет Telegram */
            background: #2AABEE;
            color: white;
            box-shadow: 0 4px 12px rgba(42, 171, 238, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 1rem;
            transition: border-color 0.3s ease;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }

        /* ФОРМА */
        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* СТИЛИЗАЦИЯ ТЕКСТОВЫХ ПОЛЕЙ ВВОДА */
        .text-input {
            width: 100%;
            box-sizing: border-box; /* Исключает вылет полей за рамки */
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            margin-bottom: 1rem;
            font-family: inherit;
        }

            .text-input:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            resize: vertical;
            min-height: 150px;
            font-family: inherit;
            margin-bottom: 1rem;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        /* Группа верхних кнопок управления */
        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            box-sizing: border-box;
        }

        /* Стилизация кнопки консоли бота (стеклянный стиль) */
        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            margin: 0 !important;
        }

            .btn-console:hover {
                background: rgba(15, 23, 42, 0.7) !important;
                border-color: var(--text-secondary) !important;
                transform: translateY(-1px);
            }

        /* Стилизация кнопки автопостинга (Индиго-градиент) */
        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
            margin: 0 !important;
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
                transform: translateY(-1px);
            }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1.5rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        /* Переключатель */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            margin-bottom: 1.5rem;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        /* СТАТУСЫ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* ИНСТРУКЦИЯ */
        .instruction-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 0.95rem;
            cursor: pointer;
            margin-bottom: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            width: 100%;
            justify-content: center;
        }

        .instruction-content {
            display: none;
            text-align: left;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
        }

        /* МОБИЛЬНАЯ АДАПТАЦИЯ */
        @@media (max-width: 600px) {
            .container

        {
            margin-top: 5rem;
        }

        .card {
            padding: 1.5rem;
        }

        /* Складываем кнопки управления в один ряд вертикально на мобилках */
        .action-buttons-group {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        }

        /* --- СВЕТЛАЯ ТЕМА ДЛЯ КНОПОК --- */
        [data-theme="light"] .btn-console {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

            [data-theme="light"] .btn-console:hover {
                background: #f1f5f9 !important;
                border-color: #94a3b8 !important;
            }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Назад в профиль</a>
}

<div class="container">
    <div class="card">
        <h1>Telegram Бот</h1>

        @if (isConnected)
        {
            /* === РЕЖИМ НАСТРОЕК === */
            <div id="toast" style="display:none; background:#10b981; color:white; padding:10px; border-radius:8px; margin-bottom:1rem; text-align: center;">
                Настройки сохранены!
            </div>

            <div class="connected-header">
                <!-- Круглая аватарка (синяя с первой буквой ника, как на дашборде) -->
                <div class="big-avatar">
                    @(Model.BotUsername?.Length > 0 ? Model.BotUsername.Substring(0, 1).ToUpper() : "B")
                </div>
                <div class="username">@@@(Model.BotUsername ?? "telegram_bot")</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот работает (API)</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Отключен</span>
                    }
                </div>
            </div>

            <!-- СИММЕТРИЧНАЯ ГРУППА КНОПОК УПРАВЛЕНИЯ -->
            <div class="action-buttons-group">
                <a href="/auth/console?provider=telegram&botId=@Model.UserId&username=@Model.BotUsername" class="btn btn-console">
                    💻 Консоль бота
                </a>
                <a href="/planner?profileId=@Model.ProfileId&network=TelegramPublic&botId=@Model.UserId" class="btn btn-autoposting">
                    📅 Автопостинг
                </a>
            </div>

            <form action="/telegram/update" method="post" class="form-section">
                <div class="switch-container">
                    <label style="margin:0;">Бот активен</label>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="form-group">
                    <label>Системный промпт (Инструкция)</label>
                    <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                </div>

                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 20px;">Сохранить изменения</button>
            </form>

            <form action="/telegram/disconnect" method="post" onsubmit="return confirm('Удалить бота?');" style="margin-top: 1rem;">
                <button type="submit" class="btn btn-danger">Удалить бота</button>
            </form>
        }
        else
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ === */
            <div style="text-align: center;">
                <button class="instruction-btn" onclick="toggleInstruction()">📖 Как подготовить аккаунт?</button>

                <div id="instructionBlock" class="instruction-content">
                    <p class="step-title">1. Перейдите к BotFather</p>
                    <p style="margin-bottom: 15px; font-size: 0.95rem; line-height: 1.4;">Напишите официальному отцу ботов <a href="https://t.me/BotFather" target="_blank" style="color: var(--accent-color);">@@BotFather</a>.</p>

                    <p class="step-title">2. Создайте бота</p>
                    <p style="margin-bottom: 15px; font-size: 0.95rem; line-height: 1.4;">Отправьте команду <code>/newbot</code> и следуйте шагам.</p>

                    <p class="step-title">3. Подключите токен</p>
                    <p style="font-size: 0.95rem; line-height: 1.4;">Скопируйте выданный API Token и вставьте его в поле ниже.</p>
                </div>

                <form action="/telegram/connect" method="post" style="margin-top:2rem; text-align: left;">
                    <div class="form-group">
                        <label>API Токен бота</label>
                        <input type="text" name="token" class="text-input" placeholder="Введите API Токен..." required style="margin:0;">
                    </div>
                    <button type="submit" class="btn btn-primary" style="margin-top: 15px;">Подключить</button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleInstruction() {
            var block = document.getElementById('instructionBlock');
            block.style.display = (block.style.display === 'block') ? 'none' : 'block';
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('saved')) {
            const toast = document.getElementById('toast');
            if (toast) {
                toast.style.display = 'block';
                setTimeout(() => toast.style.display = 'none', 3000);
            }
        }
    </script>
}