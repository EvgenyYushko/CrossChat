@model CrossChat.Data.Entities.TelegramSettings
@{
    bool isConnected = !string.IsNullOrEmpty(Model?.BotToken);
}

@section Styles {
    <style>
        :root {
            --bg-color: #050505;
            --card-bg: #121212;
            --text-main: #ffffff;
            --text-secondary: #a1a1aa;
            --accent-color: #6366f1;
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        [data-theme="light"] {
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-secondary: #64748b;
            --glass-border: rgba(0, 0, 0, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            transition: background-color 0.3s ease;
            min-height: 100vh;
        }

        .container {
            max-width: 800px; /* Было 800px, проверь что это применилось */
            width: 100%; /* Занимаем всю доступную ширину до 800px */
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        h1 {
            color: var(--text-main);
            margin-bottom: 2rem;
            font-size: 1.8rem;
        }

        /* Переключатель */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(128,128,128,0.1);
            padding: 1.2rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
        }

        /* Текстовое поле */
        textarea {
            width: 100%;
            min-height: 150px;
            background: var(--bg-color);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            resize: vertical;
            margin-bottom: 1rem;
            box-sizing: border-box;
        }

        /* Кнопки (Широкие и красивые) */
        .btn {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.2s;
            margin-bottom: 10px;
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.2);
            }

        /* Чекбокс-слайдер */
        .switch {
            position: relative;
            display: inline-block;
            width: 45px;
            height: 24px;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 24px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(21px);
            }
    </style>
}
@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Назад в профиль</a>
}

<div class="container">
    <div class="card">
        <h1>Telegram Бот</h1>

        @if (isConnected)
        {
            <div id="toast" style="display:none; background:#10b981; color:white; padding:10px; border-radius:8px; margin-bottom:1rem;">Настройки сохранены!</div>

            <form action="/telegram/update" method="post">
                <div class="switch-container">
                    <label style="margin:0;">Бот активен</label>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="form-group" style="text-align:left;">
                    <label>Системный промпт</label>
                    <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                </div>
                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            </form>

            <form action="/telegram/disconnect" method="post" onsubmit="return confirm('Удалить бота?');">
                <button type="submit" class="btn btn-danger">Удалить бота</button>
            </form>
        }
        else
        {
            <button class="instruction-btn" onclick="toggleInstruction()">📖 Как подготовить аккаунт?</button>
            <div id="instructionBlock" class="instruction-content">
                <p>1. Напишите <a href="https://t.me/BotFather">@@BotFather</a></p>
                <p>2. Отправьте <code>/newbot</code></p>
                <p>3. Получите API Token и вставьте его ниже.</p>
            </div>

            <form action="/telegram/connect" method="post" style="margin-top:2rem;">
                <input type="text" name="token" class="text-input" placeholder="Введите API Токен..." required>
                <button type="submit" class="btn btn-primary">Подключить</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleInstruction() {
            var block = document.getElementById('instructionBlock');
            block.style.display = (block.style.display === 'block') ? 'none' : 'block';
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('saved')) {
            const toast = document.getElementById('toast');
            toast.style.display = 'block';
            setTimeout(() => toast.style.display = 'none', 3000);
        }
    </script>
}
    
}