<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CrossChat</title>

    <!-- Шрифты -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Иконки -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.png">
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png">

    <!-- ГЛОБАЛЬНЫЕ СТИЛИ (Общие для всех страниц) -->
    <style>
        :root {
            --bg-color: #050505;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-main: #ffffff;
            --text-secondary: #a1a1aa;
            --accent-color: #6366f1;
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* NAVBAR */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            background: rgba(5, 5, 5, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--glass-border);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .logo-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
        }

        .logo-text {
            font-weight: 700;
            color: white;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
        }

        /* FOOTER */
        .footer {
            width: 100%; /* Занимаем всю ширину */
            box-sizing: border-box; /* Учитываем отступы */

            border-top: 1px solid var(--glass-border);
            padding: 2rem;
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: auto;
            background: #020202;
        }

            .footer a {
                color: var(--text-secondary);
                text-decoration: none;
                margin: 0 10px;
                transition: color 0.2s;
            }

                .footer a:hover {
                    color: white;
                }
    </style>

    <!-- Место для уникальных стилей страницы -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ОБЩАЯ ШАПКА -->
    <nav class="navbar">
        <a href="/" class="logo-container">
            <img src="/images/favicon.png" alt="Logo" class="logo-img">
            <span class="logo-text">CrossChat</span>
        </a>

        <!-- Сюда можно будет потом вставить меню профиля -->
        @await RenderSectionAsync("NavbarActions", required: false)
    </nav>

    <!-- СЮДА ВСТАВЛЯЕТСЯ КОНТЕНТ СТРАНИЦЫ -->
    @RenderBody()

    <!-- ОБЩИЙ ФУТЕР -->
    <footer class="footer">
        <p>&copy; @DateTime.Now.Year CrossChat Inc.</p>
        <p style="margin-top: 10px; opacity: 0.6; font-size: 0.9rem;">
            <a href="/">Главная</a> •
            <a href="/privacy">Политика конфиденциальности</a>
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>