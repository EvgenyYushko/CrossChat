@model CrossChat.Data.Entities.TelegramChannelSettings
@{
    ViewData["Title"] = "Управление Telegram Каналами";
    bool isConnected = Model != null;
    bool isTgLinked = ViewBag.IsTgLinked ?? false;
}

@section Styles {
    <style>
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
        }

        h1 {
            color: var(--text-main);
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            text-align: center;
        }

        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #2AABEE;
            background: #2AABEE;
            color: white;
            box-shadow: 0 4px 12px rgba(42, 171, 238, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            resize: vertical;
            min-height: 120px;
            font-family: inherit;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
        }

        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
        }

        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

        .btn-tg {
            background: #2AABEE !important;
            color: white !important;
            box-shadow: 0 4px 12px rgba(42, 171, 238, 0.3);
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1.5rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

        /* Инструкция */
        .instruction-box {
            text-align: left;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 1.75rem;
            margin-bottom: 2rem;
            border: 1px solid var(--glass-border);
        }

        .step-title {
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            margin-bottom: 1.5rem;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        @@media (max-width: 600px) {
            .container

        {
            margin-top: 5rem;
        }

        .card {
            padding: 1.5rem;
        }

        .action-buttons-group {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Назад в профиль</a>
}

<div class="container">
    <div class="card">
        <h1>Telegram Канал</h1>

        @if (isConnected)
        {
            /* === РЕЖИМ НАСТРОЕК КАНАЛА === */
            <div class="connected-header">
                <div class="big-avatar">
                    📢
                </div>
                <div class="username">@Model.ChannelTitle</div>
                @if (!string.IsNullOrEmpty(Model.ChannelUsername))
                {
                    <div style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 2px;">@@@Model.ChannelUsername</div>
                }

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Подключен</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ На паузе</span>
                    }
                </div>
            </div>

            <!-- ГРУППА КНОПОК УПРАВЛЕНИЯ -->
            <div class="action-buttons-group">
                <a href="/auth/console?provider=telegram-channel&botId=@Model.Id&username=@Model.ChannelTitle" class="btn btn-console">
                    💻 Консоль канала
                </a>
                <a href="/planner?profileId=@Model.ProfileId&network=TelegramPublic&botId=@Model.Id" class="btn btn-autoposting">
                    📅 Автопостинг
                </a>
            </div>

            <form action="/telegram-channel/update" method="post" class="form-section">
                <input type="hidden" name="botId" value="@Model.Id" />

                <div class="switch-container">
                    <div>
                        <label style="margin:0; font-size: 1.1rem; color: white;">Активность</label>
                        <div style="font-size: 0.8rem; color: var(--text-secondary);">Автопостинг в канал разрешен</div>
                    </div>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="form-group">
                    <label>Системный промпт (Инструкция для нейросети)</label>
                    <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                </div>

                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 20px;">Сохранить настройки</button>
            </form>

            <form action="/telegram-channel/disconnect" method="post" onsubmit="return confirm('Отключить канал?');" style="margin-top: 1rem;">
                <input type="hidden" name="botId" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Удалить интеграцию</button>
            </form>
        }
        else
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ КАНАЛА === */
            <div style="text-align: center;">
                <p style="color:var(--text-secondary); margin-bottom:2rem;">Подключите ваш Telegram Канал для автопостинга за 2 простых шага.</p>

                <div class="instruction-box">
                    <div style="margin-bottom: 1.5rem;">
                        <div class="step-title">
                            <span>1️⃣</span> Привязка аккаунта Telegram
                        </div>
                        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 4px; line-height: 1.4;">
                            @if (isTgLinked)
                            {
                                <span style="color: #10b981; font-weight: 600;">✅ Ваш Telegram-аккаунт уже привязан к сайту.</span>
                            }
                            else
                            {
                                <span>Нажмите кнопку ниже, перейдите в бота и нажмите <strong>/start</strong>, чтобы связка сработало автоматически.</span>
                            }
                        </p>

                        @if (!isTgLinked)
                        {
                            <button type="button" onclick="generateTgLink()" class="btn btn-tg" style="margin-top: 12px;">
                                ✈️ Привязать мой Telegram
                            </button>
                        }
                    </div>

                    <div>
                        <div class="step-title">
                            <span>2️⃣</span> Добавление бота в Канал
                        </div>
                        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 4px; line-height: 1.4;">
                            Откройте ваш Канал в Telegram, перейдите в раздел <strong>Администраторы</strong> и добавьте системного бота <strong style="color: #2AABEE;">@@cros_hub_bot</strong> с правом «Публикация сообщений».
                        </p>
                    </div>
                </div>

                <p style="font-size: 0.85rem; color: var(--text-secondary);">
                    После выполнения этих шагов ваш канал автоматически появится в личном кабинете.
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function generateTgLink() {
            try {
                const response = await fetch('/telegram-channel/generate-link-code', { method: 'POST' });
                if (response.ok) {
                    const data = await response.json();
                    window.open(data.link, '_blank');
                } else {
                    alert('Не удалось сгенерировать ссылку привязки.');
                }
            } catch (e) {
                alert('Ошибка сети.');
            }
        }
    </script>
}