@model CrossChat.Data.Entities.BioPage
@using CrossChat.Infrastructure.Constants
@{
    Layout = null;

    // 🚀 БЕЗОПАСНАЯ ОБРАБОТКА ФОНА (защита от двойного url(...)):
    string rawBg = Model.CustomBackgroundValue ?? "linear-gradient(180deg, #0f172a 0%, #1e293b 100%)";
    string bgStyle;

    if (Model.ThemeType == "custom-image")
    {
        string cleanImg = rawBg.Trim();
        if (!cleanImg.StartsWith("url(", StringComparison.OrdinalIgnoreCase))
        {
            cleanImg = $"url('{cleanImg}')";
        }
        bgStyle = $"background-image: {cleanImg};";
    }
    else
    {
        bgStyle = $"background: {rawBg};";
    }

    string accentColor = string.IsNullOrWhiteSpace(Model.HighlightColor) ? "#38bdf8" : Model.HighlightColor;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@Model.Title — Официальные ссылки</title>

    <!-- ДИНАМИЧЕСКАЯ ФАВИКОНКА (АВАТАРКА В ВКЛАДКЕ) -->
    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
    {
        <link rel="icon" type="image/jpeg" href="@Model.AvatarUrl" />
        <link rel="apple-touch-icon" href="@Model.AvatarUrl" />
    }

    <!-- 🚀 ПОЛНЫЙ НАБОР OPEN GRAPH ТЕГОВ ДЛЯ META / INSTAGRAM -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@AppConstants.APP_URL/@Model.Slug" />
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@(Model.Bio ?? "Официальные контакты и социальные сети")" />
    <meta property="og:site_name" content="CrossChat" />

    @if (!string.IsNullOrEmpty(Model.AvatarUrl) && Model.AvatarUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        <meta property="og:image" content="@Model.AvatarUrl" />
    }
    else
    {
        <meta property="og:image" content="@AppConstants.APP_URL/images/favicon.png" />
    }

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            background-color: #0f172a;
            overscroll-behavior-y: none;
            -webkit-overflow-scrolling: touch;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            min-height: 100dvh;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 3rem 1.25rem 2rem;
            position: relative;
        }

        /* 🚀 ИСПРАВЛЕННЫЙ СЛОЙ ФОНА: z-index: 1 (ПОВЕРХ СИНЕГО ФОНА BODY!) */
        .page-bg {
            position: fixed;
            top: -15vh;
            left: -10vw;
            width: 120vw;
            height: 130vh;
            height: 130dvh;
            z-index: 1; /* <-- ВАЖНО: 1 вместо -1 */
            pointer-events: none;
            background-size: cover !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
            transform: translate3d(0, 0, 0);
            -webkit-transform: translate3d(0, 0, 0);
            will-change: transform;
        }

        /* 🚀 КОНТЕНТ ПОВЕРХ ФОТОГРАФИИ: z-index: 2 */
        .bio-wrapper {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 2; /* <-- ВАЖНО: поверх слоя фона */
            --highlight-color: @accentColor;
        }

        .avatar-wrap {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .avatar-img {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            background: #1e293b;
        }

        .verified-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background: #0085ff;
            color: #ffffff;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            border: 2px solid #0f172a;
        }

        .profile-title {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            text-align: center;
            letter-spacing: -0.02em;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }

        .profile-bio {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.85);
            text-align: center;
            margin-bottom: 2rem;
            line-height: 1.45;
            max-width: 380px;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
        }

        .links-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .link-card {
            width: 100%;
            padding: 16px 20px;
            border-radius: 18px;
            background: rgba(15, 23, 42, 0.55); /* Чуть более контрастное стекло поверх фото */
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff;
            text-decoration: none;
            font-size: 1.05rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.4);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

            .link-card:active {
                transform: scale(0.97);
            }

        .link-content-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* 🚀 КРУПНЫЕ ВЫРАЗИТЕЛЬНЫЕ ИКОНКИ БЕЗ РАМОК */
        .brand-icon-badge {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: none !important;
            border: none !important;
            box-shadow: none !important;
        }

            /* Увеличенные логотипы до 32px с глубоким 3D-объемом */
            .brand-icon-badge svg {
                width: 32px !important;
                height: 32px !important;
                filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5));
                transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }

        /* При нажатии на кнопку иконка слегка пружинит */
        .link-card:active .brand-icon-badge svg {
            transform: scale(0.9);
        }

        /* 🚀 СОЧНЫЙ НЕОН + ВЫПЯЧИВАНИЕ + ИМПУЛЬС В ЦВЕТ РАМКИ */
        .link-card.highlighted {
            background: rgba(15, 23, 42, 0.6) !important;
            border: 2px solid var(--highlight-color, #38bdf8) !important;
            position: relative;
            overflow: hidden;
            animation: pulseGlowHero 2.8s infinite ease-in-out;
            will-change: transform, box-shadow;
        }

            /* Бегущий глянцевый блик света */
            .link-card.highlighted::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -150%;
                width: 60%;
                height: 200%;
                background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.45), transparent );
                transform: rotate(25deg);
                animation: shineSweep 2.8s infinite ease-in-out;
                pointer-events: none;
                z-index: 1;
            }

        /* 🚀 АНИМАЦИЯ: ПЛАВНОЕ ДЫХАНИЕ-ВЫПЯЧИВАНИЕ + ЯРКАЯ ВСПЫШКА НЕОНА В ЦВЕТ ВЫБРАННОЙ РАМКИ */
        @@keyframes pulseGlowHero {
            0% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 0 10px var(--highlight-color, #38bdf8), 0 4px 15px rgba(0, 0, 0, 0.3);
            }
            /* Фаза 1: Увеличение и нарастание яркого сочного свечения */
            38% {
                transform: scale(1.035) rotate(0deg);
                box-shadow: 0 0 25px var(--highlight-color, #38bdf8), 0 0 48px var(--highlight-color, #38bdf8);
            }
            /* Фаза 2: Задорный микровстрях на пике увеличения */
            44% {
                transform: scale(1.035) rotate(-1.5deg);
                box-shadow: 0 0 28px var(--highlight-color, #38bdf8), 0 0 52px var(--highlight-color, #38bdf8);
            }

            50% {
                transform: scale(1.035) rotate(1.5deg);
                box-shadow: 0 0 28px var(--highlight-color, #38bdf8), 0 0 52px var(--highlight-color, #38bdf8);
            }

            56% {
                transform: scale(1.035) rotate(0deg);
                box-shadow: 0 0 25px var(--highlight-color, #38bdf8), 0 0 48px var(--highlight-color, #38bdf8);
            }
            /* Фаза 3: Плавный возврат в спокойное состояние */
            70% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 0 10px var(--highlight-color, #38bdf8), 0 4px 15px rgba(0, 0, 0, 0.3);
            }

            100% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 0 10px var(--highlight-color, #38bdf8), 0 4px 15px rgba(0, 0, 0, 0.3);
            }
        }

        @@keyframes shineSweep {
            0%, 25% {
                left: -150%;
            }

            65%, 100% {
                left: 200%;
            }
        }

        /* 2. ИМПУЛЬСНОЕ ПОКАЧИВАНИЕ И НЕОНОВОЕ ДЫХАНИЕ */
        @@keyframes heroAttention {
            0% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), 0 0 12px var(--highlight-color);
            }
            /* Фаза задорного толчка (Wobble) */
            6% {
                transform: scale(1.035) rotate(-1.5deg);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4), 0 0 28px var(--highlight-color);
            }

            12% {
                transform: scale(1.035) rotate(1.5deg);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4), 0 0 28px var(--highlight-color);
            }

            18% {
                transform: scale(1.025) rotate(-0.8deg);
            }

            24% {
                transform: scale(1.01) rotate(0deg);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3), 0 0 20px var(--highlight-color);
            }

            32% {
                transform: scale(1);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), 0 0 12px var(--highlight-color);
            }
            /* Пауза спокойного свечения до следующего цикла */
            100% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), 0 0 12px var(--highlight-color);
            }
        }

        /* Анимация луча света раз в 3.5 секунды */
        @@keyframes shineSweep {
            0%, 25% {
                left: -150%;
            }

            60%, 100% {
                left: 200%;
            }
        }

        .footer-brand {
            margin-top: auto;
            padding-top: 3rem;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
            transition: opacity 0.2s;
        }

        .footer-brand:hover {
            opacity: 1;
        }

        /* 🚀 ГОРИЗОНТАЛЬНЫЙ РЯД СОЦИАЛЬНЫХ ИКОНОК (DOCK) */
        .social-icons-dock {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 1.5rem;
            width: 100%;
        }

        .social-dock-btn {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .social-dock-btn:hover {
            transform: translateY(-3px) scale(1.08);
            border-color: rgba(255, 255, 255, 0.45);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
        }

        .social-dock-btn:active {
            transform: scale(0.92);
        }

        .social-dock-btn svg {
            width: 26px !important;
            height: 26px !important;
            filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.4));
        }
    </style>
</head>
<body>

    <!-- 🚀 ФОНОВЫЙ СЛОЙ С ПРЯМЫМ СТИЛЕМ (ТЕПЕРЬ ВИДЕН НА 100%) -->
    <div class="page-bg" style="@Html.Raw(bgStyle)"></div>

    <div class="bio-wrapper">
        <div class="avatar-wrap">
            <img src="@(Model.AvatarUrl ?? "/images/placeholder.jpg")" class="avatar-img" alt="Avatar">
            <div class="verified-badge">✓</div>
        </div>

        <h1 class="profile-title">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <p class="profile-bio">@Model.Bio</p>
        }

        <!-- 1. БОЛЬШИЕ ГЛАВНЫЕ КАРТОЧКИ-ССЫЛКИ (БЕЗ ГАЛОЧКИ "В РЯД ИКОНОК") -->
        <div class="links-container">
            @foreach (var link in Model.Links.Where(l => l.IsActive && !l.IsIconOnly).OrderBy(l => l.SortOrder))
            {
                string cleanTitle = System.Text.RegularExpressions.Regex.Replace(link.Title, @"^[\uD83C-\uDBFF\uDC00-\uDFFF\s]+", "").Trim();

                <a href="@link.Url"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="link-card @(link.IsHighlighted ? "highlighted" : "")"
                   onclick="trackLinkClick(@link.Id)">

                    <div class="link-content-left">
                        <div class="brand-icon-badge">
                            @RenderBrandSvg(link.IconType)
                        </div>
                        <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cleanTitle</span>
                    </div>
                    <span style="opacity: 0.5; font-size: 1.1rem; flex-shrink: 0;">➔</span>
                </a>
            }
        </div>

        <!-- 2. 🚀 НИЖНИЙ АККУРАТНЫЙ РЯД СОЦИАЛЬНЫХ ИКОНОК -->
        @{
            var iconLinks = Model.Links.Where(l => l.IsActive && l.IsIconOnly).OrderBy(l => l.SortOrder).ToList();
        }
        @if (iconLinks.Any())
        {
            <div class="social-icons-dock">
                @foreach (var link in iconLinks)
                {
                    <a href="@link.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-dock-btn"
                       title="@link.Title"
                       onclick="trackLinkClick(@link.Id)">
                        @RenderBrandSvg(link.IconType)
                    </a>
                }
            </div>
        }

        <a href="@AppConstants.APP_URL" class="footer-brand" target="_blank">
            <span>⚡ Сделано на платформе <strong>CrossChat</strong></span>
        </a>
    </div>

    <script>
        function trackLinkClick(linkId) {
            try {
                fetch('/biolink/click/' + linkId, { method: 'POST', keepalive: true }).catch(() => {});
            } catch(e){}
        }
    </script>
</body>

@functions {
        // Единый метод вывода векторной иконки бренда
