@model CrossChat.Data.Entities.BioPage
@using CrossChat.Infrastructure.Constants
@{
    ViewData["Title"] = "Конструктор переходника — " + Model.Title;
    string publicUrl = $"{AppConstants.APP_URL}/{Model.Slug}";

    string safeColor = (!string.IsNullOrWhiteSpace(Model.HighlightColor) && Model.HighlightColor.StartsWith("#") && Model.HighlightColor.Length == 7)
        ? Model.HighlightColor
        : "#38bdf8";
}

@section Styles {
    <style>
        .biolink-container {
            max-width: 1200px;
            margin: 5rem auto 3rem;
            padding: 0 1rem;
        }

        /* ПЕРЕКЛЮЧАТЕЛЬ ВКЛАДОК ДЛЯ МОБИЛЬНЫХ УСТРОЙСТВ */
        .mobile-view-toggle {
            display: none;
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 5px;
            margin-bottom: 1.25rem;
            gap: 6px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .mobile-toggle-btn {
            flex: 1;
            padding: 10px 14px;
            border-radius: 12px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .mobile-toggle-btn.active {
                background: var(--accent-color, #6366f1);
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
            }

        .editor-grid {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 2rem;
            align-items: start;
        }

        .editor-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 2.25rem;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
        }

        .section-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

            .form-group label {
                font-size: 0.8rem;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        /* СОВРЕМЕННЫЕ ПРОСТОРНЫЕ ТЕКСТОВЫЕ ПОЛЯ */
        .text-input, textarea, select.text-input {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 11px 16px;
            border-radius: 14px;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.2s ease;
            font-family: inherit;
        }

            .text-input:focus, textarea:focus, select.text-input:focus {
                border-color: var(--accent-color, #6366f1);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
                background: rgba(255, 255, 255, 0.08);
            }

        textarea {
            resize: vertical;
            min-height: 80px;
            line-height: 1.45;
        }

        .input-addon-group {
            display: flex;
            align-items: center;
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            overflow: hidden;
            transition: border-color 0.2s ease;
        }

            .input-addon-group:focus-within {
                border-color: var(--accent-color, #6366f1);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            }

        .addon-prefix {
            padding: 11px 12px 11px 16px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-family: monospace;
            background: rgba(255, 255, 255, 0.03);
            border-right: 1px solid var(--glass-border);
            user-select: none;
            white-space: nowrap;
        }

        .input-addon-group input {
            border: none !important;
            border-radius: 0 !important;
            background: transparent !important;
            padding: 11px 16px;
        }

        /* ТЕМЫ ОФОРМЛЕНИЯ */
        .themes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
            gap: 12px;
        }

        .theme-pill {
            height: 64px;
            border-radius: 16px;
            cursor: pointer;
            border: 2px solid transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 0.78rem;
            font-weight: 700;
            text-align: center;
            padding: 6px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

            .theme-pill:hover {
                transform: translateY(-2px);
            }

            .theme-pill.active {
                border-color: #38bdf8;
                transform: scale(1.05);
                box-shadow: 0 0 16px rgba(56, 189, 248, 0.45);
            }

        /* ССЫЛКИ / КАРТОЧКИ В СПИСКЕ */
        .links-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .link-item-row {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-sizing: border-box;
        }

            .link-item-row.dragging {
                opacity: 0.4;
                border: 2px dashed var(--accent-color);
            }

        .drag-handle {
            cursor: grab;
            color: var(--text-secondary);
            font-size: 1.3rem;
            padding: 0 4px;
            user-select: none;
            touch-action: none;
        }

            .drag-handle:active {
                cursor: grabbing;
            }

        .link-row-top {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .link-row-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
            padding-top: 8px;
            border-top: 1px dashed rgba(255, 255, 255, 0.08);
            flex-wrap: wrap;
            gap: 8px;
        }

        .reorder-btns-mobile {
            display: none;
            gap: 6px;
        }

        .reorder-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            border-radius: 8px;
            padding: 4px 8px;
            cursor: pointer;
            font-size: 0.8rem;
            line-height: 1;
        }

        /* КНОПКИ */
        .btn-modern-primary {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: #ffffff;
            border: none;
            border-radius: 14px;
            padding: 14px 20px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(99, 102, 241, 0.35);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-modern-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(99, 102, 241, 0.45);
            }

            .btn-modern-primary:active {
                transform: scale(0.98);
            }

        .btn-subtle {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            border-radius: 12px;
            padding: 8px 14px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-subtle:hover {
                background: rgba(255, 255, 255, 0.1);
                color: var(--text-main);
            }

        /* --- МАКЕТ СМАРТФОНА (LIVE PREVIEW) --- */
        .phone-wrapper {
            position: sticky;
            top: 5.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .phone-frame {
            width: 320px;
            height: 640px;
            background: #000000;
            border: 10px solid #1e293b;
            border-radius: 44px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .phone-notch {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 18px;
            background: #1e293b;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
            z-index: 10;
        }

        .phone-screen {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: none;
            padding: 2.5rem 1rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            position: relative;
            background-size: cover !important;
            background-position: center !important;
            transition: background 0.3s ease;
        }

            .phone-screen::-webkit-scrollbar {
                display: none;
            }

        .preview-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.35);
            margin-bottom: 10px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.35);
        }

        .preview-title {
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0;
            text-align: center;
        }

        .preview-bio {
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
            margin: 4px 0 16px 0;
            line-height: 1.35;
            max-width: 240px;
        }

        .preview-links {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .preview-btn {
            width: 100%;
            padding: 12px 14px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .brand-icon-badge {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: none !important;
            border: none !important;
            box-shadow: none !important;
        }

        .brand-icon-svg {
            width: 28px !important;
            height: 28px !important;
            filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.4));
        }

        .preview-btn.highlighted {
            background: rgba(255, 255, 255, 0.22) !important;
            border: 2px solid var(--preview-glow-color, #38bdf8) !important;
            position: relative;
            overflow: hidden;
            animation: previewPulseGlow 2.8s infinite ease-in-out !important;
            will-change: transform, box-shadow;
        }

            .preview-btn.highlighted::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -150%;
                width: 60%;
                height: 200%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
                transform: rotate(25deg);
                animation: shineSweep 2.8s infinite ease-in-out;
                pointer-events: none;
            }

        @@keyframes previewPulseGlow {
            0% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 0 8px var(--preview-glow-color, #38bdf8);
            }

            38% {
                transform: scale(1.035) rotate(0deg);
                box-shadow: 0 0 20px var(--preview-glow-color, #38bdf8), 0 0 36px var(--preview-glow-color, #38bdf8);
            }

            44% {
                transform: scale(1.035) rotate(-1.5deg);
                box-shadow: 0 0 22px var(--preview-glow-color, #38bdf8), 0 0 40px var(--preview-glow-color, #38bdf8);
            }

            50% {
                transform: scale(1.035) rotate(1.5deg);
                box-shadow: 0 0 22px var(--preview-glow-color, #38bdf8), 0 0 40px var(--preview-glow-color, #38bdf8);
            }

            56% {
                transform: scale(1.035) rotate(0deg);
                box-shadow: 0 0 20px var(--preview-glow-color, #38bdf8), 0 0 36px var(--preview-glow-color, #38bdf8);
            }

            70%, 100% {
                transform: scale(1) rotate(0deg);
                box-shadow: 0 0 8px var(--preview-glow-color, #38bdf8);
            }
        }

        @@keyframes shineSweep {
            0%, 25% {
                left: -150%;
            }

            65%, 100% {
                left: 200%;
            }
        }

        /* === МОБИЛЬНАЯ АДАПТАЦИЯ (ЭКРАНЫ МЕНЬШЕ 900px) === */
        @@media (max-width: 900px) {
            .mobile-view-toggle {
                display: flex !important;
            }

            .editor-grid {
                grid-template-columns: 1fr;
            }

            .editor-card {
                padding: 1.25rem;
                border-radius: 20px;
            }

            .addon-prefix {
                padding: 10px 8px 10px 12px;
                font-size: 0.8rem;
            }

            .reorder-btns-mobile {
                display: flex !important;
            }

            .drag-handle {
                display: none !important;
            }

            .phone-wrapper {
                display: none;
                width: 100%;
                margin: 0 auto;
            }

                .phone-wrapper.mobile-show {
                    display: flex !important;
                }

            .editor-card.mobile-hide {
                display: none !important;
            }

            .phone-frame {
                max-width: 310px;
                height: 580px;
            }
        }
    </style>
}

@section NavbarActions {
    <div style="display: flex; align-items: center; gap: 8px;">
        <a href="/profile?profileId=@Model.ProfileId" class="btn-subtle">
            ← В профиль
        </a>
    </div>
}

<div class="biolink-container">

    <!-- 🚀 ТУМБЛЕР ПЕРЕКЛЮЧЕНИЯ НАСТРОЙКИ / ПРЕДПРОСМОТР (ДЛЯ ТЕЛЕФОНОВ) -->
    <div class="mobile-view-toggle">
        <button type="button" class="mobile-toggle-btn active" id="btnTabEditor" onclick="setMobileView('editor')">
            ⚙️ Редактор
        </button>
        <button type="button" class="mobile-toggle-btn" id="btnTabPreview" onclick="setMobileView('preview')">
            📱 Предпросмотр
        </button>
    </div>

    <div class="editor-grid">

        <!-- ========================================================== -->
        <!-- ЛЕВАЯ КОЛОНКА: РЕДАКТОР И УПРАВЛЕНИЕ                       -->
        <!-- ========================================================== -->
        <div class="editor-card">

            <!-- ШАПКА -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--glass-border); padding-bottom: 1.25rem;">
                <div>
                    <h2 style="margin: 0; font-size: 1.35rem; font-weight: 800; color: var(--text-main);">
                        🔗 Страница-переходник
                    </h2>
                    <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;">
                        Безопасная мультиссылка для Instagram Bio без риска блокировки
                    </div>
                </div>

                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href="/biolink/analytics?profileId=@Model.ProfileId" class="btn-subtle" style="background: rgba(56, 189, 248, 0.12); color: #38bdf8; border-color: rgba(56, 189, 248, 0.3);">
                        📊 Аналитика
                    </a>

                    <!-- КНОПКА АВТОЗАПОЛНЕНИЯ В 1 КЛИК -->
                    <form action="/biolink/autofill?bioPageId=@Model.Id" method="post" onsubmit="return confirm('Заполнить кнопки ссылками из всех подключенных соцсетей профиля?');" style="margin: 0;">
                        <button type="submit" class="btn-subtle" style="background: linear-gradient(135deg, #a855f7, #6366f1); color: #ffffff; border: none;">
                            ✨ Автозаполнить
                        </button>
                    </form>
                </div>
            </div>

            <!-- ССЫЛКА НА САЙТ -->
            <div style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 16px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                <div style="min-width: 0; flex: 1;">
                    <span style="font-size: 0.72rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Ваш адрес для Bio:</span>
                    <div style="font-size: 0.95rem; font-weight: 800; color: #38bdf8; font-family: monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @publicUrl
                    </div>
                </div>
                <div style="display: flex; gap: 6px; flex-shrink: 0;">
                    <button type="button" class="btn-subtle" onclick="copyPublicUrl('@publicUrl', this)" style="padding: 6px 12px; font-size: 0.8rem;">
                        📋 Скопировать
                    </button>
                    <a href="@publicUrl" target="_blank" class="btn-subtle" style="padding: 6px 10px; font-size: 0.85rem;" title="Открыть">
                        ↗️
                    </a>
                </div>
            </div>

            <!-- ФОРМА -->
            <form id="bioForm" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1.4rem;">
                <input type="hidden" name="bioPageId" value="@Model.Id">
                <input type="hidden" name="themeType" id="selectedThemeInput" value="@Model.ThemeType">
                <input type="hidden" name="customBackgroundValue" id="customBgValueInput" value="@Model.CustomBackgroundValue">
                <input type="hidden" name="linksJson" id="linksJsonHidden">

                <!-- 1. SLUG -->
                <div class="form-group">
                    <label>Короткий адрес ссылки (Slug):</label>
                    <div class="input-addon-group">
                        <span class="addon-prefix">@AppConstants.APP_DOMAIN/</span>
                        <input type="text" name="slug" id="slugInput" class="text-input" value="@Model.Slug" required placeholder="lanaroads" oninput="onSlugChanged(this.value)">
                    </div>
                </div>

                <!-- 2. ИМЯ И АВАТАРКА -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
                    <div class="form-group">
                        <label>Имя / Заголовок:</label>
                        <input type="text" name="title" id="titleInput" class="text-input" value="@Model.Title" required placeholder="Lana Roads" oninput="updateLivePreview()">
                    </div>
                    <div class="form-group">
                        <label>Сменить аватарку:</label>
                        <input type="file" name="avatarImageFile" accept="image/*" class="text-input" onchange="previewAvatarUpload(this)">
                    </div>
                </div>

                <div class="form-group">
                    <label>Краткое био / описание:</label>
                    <textarea name="bio" id="bioInput" rows="2" class="text-input" placeholder="Добро пожаловать! Выберите удобный способ связи 👇" oninput="updateLivePreview()">@Model.Bio</textarea>
                </div>

                <!-- 3. ТЕМЫ И ФОН -->
                <div class="form-group">
                    <label>Тема оформления фона:</label>
                    <div class="themes-grid">
                        <div class="theme-pill @(Model.ThemeType == "gradient-dark" ? "active" : "")"
                             style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);"
                             onclick="selectTheme('gradient-dark', 'linear-gradient(180deg, #0f172a 0%, #1e293b 100%)', this)">
                            Тёмный
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-neon" ? "active" : "")"
                             style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #ec4899 100%);"
                             onclick="selectTheme('gradient-neon', 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #ec4899 100%)', this)">
                            Неон
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-sunset" ? "active" : "")"
                             style="background: linear-gradient(180deg, #1e1b4b 0%, #831843 50%, #ea580c 100%);"
                             onclick="selectTheme('gradient-sunset', 'linear-gradient(180deg, #1e1b4b 0%, #831843 50%, #ea580c 100%)', this)">
                            Закат
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-ocean" ? "active" : "")"
                             style="background: linear-gradient(180deg, #022c22 0%, #064e3b 50%, #0f766e 100%);"
                             onclick="selectTheme('gradient-ocean', 'linear-gradient(180deg, #022c22 0%, #064e3b 50%, #0f766e 100%)', this)">
                            Изумруд
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "custom-image" ? "active" : "")"
                             style="background: #334155; border: 1px dashed var(--glass-border);"
                             onclick="selectCustomTheme(this)">
                            📷 Свой фон
                        </div>
                    </div>
                </div>

                <div class="form-group" id="bgUploadBox" style="display: @(Model.ThemeType == "custom-image" ? "block" : "none");">
                    <label>Загрузить изображение для фона:</label>
                    <input type="file" name="bgImageFile" accept="image/*" class="text-input" onchange="previewBackgroundUpload(this)">
                </div>

                <!-- ЦВЕТ НЕОНА -->
                <div class="form-group">
                    <label>Цвет рамки и свечения (для главной ссылки ⭐):</label>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <input type="color" name="highlightColor" id="highlightColorInput" value="@safeColor"
                               style="width: 48px; height: 42px; border: 1px solid var(--glass-border); border-radius: 12px; background: transparent; cursor: pointer; padding: 2px;"
                               onchange="updateLivePreview()">
                        <span style="font-size: 0.82rem; color: var(--text-secondary);">
                            Выберите цвет пульсирующего неона для важной ссылки
                        </span>
                    </div>
                </div>

                <!-- 4. КНОПКИ-ССЫЛКИ -->
                <div class="form-group">
                    <div class="section-title">
                        <span>Кнопки-ссылки (@Model.Links.Count):</span>
                        <button type="button" class="btn-subtle" onclick="addNewLinkRow()" style="font-size: 0.8rem; padding: 6px 12px; color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">
                            + Добавить ссылку
                        </button>
                    </div>

                    <div class="links-list" id="linksListContainer">
                        @foreach (var l in Model.Links.OrderBy(x => x.SortOrder))
                        {
                            <div class="link-item-row" draggable="true" data-id="@l.Id">
                                <div class="link-row-top">
                                    <span class="drag-handle" title="Перетащите мышкой">⠿</span>
                                    <select class="text-input link-icon-select" style="width: 125px; padding: 8px 10px; font-size: 0.85rem;" onchange="updateLivePreview()">
                                        <option value="telegram" selected="@(l.IconType == "telegram")">✈️ Telegram</option>
                                        <option value="instagram" selected="@(l.IconType == "instagram")">📸 Instagram</option>
                                        <option value="youtube" selected="@(l.IconType == "youtube")">🎬 YouTube</option>
                                        <option value="bluesky" selected="@(l.IconType == "bluesky")">🦋 BlueSky</option>
                                        <option value="threads" selected="@(l.IconType == "threads")">🧵 Threads</option>
                                        <option value="x" selected="@(l.IconType == "x")">✖️ X</option>
                                        <option value="facebook" selected="@(l.IconType == "facebook")">📘 Facebook</option>
                                        <option value="custom" selected="@(l.IconType == "custom")">🔗 Ссылка</option>
                                    </select>
                                    <input type="text" class="text-input link-title-input" value="@l.Title" placeholder="Название кнопки" style="flex: 1; padding: 8px 12px; font-weight: 700;" oninput="updateLivePreview()">
                                </div>
                                <div>
                                    <input type="url" class="text-input link-url-input" value="@l.Url" placeholder="https://..." style="padding: 8px 12px; font-size: 0.88rem;" oninput="updateLivePreview()">
                                </div>
                                <div class="link-row-actions">
                                    <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                                        <!-- СВЕЧЕНИЕ -->
                                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.8rem; color: var(--text-main);">
                                            <input type="checkbox" class="link-highlight-cb" checked="@l.IsHighlighted" onchange="updateLivePreview()" style="accent-color: #38bdf8; width: 16px; height: 16px;">
                                            ⭐ Свечение
                                        </label>

                                        <!-- 🚀 ГАЛОЧКА СКРЫТЬ ССЫЛКУ -->
                                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.8rem; color: var(--text-secondary);">
                                            <input type="checkbox" class="link-hidden-cb" checked="@(!l.IsActive)" onchange="updateLivePreview()" style="accent-color: #ef4444; width: 16px; height: 16px;">
                                            🙈 Скрыть
                                        </label>
                                    </div>

                                    <!-- КНОПКИ ПЕРЕМЕЩЕНИЯ ДЛЯ СМАРТФОНОВ -->
                                    <div class="reorder-btns-mobile">
                                        <button type="button" class="reorder-btn" onclick="moveLinkRow(this, -1)" title="Поднять выше">⬆️</button>
                                        <button type="button" class="reorder-btn" onclick="moveLinkRow(this, 1)" title="Опустить ниже">⬇️</button>
                                    </div>

                                    <div style="display: flex; gap: 10px; align-items: center;">
                                        <span style="color: var(--text-secondary); font-size: 0.75rem;">Кликов: <strong>@l.ClicksCount</strong></span>
                                        <button type="button" onclick="removeLinkRow(this)" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1.1rem; line-height: 1;">🗑️</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- СОХРАНИТЬ -->
                <button type="button" class="btn-modern-primary" id="btnSaveBio" onclick="saveBioPage()">
                    💾 Сохранить изменения
                </button>
            </form>
        </div>

        <!-- ========================================================== -->
        <!-- ПРАВАЯ КОЛОНКА: МАКЕТ IPHONE                               -->
        <!-- ========================================================== -->
        <div class="phone-wrapper">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <span>📱</span> Живой просмотр на смартфоне
            </div>
            <div class="phone-frame">
                <div class="phone-notch"></div>
                <div class="phone-screen" id="previewScreen" style="background: @(Model.ThemeType == "custom-image" && !string.IsNullOrEmpty(Model.CustomBackgroundValue) ? $"url('{Model.CustomBackgroundValue}')" : Model.CustomBackgroundValue);">
                    <img id="previewAvatarImg"
                         src="@(Model.AvatarUrl ?? "/images/placeholder.jpg")"
                         class="preview-avatar"
                         alt="Avatar"
                         onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Title ?? "User")&background=0085ff&color=fff';">

                    <h3 id="previewTitleText" class="preview-title">@Model.Title</h3>
                    <p id="previewBioText" class="preview-bio">@Model.Bio</p>

                    <div id="previewLinksContainer" class="preview-links">
                        <!-- Живые кнопки генерируются через JS -->
                    </div>

                    <div style="margin-top: auto; padding-top: 2rem; font-size: 0.65rem; opacity: 0.5;">
                        ⚡ Powered by CrossChat
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let currentBgValue = "@(Model.CustomBackgroundValue ?? "linear-gradient(180deg, #0f172a 0%, #1e293b 100%)")";
        let draggedRow = null;

        document.addEventListener('DOMContentLoaded', () => {
            updateLivePreview();
            initDragAndDrop();
        });

        // 📱 ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК НА ТЕЛЕФОНЕ (РЕДАКТОР <-> ПРЕДПРОСМОТР)
        function setMobileView(view) {
            const btnEditor = document.getElementById('btnTabEditor');
            const btnPreview = document.getElementById('btnTabPreview');
            const editorCard = document.querySelector('.editor-card');
            const phoneWrapper = document.querySelector('.phone-wrapper');

            if (view === 'preview') {
                btnEditor.classList.remove('active');
                btnPreview.classList.add('active');
                editorCard.classList.add('mobile-hide');
                phoneWrapper.classList.add('mobile-show');
                updateLivePreview();
            } else {
                btnPreview.classList.remove('active');
                btnEditor.classList.add('active');
                editorCard.classList.remove('mobile-hide');
                phoneWrapper.classList.remove('mobile-show');
            }
        }

        // 1. ТЕМЫ ОФОРМЛЕНИЯ
        function selectTheme(themeName, bgValue, pillElem) {
            document.querySelectorAll('.theme-pill').forEach(p => p.classList.remove('active'));
            pillElem.classList.add('active');

            document.getElementById('selectedThemeInput').value = themeName;
            document.getElementById('customBgValueInput').value = bgValue;
            document.getElementById('bgUploadBox').style.display = 'none';

            currentBgValue = bgValue;
            document.getElementById('previewScreen').style.background = bgValue;
        }

        function selectCustomTheme(pillElem) {
            document.querySelectorAll('.theme-pill').forEach(p => p.classList.remove('active'));
            pillElem.classList.add('active');

            document.getElementById('selectedThemeInput').value = 'custom-image';
            document.getElementById('bgUploadBox').style.display = 'block';
        }

        // 2. ПРЕДПРОСМОТР ЗАГРУЗКИ КАРТИНОК
        function previewAvatarUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    document.getElementById('previewAvatarImg').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewBackgroundUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    currentBgValue = `url('${e.target.result}')`;
                    document.getElementById('previewScreen').style.background = currentBgValue;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 3. ДОБАВЛЕНИЕ НОВОЙ КНОПКИ
        function addNewLinkRow() {
            const container = document.getElementById('linksListContainer');
            const row = document.createElement('div');
            row.className = 'link-item-row';
            row.setAttribute('draggable', 'true');
            row.dataset.id = "0";
            row.innerHTML = `
            <div class="link-row-top">
                    <span class="drag-handle" title="Перетащите мышкой">⠿</span>
                    <select class="text-input link-icon-select" style="width: 125px; padding: 8px 10px; font-size: 0.85rem;" onchange="updateLivePreview()">
                        <option value="telegram">✈️ Telegram</option>
                        <option value="instagram">📸 Instagram</option>
                        <option value="youtube">🎬 YouTube</option>
                        <option value="bluesky">🦋 BlueSky</option>
                        <option value="threads">🧵 Threads</option>
                        <option value="x">✖️ X</option>
                        <option value="facebook">📘 Facebook</option>
                        <option value="custom" selected>🔗 Ссылка</option>
                    </select>
                    <input type="text" class="text-input link-title-input" placeholder="Название кнопки" style="flex: 1; padding: 8px 12px; font-weight: 700;" oninput="updateLivePreview()">
                </div>
                <div>
                    <input type="url" class="text-input link-url-input" placeholder="https://..." style="padding: 8px 12px; font-size: 0.88rem;" oninput="updateLivePreview()">
                </div>
                <div class="link-row-actions">
                    <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.8rem; color: var(--text-main);">
                            <input type="checkbox" class="link-highlight-cb" onchange="updateLivePreview()" style="accent-color: #38bdf8; width: 16px; height: 16px;">
                            ⭐ Свечение
                        </label>
                        <!-- 🚀 Галочка скрыть для новых строк -->
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.8rem; color: var(--text-secondary);">
                            <input type="checkbox" class="link-hidden-cb" onchange="updateLivePreview()" style="accent-color: #ef4444; width: 16px; height: 16px;">
                            🙈 Скрыть
                        </label>
                    </div>

                    <div class="reorder-btns-mobile">
                        <button type="button" class="reorder-btn" onclick="moveLinkRow(this, -1)" title="Поднять выше">⬆️</button>
                        <button type="button" class="reorder-btn" onclick="moveLinkRow(this, 1)" title="Опустить ниже">⬇️</button>
                    </div>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <span style="color: var(--text-secondary); font-size: 0.75rem;">Кликов: <strong>0</strong></span>
                        <button type="button" onclick="removeLinkRow(this)" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1.1rem; line-height: 1;">🗑️</button>
                    </div>
                </div>
            `;
            container.appendChild(row);
            updateLivePreview();
        }

        function removeLinkRow(btn) {
            btn.closest('.link-item-row').remove();
            updateLivePreview();
        }

        // 4. ПЕРЕМЕЩЕНИЕ ССЫЛОК (DRAG & DROP + СТРЕЛКИ)
        function initDragAndDrop() {
            const container = document.getElementById('linksListContainer');
            if (!container) return;

            container.addEventListener('dragstart', (e) => {
                const row = e.target.closest('.link-item-row');
                if (!row) return;
                draggedRow = row;
                e.dataTransfer.effectAllowed = 'move';
                setTimeout(() => row.classList.add('dragging'), 0);
            });

            container.addEventListener('dragend', (e) => {
                const row = e.target.closest('.link-item-row');
                if (row) row.classList.remove('dragging');
                draggedRow = null;
                updateLivePreview();
            });

            container.addEventListener('dragover', (e) => {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                const container = document.getElementById('linksListContainer');
                const afterElement = getDragAfterElement(container, e.clientY);
                if (draggedRow) {
                    if (afterElement == null) {
                        container.appendChild(draggedRow);
                    } else {
                        container.insertBefore(draggedRow, afterElement);
                    }
                }
            });
        }

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.link-item-row:not(.dragging)')];

            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        function moveLinkRow(btn, direction) {
            const row = btn.closest('.link-item-row');
            if (!row) return;

            if (direction === -1) {
                const prev = row.previousElementSibling;
                if (prev) row.parentNode.insertBefore(row, prev);
            } else if (direction === 1) {
                const next = row.nextElementSibling;
                if (next) row.parentNode.insertBefore(next, row);
            }
            updateLivePreview();
        }

        // 5. ЖИВОЕ ОБНОВЛЕНИЕ ПРЕВЬЮ
        function updateLivePreview() {
            const previewContainer = document.getElementById('previewLinksContainer');
            if (!previewContainer) return;

            const highlightColorInput = document.getElementById('highlightColorInput');
            let highlightColor = '#38bdf8';
            if (highlightColorInput && highlightColorInput.value && highlightColorInput.value.startsWith('#')) {
                highlightColor = highlightColorInput.value;
            }

            const previewScreen = document.getElementById('previewScreen');
            if (previewScreen) {
                previewScreen.style.setProperty('--preview-glow-color', highlightColor);
            }

            const titleInput = document.getElementById('titleInput');
            const bioInput = document.getElementById('bioInput');
            const previewTitle = document.getElementById('previewTitleText');
            const previewBio = document.getElementById('previewBioText');

            if (previewTitle) previewTitle.textContent = (titleInput && titleInput.value.trim()) ? titleInput.value : 'Имя профиля';
            if (previewBio) previewBio.textContent = (bioInput && bioInput.value.trim()) ? bioInput.value : '';

            previewContainer.innerHTML = '';

            const rows = document.querySelectorAll('.link-item-row');
            rows.forEach(r => {
                const titleInputEl = r.querySelector('.link-title-input');
                const iconSelectEl = r.querySelector('.link-icon-select');
                const highlightCbEl = r.querySelector('.link-highlight-cb');
                const hiddenCbEl = r.querySelector('.link-hidden-cb'); // 🚀 Считываем галочку

                let title = titleInputEl ? titleInputEl.value.trim() : '';
                const icon = iconSelectEl ? iconSelectEl.value : 'custom';
                const isHighlight = highlightCbEl ? highlightCbEl.checked : false;
                const isHidden = hiddenCbEl ? hiddenCbEl.checked : false;

                // 🚀 Приглушаем карточку в редакторе, если она скрыта:
                r.style.opacity = isHidden ? '0.5' : '1';

                // Если ссылка пустая ИЛИ скрыта — НЕ рисуем её на экране телефона!
                if (!title || isHidden) return;

                title = title.replace(/^[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\s]+/u, '');

                const iconSvg = getNetworkBrandSvg(icon);
                const btn = document.createElement('div');
                btn.className = `preview-btn ${isHighlight ? 'highlighted' : ''}`;
                btn.innerHTML = `
                    <div class="brand-icon-badge">${iconSvg}</div>
                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; text-align:left;">${escapeHtml(title)}</span>
                    <span style="opacity:0.4; font-size:0.9rem;">➔</span>
                `;
                previewContainer.appendChild(btn);
            });
        }

        function getNetworkBrandSvg(type) {
            switch(type) {
                case 'telegram':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="#2AABEE"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.74-.4.27-.76.41-1.08.4-.36-.01-1.05-.2-1.56-.37-.63-.2-1.12-.31-1.08-.66.02-.18.3-.37.83-.58 3.27-1.42 5.45-2.36 6.54-2.81 3.1-.12 3.74.03 3.53 1.52z"/></svg>`;
                case 'instagram':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <defs><linearGradient id="instaGradPreview" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="50%" stop-color="#dc2743"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs>
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="url(#instaGradPreview)"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="url(#instaGradPreview)"></path>
                        <circle cx="17.5" cy="6.5" r="1.2" fill="url(#instaGradPreview)"></circle>
                    </svg>`;
                case 'youtube':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="#FF0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`;
                case 'bluesky':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="#0085ff"><path d="M12 10.57c2.16-3.85 4.97-6.9 7.32-6.9 2.92 0 4.68 2.65 4.68 5.38 0 4.42-4.14 7.91-7.31 9.77-1.17.68-2.53 1.12-3.89 1.12h-.8c-1.36 0-2.72-.44-3.89-1.12C4.84 16.96.7 13.47.7 9.05c0-2.73 1.76-5.38 4.68-5.38 2.35 0 5.16 3.05 7.32 6.9z"/></svg>`;
                    case 'threads':
                    return `<svg class="brand-icon-svg" viewBox="0 0 192 192" style="border-radius:6px;">
                        <rect width="192" height="192" rx="42" fill="#000000" />
                        <g transform="translate(26.9, 26.9) scale(0.72)">
                            <path fill="#ffffff" d="M141.537 88.988a66.667 66.667 0 0 0-2.518-1.143c-1.482-27.307-16.403-42.94-41.457-43.1h-.34c-14.986 0-27.449 6.396-35.12 18.036l13.779 9.452c5.73-8.695 14.724-10.548 21.348-10.548h.229c8.249.053 14.474 2.452 18.503 7.129 2.932 3.405 4.893 8.111 5.864 14.05-7.314-1.243-15.224-1.626-23.68-1.14-23.82 1.371-39.134 15.264-38.105 34.568.522 9.792 5.4 18.216 13.735 23.719 7.047 4.652 16.124 6.927 25.557 6.412 12.458-.683 22.231-5.436 29.049-14.127 5.178-6.6 8.453-15.153 9.899-25.93 5.937 3.583 10.337 8.298 12.767 13.966 4.132 9.635 4.373 25.468-8.546 38.376-11.319 11.308-24.925 16.2-45.488 16.351-22.809-.169-40.06-7.484-51.275-21.742C35.236 139.966 29.808 120.682 29.605 96c.203-24.682 5.63-43.966 16.133-57.317C56.954 24.425 74.204 17.11 97.013 16.94c22.975.17 40.526 7.52 52.171 21.847 5.71 7.026 10.015 15.86 12.853 26.162l16.147-4.308c-3.44-12.68-8.853-23.606-16.219-32.668C147.036 9.607 125.202.195 97.07 0h-.113C68.882.194 47.292 9.642 32.788 28.08 19.882 44.485 13.224 67.315 13.001 95.932L13 96v.067c.224 28.617 6.882 51.447 19.788 67.854C47.292 182.358 68.882 191.806 96.957 192h.113c24.96-.173 42.554-6.708 57.048-21.189 18.963-18.945 18.392-42.692 12.142-57.27-4.484-10.454-13.033-18.945-24.723-24.553ZM98.44 129.507c-10.44.588-21.286-4.098-21.82-14.135-.397-7.442 5.296-15.746 22.461-16.735 1.966-.114 3.895-.169 5.79-.169 6.235 0 12.068.606 17.371 1.765-1.978 24.702-13.58 28.713-23.802 29.274Z"/>
                        </g>
                    </svg>`;
                case 'x':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="#ffffff"><path d="M18.244 2.25h3.308l-7.227 7.746 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.286L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
                case 'facebook':
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
                default:
                    return `<svg class="brand-icon-svg" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>`;
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        function onSlugChanged(val) {
            val = val.toLowerCase().replace(/[^a-z0-9\-_]/g, '');
            document.getElementById('slugInput').value = val;
        }

        function copyPublicUrl(url, btn) {
            navigator.clipboard.writeText(url).then(() => {
                const old = btn.textContent;
                btn.textContent = '✅ Скопировано!';
                setTimeout(() => btn.textContent = old, 2000);
            });
        }

        // 6. СОХРАНЕНИЕ СТРАНИЦЫ
        async function saveBioPage() {
            const form = document.getElementById('bioForm');
            const btn = document.getElementById('btnSaveBio');
            btn.disabled = true;
            btn.textContent = '⏳ Сохранение...';

            const links = [];
            document.querySelectorAll('.link-item-row').forEach(r => {
                const linkId = parseInt(r.dataset.id) || 0;
                const title = r.querySelector('.link-title-input').value.trim();
                const url = r.querySelector('.link-url-input').value.trim();
                const icon = r.querySelector('.link-icon-select').value;
                const isHighlight = r.querySelector('.link-highlight-cb').checked;
                const isHidden = r.querySelector('.link-hidden-cb')?.checked ?? false; // 🚀

                if (title && url) {
                    links.push({
                        id: linkId,
                        title: title,
                        url: url,
                        iconType: icon,
                        isHighlighted: isHighlight,
                        isActive: !isHidden // 🚀 Сохраняем: если скрыто, isActive = false!
                    });
                }
            });

            document.getElementById('linksJsonHidden').value = JSON.stringify(links);

            const formData = new FormData(form);

            try {
                const res = await fetch('/biolink/save', {
                    method: 'POST',
                    body: formData
                });

                if (res.ok) {
                    alert('✅ Страница-переходник успешно сохранена!');
                    location.reload();
                } else {
                    const err = await res.text();
                    alert('Ошибка: ' + err);
                }
            } catch {
                alert('Сетевая ошибка при сохранении');
            } finally {
                btn.disabled = false;
                btn.textContent = '💾 Сохранить изменения';
            }
        }
    </script>
}