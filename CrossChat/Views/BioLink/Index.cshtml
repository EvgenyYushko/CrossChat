@model CrossChat.Data.Entities.BioPage
@using CrossChat.Infrastructure.Constants
@{
    ViewData["Title"] = "Конструктор переходника — " + Model.Title;
    string publicUrl = $"{AppConstants.APP_URL}/{Model.Slug}";
}

@section Styles {
    <style>
        .biolink-container {
            max-width: 1200px;
            margin: 5rem auto 3rem;
            padding: 0 1rem;
        }

        .editor-grid {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 2rem;
            align-items: start;
        }

        .editor-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 0.5rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .form-group label {
                font-size: 0.8rem;
                font-weight: 700;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        .input-addon-group {
            display: flex;
            align-items: center;
            background: var(--input-bg, rgba(15, 23, 42, 0.3));
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            overflow: hidden;
        }

        .addon-prefix {
            padding: 0.75rem 0.5rem 0.75rem 1rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-family: monospace;
            background: rgba(255, 255, 255, 0.03);
            border-right: 1px solid var(--glass-border);
            user-select: none;
        }

        .input-addon-group input {
            border: none !important;
            border-radius: 0 !important;
            background: transparent !important;
            padding: 0.75rem 1rem;
        }

        /* ТЕМЫ ОФОРМЛЕНИЯ */
        .themes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
        }

        .theme-pill {
            height: 60px;
            border-radius: 12px;
            cursor: pointer;
            border: 2px solid transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            text-align: center;
            padding: 4px;
            transition: all 0.2s;
            position: relative;
        }

            .theme-pill.active {
                border-color: #38bdf8;
                transform: scale(1.05);
                box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
            }

        /* СПИСОК ССЫЛОК */
        .links-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .link-item-row {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: all 0.2s;
        }

        .link-row-top {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .link-row-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.75rem;
            padding-top: 6px;
            border-top: 1px dashed rgba(255, 255, 255, 0.08);
        }

        /* --- МАКЕТ СМАРТФОНА (LIVE PREVIEW) --- */
        .phone-wrapper {
            position: sticky;
            top: 5.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .phone-frame {
            width: 320px;
            height: 640px;
            background: #000000;
            border: 10px solid #1e293b;
            border-radius: 44px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .phone-notch {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 18px;
            background: #1e293b;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
            z-index: 10;
        }

        .phone-screen {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: none;
            padding: 2.5rem 1rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            position: relative;
            background-size: cover !important;
            background-position: center !important;
            transition: background 0.3s ease;
        }

            .phone-screen::-webkit-scrollbar {
                display: none;
            }

        .preview-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.3);
            margin-bottom: 10px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        }

        .preview-title {
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0;
            text-align: center;
        }

        .preview-bio {
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.75);
            text-align: center;
            margin: 4px 0 16px 0;
            line-height: 1.3;
            max-width: 240px;
        }

        .preview-links {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .preview-btn {
            width: 100%;
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 700;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: flex-start; /* ВЫРАВНИВАЕМ ПО ЛЕВОМУ КРАЮ */
            gap: 12px;
            text-decoration: none;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        /* Круглый стильный бейдж под иконку бренда */
        .brand-icon-badge {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.12);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }

        .brand-icon-svg {
            width: 18px;
            height: 18px;
        }

            .preview-btn.highlighted {
                background: rgba(255, 255, 255, 0.22);
                border-color: #38bdf8;
                box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
                animation: pulseGlow 2s infinite;
            }

        @@keyframes pulseGlow {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.02);
            }

            100% {
                transform: scale(1);
            }
        }

        @@media (max-width: 900px) {
            .editor-grid {
                grid-template-columns: 1fr;
            }

            .phone-wrapper {
                display: none; /* На мобилке скрываем живой макет для компактности */
            }
        }

        /* 🚀 СТИЛИ ПЕРЕНОСА ССЫЛОК */
        .link-item-row {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: border-color 0.2s, box-shadow 0.2s;
            cursor: default;
        }

            .link-item-row.dragging {
                opacity: 0.4;
                border: 2px dashed var(--accent-color);
            }

        .drag-handle {
            cursor: grab;
            color: var(--text-secondary);
            font-size: 1.2rem;
            padding: 0 4px;
            user-select: none;
            touch-action: none;
        }

            .drag-handle:active {
                cursor: grabbing;
            }

        .reorder-btns-mobile {
            display: none;
            gap: 4px;
        }

        /* На мобилках показываем стрелочки для мгновенного перемещения в 1 тап */
        @@media (max-width: 900px) {
            .reorder-btns-mobile {
                display: flex;
            }

            .drag-handle {
                display: none; /* На тач-экранах скрываем десктопную ручку */
            }
        }
    </style>
}

@section NavbarActions {
    <div style="display: flex; align-items: center; gap: 8px;">
        <a href="/profile?profileId=@Model.ProfileId" class="btn-cancel" style="text-decoration: none; padding: 6px 12px; font-size: 0.85rem;">
            ← В профиль
        </a>
    </div>
}

<div class="biolink-container">
    <div class="editor-grid">

        <!-- ========================================================== -->
        <!-- ЛЕВАЯ КОЛОНКА: РЕДАКТОР И УПРАВЛЕНИЕ                       -->
        <!-- ========================================================== -->
        <div class="editor-card">

            <!-- ШАПКА -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid var(--glass-border); padding-bottom: 1rem;">
                <div>
                    <h2 style="margin: 0; font-size: 1.4rem; font-weight: 800; color: var(--text-main);">
                        🔗 Страница-переходник (Bio Link)
                    </h2>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                        Безопасная мультиссылка для шапки Instagram без банов за Telegram
                    </div>
                </div>

                <!-- 🚀 КНОПКА АВТОЗАПОЛНЕНИЯ В 1 КЛИК -->
                <form action="/biolink/autofill?bioPageId=@Model.Id" method="post" onsubmit="return confirm('Заполнить кнопки ссылками из всех подключенных соцсетей профиля?');">
                    <button type="submit" class="btn-action" style="background: linear-gradient(135deg, #a855f7, #6366f1); color: #fff; font-weight: 700; padding: 8px 14px; border-radius: 10px; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                        <span>✨</span> <span>Автозаполнить из профиля</span>
                    </button>
                </form>
                <!-- КНОПКА ДАШБОРДА АНАЛИТИКИ -->
                <a href="/biolink/analytics?profileId=@Model.ProfileId"
                   class="btn-action"
                   style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.35); color: #38bdf8; text-decoration: none; padding: 8px 14px; font-weight: 700; border-radius: 10px; display: inline-flex; align-items: center; gap: 6px;">
                    <span>📊</span> <span>Аналитика переходов</span>
                </a>
            </div>

            <!-- ССЫЛКА НА ГОТОВЫЙ САЙТ -->
            <div style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <div>
                    <span style="font-size: 0.72rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Ваша ссылка для Instagram Bio:</span>
                    <div style="font-size: 0.95rem; font-weight: 800; color: #38bdf8; font-family: monospace;">
                        @publicUrl
                    </div>
                </div>
                <div style="display: flex; gap: 6px;">
                    <button type="button" class="btn-action btn-copy-tags" onclick="copyPublicUrl('@publicUrl', this)" style="padding: 6px 12px; font-size: 0.8rem;">
                        📋 Скопировать
                    </button>
                    <a href="@publicUrl" target="_blank" class="btn-action btn-insta-link" style="padding: 6px 10px; font-size: 0.85rem;" title="Открыть в новой вкладке">
                        ↗️
                    </a>
                </div>
            </div>

            <!-- ФОРМА РЕДАКТИРОВАНИЯ -->
            <form id="bioForm" enctype="multipart/form-data">
                <input type="hidden" name="bioPageId" value="@Model.Id">
                <input type="hidden" name="themeType" id="selectedThemeInput" value="@Model.ThemeType">
                <input type="hidden" name="customBackgroundValue" id="customBgValueInput" value="@Model.CustomBackgroundValue">
                <input type="hidden" name="linksJson" id="linksJsonHidden">

                <!-- 1. АДРЕС ССЫЛКИ (SLUG) -->
                <div class="form-group">
                    <label>Короткий адрес ссылки (Slug):</label>
                    <div class="input-addon-group">
                        <span class="addon-prefix">@AppConstants.APP_DOMAIN/</span>
                        <input type="text" name="slug" id="slugInput" class="text-input" value="@Model.Slug" required placeholder="lanaroads" oninput="onSlugChanged(this.value)">
                    </div>
                </div>

                <!-- 2. ИМЯ И ОПИСАНИЕ -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>Имя / Заголовок:</label>
                        <input type="text" name="title" id="titleInput" class="text-input" value="@Model.Title" required placeholder="Lana Roads" oninput="updateLivePreview()">
                    </div>
                    <div class="form-group">
                        <label>Сменить аватарку:</label>
                        <input type="file" name="avatarImageFile" accept="image/*" class="text-input" onchange="previewAvatarUpload(this)">
                    </div>
                </div>

                <div class="form-group">
                    <label>Краткое био / статус:</label>
                    <textarea name="bio" id="bioInput" rows="2" class="text-input" style="min-height: 60px;" placeholder="Эксклюзивный контент и связь со мной 👇" oninput="updateLivePreview()">@Model.Bio</textarea>
                </div>

                <!-- 3. ВЫБОР ТЕМЫ И ФОНА -->
                <div class="form-group">
                    <label>Фон и тема оформления:</label>
                    <div class="themes-grid">
                        <div class="theme-pill @(Model.ThemeType == "gradient-dark" ? "active" : "")"
                             style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);"
                             onclick="selectTheme('gradient-dark', 'linear-gradient(180deg, #0f172a 0%, #1e293b 100%)', this)">
                            Тёмный
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-neon" ? "active" : "")"
                             style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #ec4899 100%);"
                             onclick="selectTheme('gradient-neon', 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #ec4899 100%)', this)">
                            Неон
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-sunset" ? "active" : "")"
                             style="background: linear-gradient(180deg, #1e1b4b 0%, #831843 50%, #ea580c 100%);"
                             onclick="selectTheme('gradient-sunset', 'linear-gradient(180deg, #1e1b4b 0%, #831843 50%, #ea580c 100%)', this)">
                            Закат
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "gradient-ocean" ? "active" : "")"
                             style="background: linear-gradient(180deg, #022c22 0%, #064e3b 50%, #0f766e 100%);"
                             onclick="selectTheme('gradient-ocean', 'linear-gradient(180deg, #022c22 0%, #064e3b 50%, #0f766e 100%)', this)">
                            Изумруд
                        </div>
                        <div class="theme-pill @(Model.ThemeType == "custom-image" ? "active" : "")"
                             style="background: #334155; border: 1px dashed var(--glass-border);"
                             onclick="selectCustomTheme(this)">
                            📷 Свой фон
                        </div>
                    </div>
                </div>

                <!-- 🚀 ВЫБОР ЦВЕТА СВЕЧЕНИЯ ДЛЯ ВАЖНОЙ КНОПКИ -->
                <div class="form-group" style="margin-top: 1rem;">
                    <label>Цвет неонового свечения (для главной ссылки):</label>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <input type="color" name="highlightColor" id="highlightColorInput" value="@Model.HighlightColor"
                               style="width: 50px; height: 42px; border: 1px solid var(--glass-border); border-radius: 10px; background: transparent; cursor: pointer; padding: 2px;"
                               onchange="updateLivePreview()">
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">
                            Выберите цвет рамки и свечения для кнопки со звёздочкой ⭐
                        </span>
                    </div>
                </div>

                <!-- Поле загрузки файла фона (если выбран custom-image) -->
                <div class="form-group" id="bgUploadBox" style="display: @(Model.ThemeType == "custom-image" ? "block" : "none");">
                    <label>Загрузить изображение для фона:</label>
                    <input type="file" name="bgImageFile" accept="image/*" class="text-input" onchange="previewBackgroundUpload(this)">
                </div>

                <!-- 4. УПРАВЛЕНИЕ СПИСКОМ КНОПОК -->
                <div class="form-group">
                    <div class="section-title">
                        <span>Кнопки-ссылки (@Model.Links.Count):</span>
                        <button type="button" class="btn-action" onclick="addNewLinkRow()" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.8rem; padding: 4px 10px;">
                            + Добавить ссылку
                        </button>
                    </div>

                    <div class="links-list" id="linksListContainer">
                        @foreach (var l in Model.Links.OrderBy(x => x.SortOrder))
                        {
                            <div class="link-item-row" draggable="true" data-id="@l.Id">
                                <div class="link-row-top" style="display: flex; align-items: center; gap: 8px;">
                                    <!-- 🚀 РУЧКА ПЕРЕТАСКИВАНИЯ (GRIP) -->
                                    <span class="drag-handle" title="Перетащите мышкой">⠿</span>

                                    <select class="text-input link-icon-select" style="width: 110px; padding: 6px 8px; font-size: 0.82rem;" onchange="updateLivePreview()">
                                        <option value="telegram" selected="@(l.IconType == "telegram")">✈️ Telegram</option>
                                        <option value="instagram" selected="@(l.IconType == "instagram")">📸 Instagram</option>
                                        <option value="youtube" selected="@(l.IconType == "youtube")">🎬 YouTube</option>
                                        <option value="bluesky" selected="@(l.IconType == "bluesky")">🦋 BlueSky</option>
                                        <option value="threads" selected="@(l.IconType == "threads")">🧵 Threads</option>
                                        <option value="x" selected="@(l.IconType == "x")">✖️ X</option>
                                        <option value="facebook" selected="@(l.IconType == "facebook")">📘 Facebook</option>
                                        <option value="custom" selected="@(l.IconType == "custom")">🔗 Ссылка</option>
                                    </select>
                                    <input type="text" class="text-input link-title-input" value="@l.Title" placeholder="Название кнопки" style="flex: 1; padding: 6px 10px; font-weight: 700;" oninput="updateLivePreview()">
                                </div>
                                <div style="display: flex; gap: 8px;">
                                    <input type="url" class="text-input link-url-input" value="@l.Url" placeholder="https://..." style="flex: 1; padding: 6px 10px; font-size: 0.85rem;" oninput="updateLivePreview()">
                                </div>
                                <div class="link-row-actions">
                                    <label style="display: flex; align-items: center; gap: 5px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.78rem;">
                                        <input type="checkbox" class="link-highlight-cb" checked="@l.IsHighlighted" onchange="updateLivePreview()" style="accent-color: #38bdf8;">
                                        ⭐ Свечение (Главная)
                                    </label>

                                    <!-- 🚀 КНОПКИ СТРЕЛОЧЕК ДЛЯ МОБИЛКЕ -->
                                    <div class="reorder-btns-mobile">
                                        <button type="button" onclick="moveLinkRow(this, -1)" style="background: rgba(255,255,255,0.08); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 6px; padding: 2px 6px; cursor: pointer; font-size: 0.75rem;">⬆️</button>
                                        <button type="button" onclick="moveLinkRow(this, 1)" style="background: rgba(255,255,255,0.08); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 6px; padding: 2px 6px; cursor: pointer; font-size: 0.75rem;">⬇️</button>
                                    </div>

                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <span style="color: var(--text-secondary); font-size: 0.75rem;">Кликов: <strong>@l.ClicksCount</strong></span>
                                        <button type="button" onclick="removeLinkRow(this)" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1rem; line-height: 1;">🗑️</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- КНОПКА СОХРАНЕНИЯ -->
                <button type="button" class="btn btn-primary" id="btnSaveBio" onclick="saveBioPage()" style="margin-top: 1.5rem; padding: 14px; font-size: 1rem;">
                    💾 Сохранить изменения
                </button>
            </form>
        </div>

        <!-- ========================================================== -->
        <!-- ПРАВАЯ КОЛОНКА: ЖИВОЙ МАКЕТ СМАРТФОНА IPHONE               -->
        <!-- ========================================================== -->
        <div class="phone-wrapper">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                <span>📱</span> Живой просмотр на смартфоне
            </div>
            <div class="phone-frame">
                <div class="phone-notch"></div>
                <div class="phone-screen" id="previewScreen" style="background: @(Model.ThemeType == "custom-image" && !string.IsNullOrEmpty(Model.CustomBackgroundValue) ? $"url('{Model.CustomBackgroundValue}')" : Model.CustomBackgroundValue);">
                    <img id="previewAvatarImg" src="@(Model.AvatarUrl ?? "/images/placeholder.jpg")" class="preview-avatar" alt="Avatar">
                    <h3 id="previewTitleText" class="preview-title">@Model.Title</h3>
                    <p id="previewBioText" class="preview-bio">@Model.Bio</p>

                    <div id="previewLinksContainer" class="preview-links">
                        <!-- Сюда JS рисует живые кнопки -->
                    </div>

                    <div style="margin-top: auto; padding-top: 2rem; font-size: 0.65rem; opacity: 0.5;">
                        ⚡ Powered by CrossChat
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let currentBgValue = "@(Model.CustomBackgroundValue ?? "linear-gradient(180deg, #0f172a 0%, #1e293b 100%)")";

        document.addEventListener('DOMContentLoaded', () => {
            updateLivePreview();
        });

        // 1. ПЕРЕКЛЮЧЕНИЕ ТЕМЫ ФОНА
        function selectTheme(themeName, bgValue, pillElem) {
            document.querySelectorAll('.theme-pill').forEach(p => p.classList.remove('active'));
            pillElem.classList.add('active');

            document.getElementById('selectedThemeInput').value = themeName;
            document.getElementById('customBgValueInput').value = bgValue;
            document.getElementById('bgUploadBox').style.display = 'none';

            currentBgValue = bgValue;
            document.getElementById('previewScreen').style.background = bgValue;
        }

        function selectCustomTheme(pillElem) {
            document.querySelectorAll('.theme-pill').forEach(p => p.classList.remove('active'));
            pillElem.classList.add('active');

            document.getElementById('selectedThemeInput').value = 'custom-image';
            document.getElementById('bgUploadBox').style.display = 'block';
        }

        // 2. ПРЕДПРОСМОТР ЗАГРУЖЕННЫХ ФАЙЛОВ
        function previewAvatarUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    document.getElementById('previewAvatarImg').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewBackgroundUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    currentBgValue = `url('${e.target.result}')`;
                    document.getElementById('previewScreen').style.background = currentBgValue;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 3. ДОБАВЛЕНИЕ НОВОЙ СТРОКИ ССЫЛКИ
        function addNewLinkRow() {
             const container = document.getElementById('linksListContainer');
             const row = document.createElement('div');
             row.className = 'link-item-row';
             row.setAttribute('draggable', 'true'); // 🚀 Включаем поддержку Drag & Drop для новой строки
             row.dataset.id = "0";
             row.innerHTML = `
                 <div class="link-row-top" style="display: flex; align-items: center; gap: 8px;">
                     <!-- 🚀 Ручка перетаскивания -->
                     <span class="drag-handle" title="Перетащите мышкой">⠿</span>

                     <select class="text-input link-icon-select" style="width: 120px; padding: 6px 8px; font-size: 0.82rem;" onchange="updateLivePreview()">
                         <option value="telegram">✈️ Telegram</option>
                         <option value="instagram">📸 Instagram</option>
                         <option value="youtube">🎬 YouTube</option>
                         <option value="bluesky">🦋 BlueSky</option>
                         <option value="threads">🧵 Threads</option>
                         <option value="x">✖️ X</option>
                         <option value="facebook">📘 Facebook</option>
                         <option value="custom" selected>🔗 Ссылка</option>
                     </select>
                     <input type="text" class="text-input link-title-input" placeholder="Название кнопки" style="flex: 1; padding: 6px 10px; font-weight: 700;" oninput="updateLivePreview()">
                 </div>
                 <div style="display: flex; gap: 8px;">
                     <input type="url" class="text-input link-url-input" placeholder="https://..." style="flex: 1; padding: 6px 10px; font-size: 0.85rem;" oninput="updateLivePreview()">
                 </div>
                 <div class="link-row-actions">
                     <label style="display: flex; align-items: center; gap: 5px; cursor: pointer; margin: 0; text-transform: none; font-size: 0.78rem;">
                         <input type="checkbox" class="link-highlight-cb" onchange="updateLivePreview()" style="accent-color: #38bdf8;">
                         ⭐ Свечение (Главная ссылка)
                     </label>

                     <!-- 🚀 Кнопки стрелочек для мобильных устройств -->
                     <div class="reorder-btns-mobile">
                         <button type="button" onclick="moveLinkRow(this, -1)" style="background: rgba(255,255,255,0.08); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 6px; padding: 2px 6px; cursor: pointer; font-size: 0.75rem;">⬆️</button>
                         <button type="button" onclick="moveLinkRow(this, 1)" style="background: rgba(255,255,255,0.08); border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 6px; padding: 2px 6px; cursor: pointer; font-size: 0.75rem;">⬇️</button>
                     </div>

                     <div style="display: flex; gap: 8px; align-items: center;">
                         <span style="color: var(--text-secondary); font-size: 0.75rem;">Кликов: <strong>0</strong></span>
                         <button type="button" onclick="removeLinkRow(this)" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1rem; line-height: 1;">🗑️</button>
                     </div>
                 </div>
             `;
             container.appendChild(row);
             updateLivePreview();
         }

        function removeLinkRow(btn) {
            btn.closest('.link-item-row').remove();
            updateLivePreview();
        }

        // 4. ЖИВОЕ ОБНОВЛЕНИЕ ПРЕВЬЮ НА ЭКРАНЕ IPHONE
        function updateLivePreview() {
             document.getElementById('previewTitleText').textContent = document.getElementById('titleInput').value || 'Имя профиля';
             document.getElementById('previewBioText').textContent = document.getElementById('bioInput').value || '';

             // Считываем выбранный пользователем цвет подсветки
             const highlightColorInput = document.getElementById('highlightColorInput');
             const highlightColor = highlightColorInput ? highlightColorInput.value : '#38bdf8';

             const previewContainer = document.getElementById('previewLinksContainer');
             previewContainer.innerHTML = '';

             const rows = document.querySelectorAll('.link-item-row');
             rows.forEach(r => {
                 let title = r.querySelector('.link-title-input').value.trim();
                 const icon = r.querySelector('.link-icon-select').value;
                 const isHighlight = r.querySelector('.link-highlight-cb').checked;

                 if (!title) return;

                 // 🚀 АВТОМАТИЧЕСКАЯ ОЧИСТКА: убираем старые эмодзи в начале названия, если они были
                 title = title.replace(/^[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\s]+/u, '');

                 const iconSvg = getNetworkBrandSvg(icon);
                 const btn = document.createElement('div');
                 btn.className = `preview-btn ${isHighlight ? 'highlighted' : ''}`;

                 // Динамически применяем цвет свечения, если кнопка выделена
                 if (isHighlight) {
                     btn.style.borderColor = highlightColor;
                     btn.style.boxShadow = `0 0 16px ${highlightColor}88`; // Добавляем прозрачность к тени
                 } else {
                     btn.style.borderColor = '';
                     btn.style.boxShadow = '';
                 }

                 btn.innerHTML = `
                     <div class="brand-icon-badge">${iconSvg}</div>
                     <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; text-align:left;">${escapeHtml(title)}</span>
                     <span style="opacity:0.4; font-size:0.9rem;">➔</span>
                 `;
                 previewContainer.appendChild(btn);
             });
        }

        // 🚀 ГЕНЕРАТОР ОФИЦИАЛЬНЫХ БРЕНДОВЫХ SVG ИКОНОК
        function getNetworkBrandSvg(type) {
            switch(type) {
