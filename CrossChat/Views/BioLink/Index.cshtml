        }

        function getIconEmoji(type) {
            switch(type) {
                case 'telegram': return '✈️';
                case 'instagram': return '📸';
                case 'youtube': return '🎬';
                case 'bluesky': return '🦋';
                case 'threads': return '🧵';
                case 'x': return '✖️';
                case 'facebook': return '📘';
                default: return '🔗';
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        function onSlugChanged(val) {
            val = val.toLowerCase().replace(/[^a-z0-9\-_]/g, '');
            document.getElementById('slugInput').value = val;
        }

        function copyPublicUrl(url, btn) {
            navigator.clipboard.writeText(url).then(() => {
                const old = btn.textContent;
                btn.textContent = '✅ Скопировано!';
                setTimeout(() => btn.textContent = old, 2000);
            });
        }

        // 5. СОХРАНЕНИЕ ВСЕЙ СТРАНИЦЫ ЧЕРЕЗ AJAX (ПЕРЕДАЧА ЦВЕТА И ID ССЫЛОК)
        async function saveBioPage() {
            const form = document.getElementById('bioForm');
            const btn = document.getElementById('btnSaveBio');
            btn.disabled = true;
            btn.textContent = '⏳ Сохранение...';

            // Собираем ссылки в JSON (считывая ID существующих кнопок)
            const links = [];
            document.querySelectorAll('.link-item-row').forEach(r => {
                const linkId = parseInt(r.dataset.id) || 0;
                const title = r.querySelector('.link-title-input').value.trim();
                const url = r.querySelector('.link-url-input').value.trim();
                const icon = r.querySelector('.link-icon-select').value;
                const isHighlight = r.querySelector('.link-highlight-cb').checked;

                if (title && url) {
                    links.push({
                        id: linkId,
                        title: title,
                        url: url,
                        iconType: icon,
                        isHighlighted: isHighlight,
                        isActive: true
                    });
                }
            });

            document.getElementById('linksJsonHidden').value = JSON.stringify(links);

            const formData = new FormData(form);

            try {
                const res = await fetch('/biolink/save', {
                    method: 'POST',
                    body: formData
                });

                if (res.ok) {
                    alert('✅ Страница-переходник успешно сохранена!');
                    location.reload();
                } else {
                    const err = await res.text();
                    alert('Ошибка: ' + err);
                }
            } catch {
                alert('Сетевая ошибка при сохранении');
            } finally {
                btn.disabled = false;
                btn.textContent = '💾 Сохранить изменения';
            }
        }

        // ==========================================================
        // 🚀 ЛОГИКА ПЕРЕМЕЩЕНИЯ ССЫЛОК (DRAG & DROP + КНОПКИ СТРЕЛОЧЕК)
        // ==========================================================
        let draggedRow = null;

        document.addEventListener('DOMContentLoaded', () => {
            updateLivePreview();
            initDragAndDrop();
        });

        function initDragAndDrop() {
            const container = document.getElementById('linksListContainer');
            if (!container) return;

            container.addEventListener('dragstart', (e) => {
                const row = e.target.closest('.link-item-row');
                if (!row) return;
                draggedRow = row;
                e.dataTransfer.effectAllowed = 'move';
                setTimeout(() => row.classList.add('dragging'), 0);
            });

            container.addEventListener('dragend', (e) => {
                const row = e.target.closest('.link-item-row');
                if (row) row.classList.remove('dragging');
                draggedRow = null;
                updateLivePreview(); // Перерисовываем живое превью в новом порядке
            });

            container.addEventListener('dragover', (e) => {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                const container = document.getElementById('linksListContainer');
                const afterElement = getDragAfterElement(container, e.clientY);
                if (draggedRow) {
                    if (afterElement == null) {
                        container.appendChild(draggedRow);
                    } else {
                        container.insertBefore(draggedRow, afterElement);
                    }
                }
            });
        }

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.link-item-row:not(.dragging)')];

            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        // Моментальное перемещение стрелочками (для мобильных телефонов)
        function moveLinkRow(btn, direction) {
            const row = btn.closest('.link-item-row');
            if (!row) return;

            if (direction === -1) {
                const prev = row.previousElementSibling;
                if (prev) {
                    row.parentNode.insertBefore(row, prev);
                }
            } else if (direction === 1) {
                const next = row.nextElementSibling;
                if (next) {
                    row.parentNode.insertBefore(next, row);
                }
            }
            updateLivePreview(); // Обновляем превью
        }
    </script>
}