@model List<CrossChat.Data.Entities.ViralPost>
@{
    ViewData["Title"] = "Радар трендов Instagram";
    bool isConnected = ViewBag.IsConnected == true;
    var tags = ViewBag.Tags as List<CrossChat.Data.Entities.TrackedHashtag> ?? new();
    int? selectedTagId = ViewBag.SelectedTagId;
    string mediaFilter = ViewBag.MediaFilter as string ?? "all";
}

@section Styles {
    <style>
        .trends-container {
            max-width: 1200px;
            margin: 5rem auto 3rem;
            padding: 0 1rem;
        }

        .header-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 1.75rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
        }

        .connection-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 1.5rem;
        }

        .connection-banner.warning {
            background: rgba(234, 179, 8, 0.1);
            border-color: rgba(234, 179, 8, 0.3);
        }

        /* ЧИПСЫ ХЕШТЕГОВ */
        .tags-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .tag-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            color: var(--text-secondary);
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            transition: all 0.2s ease;
        }

        .tag-chip:hover, .tag-chip.active {
            background: var(--accent-color);
            color: #ffffff;
            border-color: var(--accent-color);
            transform: translateY(-1px);
        }

        .tag-chip .badge-count {
            background: rgba(0,0,0,0.25);
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 0.75rem;
        }

        /* СЕТКА ВИРУСНЫХ ПОСТОВ */
        .viral-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .viral-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
        }

        .viral-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.3);
            border-color: rgba(99, 102, 241, 0.4);
        }

        .media-preview-box {
            width: 100%;
            aspect-ratio: 1;
            position: relative;
            background: rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .media-preview-box img, .media-preview-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .media-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(15, 23, 42, 0.85);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
        }

        .card-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 10px;
        }

        .stats-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.9rem;
            font-weight: 700;
        }

        .caption-text {
            font-size: 0.85rem;
            line-height: 1.4;
            color: var(--text-main);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .tags-container {
            font-size: 0.8rem;
            color: var(--accent-color);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            background: rgba(99, 102, 241, 0.05);
            padding: 6px 8px;
            border-radius: 6px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-copy-tags {
            background: rgba(99, 102, 241, 0.15);
            color: var(--accent-color);
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

        .btn-copy-tags:hover {
            background: var(--accent-color);
            color: #ffffff;
        }

        .btn-insta-link {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--glass-border);
        }

        .btn-insta-link:hover {
            background: rgba(255, 255, 255, 0.15);
        }
    </style>
}

<div class="trends-container">

    <!-- СТАТУС СВЯЗКИ -->
    @if (isConnected)
    {
        <div class="connection-banner">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.5rem;">✅</span>
                <div>
                    <strong style="color: #10b981; font-size: 0.95rem;">Связка активна!</strong>
                    <div style="font-size: 0.8rem; color: var(--text-secondary);">
                        Страница FB: <strong>@ViewBag.ConnectedPageName</strong> ➔ Instagram Business ID: <code>@ViewBag.ConnectedIgId</code>
                    </div>
                </div>
            </div>
            <form action="/trends/check-link" method="post" style="margin: 0;">
                <button type="submit" class="btn-action btn-insta-link" style="font-size: 0.8rem;">
                    🔄 Перепроверить связку
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="connection-banner warning">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.5rem;">⚠️</span>
                <div>
                    <strong style="color: #fbbf24; font-size: 0.95rem;">Связка Facebook + Instagram не обнаружена</strong>
                    <div style="font-size: 0.8rem; color: var(--text-secondary);">
                        Подключите Instagram к вашей странице Facebook в приложении Instagram (Редактировать профиль ➔ Страница).
                    </div>
                </div>
            </div>
            <form action="/trends/check-link" method="post" style="margin: 0;">
                <button type="submit" class="btn-action" style="background: #eab308; color: #000; font-weight: 700;">
                    🔄 Проверить привязку сейчас
                </button>
            </form>
        </div>
    }

    <!-- ЗАГОЛОВОК И ДОБАВЛЕНИЕ ТЕГА -->
    <div class="header-card">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 1.5rem;">
            <div>
                <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
                    🔥 Радар трендов Instagram
                </h1>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 4px 0 0 0;">
                    Отслеживание самых вирусных публикаций и сопутствующих хештегов в вашей нише
                </p>
            </div>

            <!-- ФОРМА ДОБАВЛЕНИЯ ТЕГА -->
            <form action="/trends/add-tag" method="post" style="display: flex; gap: 8px; margin: 0;">
                <input type="text" name="tag" placeholder="#хештег (напр. fitness)" required
                       class="text-input" style="width: 220px; padding: 8px 12px; margin: 0;">
                <button type="submit" class="btn-action" style="background: var(--accent-color); color: white;" @(isConnected ? "" : "disabled")>
                    + Отслеживать
                </button>
            </form>
        </div>

        <!-- ЧИПСЫ ТЕГОВ (ФИЛЬТРЫ) -->
        <div class="tags-bar">
            <a href="/trends?mediaFilter=@mediaFilter" class="tag-chip @(!selectedTagId.HasValue ? "active" : "")">
                Все посты <span class="badge-count">@Model.Count</span>
            </a>

            @foreach (var t in tags)
            {
                <div style="display: inline-flex; align-items: center; position: relative;">
                    <a href="/trends?tagId=@t.Id&mediaFilter=@mediaFilter" class="tag-chip @(selectedTagId == t.Id ? "active" : "")" style="padding-right: 32px;">
                        #@t.Tag <span class="badge-count">@t.Posts.Count</span>
                    </a>
                    <!-- Меню управления тегом (удалить) -->
                    <form action="/trends/delete-tag/@t.Id" method="post" onsubmit="return confirm('Удалить хештег #@t.Tag и все его посты?');" style="position: absolute; right: 8px; margin: 0;">
                        <button type="submit" style="background: none; border: none; color: rgba(255,255,255,0.4); cursor: pointer; font-size: 12px; padding: 2px;">
                            &times;
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- ФИЛЬТР ПО ТИПУ МЕДИА -->
        @if (selectedTagId.HasValue)
        {
            var currentTag = tags.FirstOrDefault(t => t.Id == selectedTagId.Value);
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--glass-border); padding-top: 12px; font-size: 0.85rem;">
                <div style="color: var(--text-secondary);">
                    Последнее обновление: <strong>@(currentTag?.LastSyncedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Еще не было")</strong>
                </div>
                <div style="display: flex; gap: 8px;">
                    <form action="/trends/sync-tag/@selectedTagId.Value" method="post" style="margin: 0;">
                        <button type="submit" class="btn-action btn-insta-link" style="font-size: 0.8rem;">
                            ⚡ Обновить посты сейчас
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- СЕТКА ПОСТОВ -->
    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 4rem 1rem; color: var(--text-secondary); background: var(--card-bg); border-radius: 20px; border: 1px dashed var(--glass-border);">
            <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
            <h3>Постов пока нет</h3>
            <p style="font-size: 0.9rem; max-width: 400px; margin: 0 auto;">
                @(isConnected ? "Добавьте хештег выше, чтобы радар нашел топ вирусных публикаций." : "Сначала подтвердите связку Facebook и Instagram.")
            </p>
        </div>
    }
    else
    {
        <div class="viral-grid">
            @foreach (var post in Model)
            {
                <div class="viral-card">
                    <!-- ПРЕВЬЮ -->
                    <div class="media-preview-box">
                        @if (post.MediaType == "VIDEO")
                        {
                            <span class="media-badge">▶ ВИДЕО</span>
                        }
                        @if (!string.IsNullOrEmpty(post.MediaUrl))
                        {
                            <img src="@post.MediaUrl" alt="Post media" loading="lazy" onerror="this.src='/images/placeholder.jpg';" />
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--text-secondary);">
                                📷 Без превью
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        <!-- СТАТИСТИКА -->
                        <div class="stats-row">
                            <span style="color: #ef4444;">❤️ @post.LikeCount.ToString("N0")</span>
                            <span style="color: #38bdf8;">💬 @post.CommentsCount.ToString("N0")</span>
                        </div>

                        <!-- ОПИСАНИЕ -->
                        @if (!string.IsNullOrEmpty(post.Caption))
                        {
                            <div class="caption-text" title="@post.Caption">
                                @post.Caption
                            </div>
                        }

                        <!-- НАЙДЕННЫЕ ХЕШТЕГИ -->
                        @if (!string.IsNullOrEmpty(post.ExtractedHashtags))
                        {
                            <div class="tags-container" title="@post.ExtractedHashtags">
                                @post.ExtractedHashtags
                            </div>
                        }

                        <!-- КНОПКИ ДЕЙСТВИЯ -->
                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: auto;">
                            @if (!string.IsNullOrEmpty(post.ExtractedHashtags))
                            {
                                <button type="button" class="btn-action btn-copy-tags" onclick="copyHashtags('@post.ExtractedHashtags', this)">
                                    📋 Скопировать теги
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(post.Permalink))
                            {
                                <a href="@post.Permalink" target="_blank" class="btn-action btn-insta-link" title="Открыть в Instagram">
                                    🔗
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyHashtags(tags, btn) {
            navigator.clipboard.writeText(tags).then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '✅ Скопировано!';
                btn.style.background = '#10b981';
                btn.style.color = '#ffffff';
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = '';
                    btn.style.color = '';
                }, 2000);
            });
        }
    </script>
}