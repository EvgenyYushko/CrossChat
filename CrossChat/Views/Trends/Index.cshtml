@model List<CrossChat.Data.Entities.ViralPost>
@{
    ViewData["Title"] = "Радар трендов Instagram";
    bool isConnected = ViewBag.IsConnected == true;
    var tags = ViewBag.Tags as List<CrossChat.Data.Entities.TrackedHashtag> ?? new();
    int? selectedTagId = ViewBag.SelectedTagId;
    string mediaFilter = ViewBag.MediaFilter as string ?? "all";
}

@section Styles {
    <style>
        .trends-container {
            max-width: 1200px;
            margin: 5rem auto 3rem;
            padding: 0 1rem;
        }

        .header-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 1.75rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
        }

        .connection-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 1.5rem;
            gap: 12px;
        }

            .connection-banner.warning {
                background: rgba(234, 179, 8, 0.1);
                border-color: rgba(234, 179, 8, 0.3);
            }

        /* ШАПКА И ФОРМА */
        .header-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 1.5rem;
        }

        .add-tag-form {
            display: flex;
            gap: 8px;
            margin: 0;
        }

        /* ЧИПСЫ ХЕШТЕГОВ */
        .tags-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .tag-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            color: var(--text-secondary);
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            transition: all 0.2s ease;
        }

            .tag-chip:hover, .tag-chip.active {
                background: var(--accent-color);
                color: #ffffff;
                border-color: var(--accent-color);
                transform: translateY(-1px);
            }

            .tag-chip .badge-count {
                background: rgba(0,0,0,0.25);
                padding: 2px 6px;
                border-radius: 10px;
                font-size: 0.75rem;
            }

        /* СЕТКА ВИРУСНЫХ ПОСТОВ */
        .viral-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .viral-card {
            background: var(--card-bg, #1e293b);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
        }

            .viral-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.3);
                border-color: rgba(99, 102, 241, 0.4);
            }

        .media-preview-box {
            width: 100%;
            aspect-ratio: 1;
            position: relative;
            background: rgba(0,0,0,0.3);
            overflow: hidden;
        }

            .media-preview-box img, .media-preview-box video {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .media-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(15, 23, 42, 0.85);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
        }

        .card-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 10px;
        }

        .stats-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .caption-text {
            font-size: 0.85rem;
            line-height: 1.4;
            color: var(--text-main);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .tags-container {
            font-size: 0.8rem;
            color: var(--accent-color);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            background: rgba(99, 102, 241, 0.05);
            padding: 6px 8px;
            border-radius: 6px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
            box-sizing: border-box;
        }

        .btn-copy-tags {
            background: rgba(99, 102, 241, 0.15);
            color: var(--accent-color);
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

            .btn-copy-tags:hover {
                background: var(--accent-color);
                color: #ffffff;
            }

        .btn-insta-link {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--glass-border);
        }

            .btn-insta-link:hover {
                background: rgba(255, 255, 255, 0.15);
            }

        /* === МОБИЛЬНАЯ АДАПТАЦИЯ (ЭКРАНЫ ДО 650px) === */
        @@media (max-width: 650px) {
            .trends-container {
                margin: 4.5rem auto 2rem;
                padding: 0 0.75rem;
            }

            .header-card {
                padding: 1.25rem;
                border-radius: 16px;
            }

            .connection-banner {
                flex-direction: column;
                align-items: stretch;
                text-align: left;
            }

                .connection-banner form {
                    width: 100%;
                }

                .connection-banner button {
                    width: 100%;
                    margin-top: 6px;
                }

            .header-top-row {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

            .add-tag-form {
                flex-direction: column;
                width: 100%;
            }

                .add-tag-form input {
                    width: 100% !important;
                }

                .add-tag-form button {
                    width: 100%;
                    padding: 10px;
                }

            .tags-bar {
                gap: 6px;
            }

            .tag-chip {
                font-size: 0.8rem;
                padding: 6px 12px;
            }
            /* Сетка постов в 1 колонку на мобильном */
            .viral-grid {
                grid-template-columns: 1fr !important;
                gap: 16px;
            }

            .card-bottom-actions {
                flex-direction: column;
            }

            .tag-info-bar {
                flex-direction: column;
                align-items: stretch !important;
                gap: 10px;
            }

                .tag-info-bar form, .tag-info-bar button {
                    width: 100%;
                }
        }
    </style>
}

@section NavbarActions {
    @{
        var network = Context.Request.Query["network"].ToString();
        var botId = Context.Request.Query["botId"].ToString();
        var profileId = Context.Request.Query["profileId"].ToString();

        string backUrl;
        string backText;

        if (!string.IsNullOrEmpty(network) && !string.IsNullOrEmpty(botId))
        {
            backText = $"← Назад";
            backUrl = network switch
            {
                "Instagram" => $"/instagram?botId={botId}",
                "Facebook" => $"/facebook?botId={botId}",
                _ => $"/profile?profileId={profileId}"
            };
        }
        else if (!string.IsNullOrEmpty(profileId) && profileId != "0")
        {
            backText = "← Назад";
            backUrl = $"/profile?profileId={profileId}";
        }
        else
        {
            backText = "← Все профили";
            backUrl = "/profiles";
        }
    }

    <a href="@backUrl" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem; transition: color 0.2s;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-secondary)'">
        @backText
    </a>
}

<div class="trends-container">

    <!-- СТАТУС СВЯЗКИ -->
    @if (isConnected)
    {
        <div class="connection-banner">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.4rem; flex-shrink: 0;">✅</span>
                <div>
                    <strong style="color: #10b981; font-size: 0.9rem;">Связка активна!</strong>
                    <div style="font-size: 0.75rem; color: var(--text-secondary); word-break: break-all;">
                        Страница: <strong>@ViewBag.ConnectedPageName</strong> ➔ Instagram ID: <code>@ViewBag.ConnectedIgId</code>
                    </div>
                </div>
            </div>
            <form action="/trends/check-link" method="post">
                <button type="submit" class="btn-action btn-insta-link">
                    🔄 Перепроверить
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="connection-banner warning">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.4rem; flex-shrink: 0;">⚠️</span>
                <div>
                    <strong style="color: #fbbf24; font-size: 0.9rem;">Связка не обнаружена</strong>
                    <div style="font-size: 0.75rem; color: var(--text-secondary);">
                        Свяжите Instagram со страницей Facebook в настройках профиля Instagram.
                    </div>
                </div>
            </div>
            <form action="/trends/check-link" method="post">
                <button type="submit" class="btn-action" style="background: #eab308; color: #000; font-weight: 700;">
                    🔄 Проверить привязку сейчас
                </button>
            </form>
        </div>
    }

    <!-- ШАПКА И ФОРМА ДОБАВЛЕНИЯ -->
    <div class="header-card">
        <div class="header-top-row">
            <div>
                <h1 style="font-size: 1.4rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
                    🔥 Радар трендов Instagram
                </h1>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 4px 0 0 0;">
                    Вирусные публикации и теги вашей ниши
                </p>
            </div>

            <!-- ФОРМА ДОБАВЛЕНИЯ ТЕГА -->
            <form action="/trends/add-tag" method="post" class="add-tag-form">
                <input type="text" name="tag" placeholder="#хештег (напр. fitness)" required
                       class="text-input" style="width: 200px; padding: 8px 12px; margin: 0;">
                <button type="submit" class="btn-action" style="background: var(--accent-color); color: white;" @(isConnected ? "" : "disabled")>
                    + Отслеживать
                </button>
            </form>
        </div>

        <!-- ЧИПСЫ ТЕГОВ -->
        <div class="tags-bar">
            <a href="/trends?mediaFilter=@mediaFilter" class="tag-chip @(!selectedTagId.HasValue ? "active" : "")">
                Все посты <span class="badge-count">@Model.Count</span>
            </a>

            @foreach (var t in tags)
            {
                <div style="display: inline-flex; align-items: center; position: relative;">
                    <a href="/trends?tagId=@t.Id&mediaFilter=@mediaFilter" class="tag-chip @(selectedTagId == t.Id ? "active" : "")" style="padding-right: 28px;">
                        #@t.Tag <span class="badge-count">@t.Posts.Count</span>
                    </a>
                    <!-- Удалить тег -->
                    <form action="/trends/delete-tag/@t.Id" method="post" onsubmit="return confirm('Удалить хештег #@t.Tag и все его посты?');" style="position: absolute; right: 6px; margin: 0;">
                        <button type="submit" style="background: none; border: none; color: rgba(255,255,255,0.4); cursor: pointer; font-size: 14px; padding: 2px;">
                            &times;
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- ИНФО-ПАНЕЛЬ ВЫБРАННОГО ТЕГА -->
        @if (selectedTagId.HasValue)
        {
            var currentTag = tags.FirstOrDefault(t => t.Id == selectedTagId.Value);
            <div class="tag-info-bar" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--glass-border); padding-top: 12px; font-size: 0.85rem;">
                <div style="color: var(--text-secondary);">
                    Обновлено: <strong>@(currentTag?.LastSyncedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Еще не было")</strong>
                </div>
                <div>
                    <form action="/trends/sync-tag/@selectedTagId.Value" method="post" style="margin: 0;">
                        <button type="submit" class="btn-action btn-insta-link" style="font-size: 0.8rem;">
                            ⚡ Обновить посты сейчас
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- СЕТКА ПОСТОВ -->
    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 3rem 1rem; color: var(--text-secondary); background: var(--card-bg); border-radius: 20px; border: 1px dashed var(--glass-border);">
            <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📭</div>
            <h3 style="margin: 0 0 6px 0;">Постов пока нет</h3>
            <p style="font-size: 0.85rem; max-width: 350px; margin: 0 auto;">
                @(isConnected ? "Добавьте хештег выше, чтобы радар нашел топовые публикации." : "Сначала подтвердите связку Facebook и Instagram.")
            </p>
        </div>
    }
    else
    {
        <div class="viral-grid">
            @foreach (var post in Model)
            {
                <div class="viral-card">
                    <!-- ПРЕВЬЮ -->
                    <div class="media-preview-box">
                        @if (post.MediaType == "VIDEO")
                        {
                            <span class="media-badge">▶ ВИДЕО</span>
                        }
                        @if (!string.IsNullOrEmpty(post.MediaUrl))
                        {
                            <img src="@post.MediaUrl" alt="Post media" loading="lazy" onerror="this.src='/images/placeholder.jpg';" />
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--text-secondary);">
                                📷 Без превью
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        <!-- СТАТИСТИКА -->
                        <div class="stats-row">
                            <span style="color: #ef4444;">❤️ @post.LikeCount.ToString("N0")</span>
                            <span style="color: #38bdf8;">💬 @post.CommentsCount.ToString("N0")</span>
                        </div>

                        <!-- ОПИСАНИЕ -->
                        @if (!string.IsNullOrEmpty(post.Caption))
                        {
                            <div class="caption-text" title="@post.Caption">
                                @post.Caption
                            </div>
                        }

                        <!-- НАЙДЕННЫЕ ХЕШТЕГИ -->
                        @if (!string.IsNullOrEmpty(post.ExtractedHashtags))
                        {
                            <div class="tags-container" title="@post.ExtractedHashtags">
                                @post.ExtractedHashtags
                            </div>
                        }

                        <!-- КНОПКИ ДЕЙСТВИЯ -->
                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: auto; padding-top: 6px;">
                            @if (!string.IsNullOrEmpty(post.ExtractedHashtags))
                            {
                                <button type="button" class="btn-action btn-copy-tags" onclick="copyHashtags('@post.ExtractedHashtags', this)">
                                    📋 Скопировать теги
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(post.Permalink))
                            {
                                <a href="@post.Permalink" target="_blank" class="btn-action btn-insta-link" title="Открыть в Instagram">
                                    🔗
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyHashtags(tags, btn) {
            navigator.clipboard.writeText(tags).then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '✅ Скопировано!';
                btn.style.background = '#10b981';
                btn.style.color = '#ffffff';
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = '';
                    btn.style.color = '';
                }, 2000);
            });
        }
    </script>
}