                }

                // Очищаем галерею картинок и временные массивы файлов
                document.getElementById('imageGallery').innerHTML = '';
                selectedFiles = [];
                existingImages = [];
                syncFileInput();

                // Сбрасываем предупреждение, чекбокс "Один текст" и кастомные текстареа
                document.getElementById('multiPostWarning').style.display = 'none';
