                }
                });
                calendar.render();

                // Инициализация Drag and Drop
                const dropZone = document.getElementById('dropZone');
                const fileInput = document.getElementById('fileInput');

                if (dropZone && fileInput) {
                    // Предотвращение стандартных событий браузера
                    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, e => {
                            e.preventDefault();
                            e.stopPropagation();
                        }, false);
                    });

                    // Подсветка зоны при перетаскивании
                    ['dragenter', 'dragover'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.add('highlight'), false);
                    });

                    ['dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.remove('highlight'), false);
                    });

                    // Обработка сброса файлов (игнорируем, если заблокировано)
                    dropZone.addEventListener('drop', e => {
                        if (isImageEditingLocked) return; // ЗАПРЕЩАЕМ Drag and Drop при блокировке!

                        const dt = e.dataTransfer;
                        const files = dt.files;
                        if (files.length > 0) {
                            for (let i = 0; i < files.length; i++) {
                                selectedFiles.push(files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    }, false);

                    // Обработка стандартного выбора файлов кликом (игнорируем, если заблокировано)
                    fileInput.addEventListener('change', function() {
                        if (isImageEditingLocked) {
                            this.value = ''; // Сбрасываем выбор
                            return; // ЗАПРЕЩАЕМ ручной выбор при блокировке!
                        }

                        if (this.files.length > 0) {
                            for (let i = 0; i < this.files.length; i++) {
                                selectedFiles.push(this.files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    });
                }
            });

            function closeModal() {
                if (isUploading) return; // ЗАПРЕЩАЕМ закрывать окно, если идет отправка файлов!
                modal.style.display = 'none';
            }

            // Открытие полноразмерного просмотра
