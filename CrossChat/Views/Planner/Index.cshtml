            // Функция автоматического преобразования текстовых меток чекбоксов в SVG-иконки
            function initCheckboxIcons() {
                document.querySelectorAll('input[name="selectedNetworks"]').forEach(cb => {
                    const netName = cb.value;
                    const iconHtml = getNetworkIcon(netName);
                    const label = cb.parentElement; // Находим <label>

                    if (label && iconHtml) {
                        const checkbox = cb; // Сохраняем ссылку на чекбокс

                        label.innerHTML = ''; // Очищаем текст внутри label
                        label.appendChild(checkbox); // Возвращаем скрытый чекбокс назад

                        // Создаем круглую подложку с дата-атрибутом мгновенного тултипа
                        const iconWrapper = document.createElement('span');
                        iconWrapper.setAttribute('data-tooltip', netName); // Текст всплывает мгновенно!
                        iconWrapper.innerHTML = iconHtml;

                        label.appendChild(iconWrapper);
                    }
                });
            }
        </script>
