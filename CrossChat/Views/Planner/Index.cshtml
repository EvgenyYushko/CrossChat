                }
                });
                calendar.render();

                // Инициализация Drag and Drop
                const dropZone = document.getElementById('dropZone');
                const fileInput = document.getElementById('fileInput');

                if (dropZone && fileInput) {
                    // Предотвращение стандартных событий браузера
                    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, e => {
                            e.preventDefault();
                            e.stopPropagation();
                        }, false);
                    });

                    // Подсветка зоны при перетаскивании
                    ['dragenter', 'dragover'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.add('highlight'), false);
                    });

                    ['dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.remove('highlight'), false);
                    });

                    // Обработка сброса файлов (игнорируем, если заблокировано)
                    dropZone.addEventListener('drop', e => {
                        if (isImageEditingLocked) return; // ЗАПРЕЩАЕМ Drag and Drop при блокировке!

                        const dt = e.dataTransfer;
                        const files = dt.files;
                        if (files.length > 0) {
                            for (let i = 0; i < files.length; i++) {
                                selectedFiles.push(files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    }, false);

                    // Обработка стандартного выбора файлов кликом (игнорируем, если заблокировано)
                    fileInput.addEventListener('change', function() {
                        if (isImageEditingLocked) {
                            this.value = ''; // Сбрасываем выбор
                            return; // ЗАПРЕЩАЕМ ручной выбор при блокировке!
                        }

                        if (this.files.length > 0) {
                            for (let i = 0; i < this.files.length; i++) {
                                selectedFiles.push(this.files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    });
                }
            });

            function closeModal() {
                if (isUploading) return; // ЗАПРЕЩАЕМ закрывать окно, если идет отправка файлов!
                modal.style.display = 'none';
            }

            // Открытие полноразмерного просмотра
            function openLightbox(src) {
                const lightbox = document.getElementById('imageLightbox');
                const lightboxImg = document.getElementById('lightboxImage');

                lightboxImg.src = src;
                lightbox.style.display = 'flex';

                // Небольшая задержка для корректного срабатывания CSS-анимации transition
                setTimeout(() => {
                    lightbox.classList.add('active');
                }, 10);
            }

            // Закрытие полноразмерного просмотра
            function closeLightbox() {
                const lightbox = document.getElementById('imageLightbox');
                lightbox.classList.remove('active');

                // Ждем окончания анимации перед скрытием элемента
                setTimeout(() => {
                    lightbox.style.display = 'none';
                    document.getElementById('lightboxImage').src = '';
                }, 250);
            }

            // Закрытие по клику на фон
            window.onclick = function(event) {
                if (isUploading) return; // ЗАПРЕЩАЕМ закрывать по фону во время загрузки!
                if (event.target == modal) closeModal();
            }

            // прогрес бар
            // Инициализация перехвата отправки формы после загрузки DOM
            document.addEventListener('DOMContentLoaded', function() {
                const form = document.getElementById('postForm');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault(); // Останавливаем стандартную перезагрузку страницы
                        submitFormWithProgress();
                    });
                }
            });

            // Очистка состояния формы
            function resetModalFormState() {
                isUploading = false;
                isImageEditingLocked = false;

                document.querySelector('.modal-card').classList.remove('uploading');

                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');
                const progressText = document.getElementById('uploadProgressText');

                progressContainer.style.display = 'none';
                progressFill.style.width = '0%';
                progressFill.classList.remove('pulse');
                progressText.textContent = 'Загрузка: 0%';

                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');

                submitBtn.disabled = false;
                cancelBtn.style.display = 'inline-block';

                dateInput.disabled = false;
                document.getElementById('fileInput').disabled = false;

                const fileUploadGroup = document.getElementById('fileUploadGroup');
                if (fileUploadGroup) fileUploadGroup.style.display = 'block';

                const dropZone = document.getElementById('dropZone');
                if (dropZone) {
                    dropZone.style.opacity = '1';
                    dropZone.style.cursor = 'pointer';
                }

                document.getElementById('imageGallery').innerHTML = '';
                selectedFiles = [];
                existingImages = [];
                syncFileInput();

                document.getElementById('multiPostWarning').style.display = 'none';
                document.getElementById('unifiedTextGroup').style.display = 'none';
                document.getElementById('unifiedTextCheckbox').checked = true;

                // Очищаем динамические текстовые поля
                document.getElementById('dynamicCaptions').innerHTML = '';

                const defCaption = document.getElementById('captionInput');
                if (defCaption) {
                    defCaption.required = false;
                }
            }

            /// Функция включения/выключения режима "Один текст для всех"
            function toggleUnifiedTextMode() {
                const isUnified = document.getElementById('unifiedTextCheckbox').checked;
                const defaultGroup = document.getElementById('defaultCaptionGroup');
                const defaultTextarea = document.getElementById('captionInput');
                const dynamicContainer = document.getElementById('dynamicCaptions');

                if (isUnified) {
                    if (defaultGroup) defaultGroup.style.display = 'block';
                    if (defaultTextarea) defaultTextarea.required = true;
                    dynamicContainer.innerHTML = ''; // Стираем все динамические поля
                } else {
                    if (defaultGroup) defaultGroup.style.display = 'none';
                    if (defaultTextarea) defaultTextarea.required = false;

                    const commonText = defaultTextarea ? defaultTextarea.value : "";

                    // Генерируем поля только для выбранных чекбоксами аккаунтов
                    const selectedNets = document.querySelectorAll('input[name="selectedNetworks"]:checked');
                    selectedNets.forEach(cb => {
                        toggleCaptionField(cb.value);
                    });
                }
            }

            // Функция динамического создания/удаления текстовых полей для выбранных ботов
            function toggleCaptionField(netValue) {
                const isUnified = document.getElementById('unifiedTextCheckbox').checked;
                if (isUnified) return; // Если включен единый текст, ничего не создаем

                const cb = document.querySelector(`input[name="selectedNetworks"][value="${netValue}"]`);
                const container = document.getElementById('dynamicCaptions');
            
                const groupId = `captionGroup_${netValue}`;
                const inputId = `captionInput_${netValue}`;

                if (cb && cb.checked) {
                    // Если чекбокс нажат и поля еще нет — создаем его динамически!
                    if (!document.getElementById(groupId)) {
                        const parts = netValue.split('_');
                        const netName = parts[0];
                    
                        const groupDiv = document.createElement('div');
                        groupDiv.className = 'form-group';
                        groupDiv.id = groupId;
                    
                        const label = document.createElement('label');
                        label.style.color = 'var(--accent-color)';
                        label.textContent = `Текст для ${netName} (${cb.parentElement.innerText.trim()})`;
                    
                        const textarea = document.createElement('textarea');
                        textarea.name = `caption_${netValue}`;
                        textarea.id = inputId;
                        textarea.required = true;
                        textarea.placeholder = `Введите уникальный текст для этого аккаунта...`;
                    
                        // Копируем дефолтный текст
                        const commonText = document.getElementById('captionInput').value;
                        textarea.value = commonText;

                        groupDiv.appendChild(label);
                        groupDiv.appendChild(textarea);
                        container.appendChild(groupDiv);
                    }
                } else {
                    // Если галочку сняли — удаляем блок поля из DOM
                    const existingGroup = document.getElementById(groupId);
                    if (existingGroup) {
                        existingGroup.remove();
                    }
                }
            }

            // Отслеживание кликов по чекбоксам соцсетей
            document.addEventListener('change', function(e) {
                if (e.target && e.target.name === 'selectedNetworks') {
                    toggleCaptionField(e.target.value);
                }
            });

            // Функция отправки формы через AJAX с отслеживанием прогресса
            async function submitFormWithProgress() {
                const form = document.getElementById('postForm');

                // --- ВАЛИДАЦИЯ: Проверяем, выбрана ли хотя бы одна соцсеть в режиме All ---
                const currentNetwork = "@ViewBag.Network";
                const selectedNets = form.querySelectorAll('input[name="selectedNetworks"]:checked');

                if (currentNetwork === "All" && selectedNets.length === 0) {
                    alert("Пожалуйста, выберите хотя бы одну социальную сеть для публикации поста!");
                    return; // Прерываем отправку формы намертво!
                }

                // Создаем пустой FormData для ручного наполнения
                const formData = new FormData();
                const url = form.action;

                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');
                const progressText = document.getElementById('uploadProgressText');

                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');
                const deleteBtn = document.getElementById('deleteBtn');

                // АКТИВИРУЕМ БЛОКИРОВКУ (карточка затухает, клики отключаются)
                isUploading = true;
                document.querySelector('.modal-card').classList.add('uploading');

                // Показываем прогресс-бар и скрываем кнопки управления
                progressContainer.style.display = 'block';
                submitBtn.disabled = true;
                deleteBtn.style.display = 'none';
                cancelBtn.style.display = 'none';

                // 1. Копируем стандартные текстовые поля формы в FormData
                formData.append('profileId', form.querySelector('[name="profileId"]').value);
                formData.append('networkType', form.querySelector('[name="networkType"]').value);
                formData.append('showDate', form.querySelector('[name="showDate"]').value);
                formData.append('postId', form.querySelector('[name="postId"]').value);

                const botIdInput = form.querySelector('[name="botId"]');
                if (botIdInput && botIdInput.value) {
                    formData.append('botId', botIdInput.value);
                }

                // Переносим старые сохраненные картинки (keptImages)
                const keptInputs = form.querySelectorAll('[name="keptImages"]');
                keptInputs.forEach(input => formData.append('keptImages', input.value));

                // Переносим выбранные чекбоксы соцсетей
                selectedNets.forEach(cb => formData.append('selectedNetworks', cb.value));

                // Собираем текста постов (в зависимости от режима)
                if (currentNetwork === "All") {
                    const isUnified = document.getElementById('unifiedTextCheckbox').checked;
                    const commonText = document.getElementById('captionInput').value;

                    selectedNets.forEach(cb => {
                        const netName = cb.value;
                        let textValue = "";
                        if (isUnified) {
                            textValue = commonText; // Все соцсети получают один общий текст
                        } else {
                            textValue = document.getElementById(`captionInput_${netName}`).value;
                        }
                        formData.append(`caption_${netName}`, textValue);
                    });
                } else {
                    formData.append('caption', document.getElementById('captionInput').value);
                }

                // Оптимизируем новые картинки
                try {
                    progressFill.style.width = '5%';
                    for (let i = 0; i < selectedFiles.length; i++) {
                        progressText.textContent = `Оптимизация файла ${i + 1} из ${selectedFiles.length}...`;
                        const originalSizeBytes = selectedFiles[i].size;
                        const result = await compressImageOnClient(selectedFiles[i], 1600, 0.8);

                        formData.append('images', result.file);
                        formData.append('originalDimensions', result.originalResolution);
                        formData.append('compressedDimensions', result.compressedResolution);
                        formData.append('originalSizes', originalSizeBytes);
                    }
                } catch (err) {
                    console.error('Ошибка подготовки файлов:', err);
                    alert('Не удалось подготовить изображения.');
                    resetUploadProgress();
                    return;
                }

                // Отправляем
                const xhr = new XMLHttpRequest();
                xhr.open('POST', url, true);

                xhr.upload.onprogress = function(e) {
                    if (e.lengthComputable) {
                        const percentComplete = Math.round((e.loaded / e.total) * 100);
                        if (percentComplete < 100) {
                            progressFill.style.width = percentComplete + '%';
                            progressText.textContent = `Загрузка сжатых файлов: ${percentComplete}% (${formatBytes(e.loaded)} из ${formatBytes(e.total)})`;
                        } else {
                            progressFill.style.width = '100%';
                            progressFill.classList.add('pulse');
                            progressText.textContent = 'Идет сохранение на сервере...';
                        }
                    }
                };

                xhr.onload = function() {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        isUploading = false;
                        document.querySelector('.modal-card').classList.remove('uploading');
                        window.location.href = xhr.responseURL || window.location.href;
                    } else {
                        alert('Ошибка сохранения поста: ' + xhr.statusText);
                        resetUploadProgress();
                    }
                };

                xhr.onerror = function() {
                    alert('Произошла сетевая ошибка.');
                    resetUploadProgress();
                };

                xhr.send(formData);
            }

            // Сброс состояния прогресс-бара в случае ошибки
            function resetUploadProgress() {
                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');

                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');
                const deleteBtn = document.getElementById('deleteBtn');

                // Разблокируем интерфейс
                isUploading = false;
                document.querySelector('.modal-card').classList.remove('uploading');

                progressContainer.style.display = 'none';
                submitBtn.disabled = false;
                cancelBtn.style.display = 'inline-block';
                if (isEditMode) {
                    deleteBtn.style.display = 'block';
                }
                progressFill.style.width = '0%';
                progressFill.classList.remove('pulse');
            }

            // Вспомогательная функция для форматирования байт в понятный вид
            function formatBytes(bytes, decimals = 2) {
                if (bytes === 0) return '0 B';
                const k = 1024;
                const dm = decimals < 0 ? 0 : decimals;
                const sizes = ['B', 'КБ', 'МБ', 'ГБ'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
            }

            // Функция пропорционального сжатия изображения в браузере перед отправкой
            function compressImageOnClient(file, maxDimension = 1600, quality = 0.9) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function(event) {
                        const img = new Image();
                        img.src = event.target.result;
                        img.onload = function() {
                            const canvas = document.createElement('canvas');
                            let width = img.width;
                            let height = img.height;

                            // Запоминаем исходное разрешение
                            const originalResolution = `${width}x${height}`;

                            // Вычисляем пропорции ресайза
                            if (width > maxDimension || height > maxDimension) {
                                if (width > height) {
                                    height = Math.round((height * maxDimension) / width);
                                    width = maxDimension;
                                } else {
                                    width = Math.round((width * maxDimension) / height);
                                    height = maxDimension;
                                }
                            }

                            // Запоминаем сжатое разрешение
                            const compressedResolution = `${width}x${height}`;

                            canvas.width = width;
                            canvas.height = height;

                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);

                            // Конвертируем в JPEG
                            canvas.toBlob((blob) => {
                                if (blob) {
                                    const compressedFile = new File([blob], file.name, {
                                        type: 'image/jpeg',
                                        lastModified: Date.now()
                                    });
                        
                                    // ВОЗВРАЩАЕМ: сжатый файл и оба разрешения текстом
                                    resolve({
                                        file: compressedFile,
                                        originalResolution: originalResolution,
                                        compressedResolution: compressedResolution
                                    });
                                } else {
                                    reject(new Error('Ошибка сжатия'));
                                }
                            }, 'image/jpeg', quality);
                        };
                        img.onerror = () => reject(new Error('Ошибка загрузки изображения'));
                    };
                    reader.onerror = () => reject(new Error('Ошибка чтения файла'));
                });
            }

            // Функция-хелпер для получения красивых SVG-иконок соцсетей
                    // Профессиональная цветная функция-хелпер для получения иконок соцсетей
            function getNetworkIcon(network) {
                const net = (network || '').toLowerCase();

                // 1. Telegram Public & Private (Официальный голубой цвет #2AABEE)
                if (net.includes('telegrampublic') || net.includes('telegramprivate') || net.includes('telegramuserbot')) {
                    return `<svg class="net-icon" viewBox="0 0 24 24" style="color: #2AABEE;"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.74-.4.27-.76.41-1.08.4-.36-.01-1.05-.2-1.56-.37-.63-.2-1.12-.31-1.08-.66.02-.18.3-.37.83-.58 3.27-1.42 5.45-2.36 6.54-2.81 3.1-.12 3.74.03 3.53 1.52z"/></svg>`;
                }

                // 2. Instagram (Векторный градиент с точным совпадением цветов бренда)
                if (net.includes('instagram')) {
                    return `<svg class="net-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <defs>
                            <linearGradient id="instaGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#f09433" />
                                <stop offset="25%" stop-color="#e6683c" />
                                <stop offset="50%" stop-color="#dc2743" />
                                <stop offset="75%" stop-color="#cc2366" />
                                <stop offset="100%" stop-color="#bc1888" />
                            </linearGradient>
                        </defs>
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="url(#instaGrad)"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="url(#instaGrad)"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="url(#instaGrad)"></line>
                    </svg>`;
                }

                // 3. Facebook Pages (Официальный синий цвет #1877F2)
                if (net.includes('facebook')) {
                    return `<svg class="net-icon" viewBox="0 0 24 24" style="color: #1877F2;"><path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
                }

                // 4. X / Twitter (Адаптивный белый/черный цвет под тему сайта)
                if (net.includes('x') || net.includes('twitter')) {
                    return `<svg class="net-icon" viewBox="0 0 24 24" style="color: var(--text-main);" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 7.746 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.286L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
                }

                // 5. Threads (Адаптивный белый/черный цвет под тему сайта)
                if (net.includes('threads')) {
                    return `<img class="net-icon" src="/images/threads.png" alt="Threads" />`;
                }

                // 6. Bluesky (Официальный синий цвет #0085ff)
                if (net.includes('bluesky')) {
                    return `<img class="net-icon" src="/images/bluesky-logo.png" alt="BlueSky" />`;
                }

                // Заглушка по умолчанию (Календарик)
                return `<svg class="net-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>`;
            }

            // Функция автоматического преобразования текстовых меток чекбоксов в SVG-иконки
            function initCheckboxIcons() {
                document.querySelectorAll('input[name="selectedNetworks"]').forEach(cb => {
                    const netName = cb.value;
                    const iconHtml = getNetworkIcon(netName);
                    const label = cb.parentElement; // Находим <label>

                    if (label && iconHtml) {
                        const checkbox = cb; // Сохраняем ссылку на чекбокс

                        label.innerHTML = ''; // Очищаем текст внутри label
                        label.appendChild(checkbox); // Возвращаем скрытый чекбокс назад

                        // Создаем круглую подложку с дата-атрибутом мгновенного тултипа
                        const iconWrapper = document.createElement('span');
                        iconWrapper.setAttribute('data-tooltip', netName); // Текст всплывает мгновенно!
                        iconWrapper.innerHTML = iconHtml;

                        label.appendChild(iconWrapper);
                    }
                });
            }
        </script>
}
