                    const deleteBtn = document.getElementById('deleteBtn');
                    const postForm = document.getElementById('postForm');
                    const postFormOk = document.getElementById('postForm-ok');

                    // 1. Сразу очищаем старые данные и ставим текст "Загрузка..."
                    postIdInput.value = "";
                    dateInput.value = "";
                    captionInput.value = "Загрузка данных постов...";

                    // Показываем красивый текстовый лоадер в галерее
                    gallery.innerHTML = '<div style="color: var(--text-secondary); font-size: 0.9rem; padding: 10px 0;">⏳ Загрузка изображений...</div>';

                    // Сброс массивов перед редактированием
                    selectedFiles = [];
                    existingImages = [];

                    // 2. ОТКРЫВАЕМ МОДАЛКУ МГНОВЕННО, не дожидаясь ответа от сервера!
                    modal.style.display = 'flex';

                    // 3. Запускаем фоновый запрос данных
                    fetch(`/planner/get/${postId}`)
