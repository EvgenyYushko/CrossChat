                if (dropZone && fileInput) {
                    // Предотвращение стандартных событий браузера
                    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, e => {
                            e.preventDefault();
                            e.stopPropagation();
                        }, false);
                    });

                    // Подсветка зоны при перетаскивании
                    ['dragenter', 'dragover'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.add('highlight'), false);
                    });

                    ['dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => dropZone.classList.remove('highlight'), false);
                    });

                    // Обработка сброса файлов
                    dropZone.addEventListener('drop', e => {
                        const dt = e.dataTransfer;
                        const files = dt.files;
                        if (files.length > 0) {
                            for (let i = 0; i < files.length; i++) {
                                selectedFiles.push(files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    }, false);

                    // Обработка стандартного выбора файлов кликом
                    fileInput.addEventListener('change', function() {
                        if (this.files.length > 0) {
                            for (let i = 0; i < this.files.length; i++) {
                                selectedFiles.push(this.files[i]);
                            }
                            syncFileInput();
                            renderGallery();
                        }
                    });
                }
            });

            function closeModal() {
                if (isUploading) return; // ЗАПРЕЩАЕМ закрывать окно, если идет отправка файлов!
                modal.style.display = 'none';
            }

            // Открытие полноразмерного просмотра
            function openLightbox(src) {
                const lightbox = document.getElementById('imageLightbox');
                const lightboxImg = document.getElementById('lightboxImage');

                lightboxImg.src = src;
                lightbox.style.display = 'flex';

                // Небольшая задержка для корректного срабатывания CSS-анимации transition
                setTimeout(() => {
                    lightbox.classList.add('active');
                }, 10);
            }

            // Закрытие полноразмерного просмотра
            function closeLightbox() {
                const lightbox = document.getElementById('imageLightbox');
                lightbox.classList.remove('active');

                // Ждем окончания анимации перед скрытием элемента
                setTimeout(() => {
                    lightbox.style.display = 'none';
                    document.getElementById('lightboxImage').src = '';
                }, 250);
            }

            // Закрытие по клику на фон
            window.onclick = function(event) {
                if (isUploading) return; // ЗАПРЕЩАЕМ закрывать по фону во время загрузки!
                if (event.target == modal) closeModal();
            }

            // прогрес бар
            // Инициализация перехвата отправки формы после загрузки DOM
            document.addEventListener('DOMContentLoaded', function() {
                const form = document.getElementById('postForm');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault(); // Останавливаем стандартную перезагрузку страницы
                        submitFormWithProgress();
                    });
                }
            });

            function resetModalFormState() {
                isUploading = false;
            
                // Убираем блокировку и затухание с карточки
                document.querySelector('.modal-card').classList.remove('uploading');
            
                // Скрываем и сбрасываем полосу прогресса загрузки
                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');
                const progressText = document.getElementById('uploadProgressText');
            
                progressContainer.style.display = 'none';
                progressFill.style.width = '0%';
                progressFill.classList.remove('pulse');
                progressText.textContent = 'Загрузка: 0%';

                // Возвращаем кнопкам формы исходное состояние
                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');
            
                submitBtn.disabled = false;
                cancelBtn.style.display = 'inline-block';

                // Очищаем галерею картинок и временные массивы файлов
                document.getElementById('imageGallery').innerHTML = '';
                selectedFiles = [];
                existingImages = [];
                syncFileInput();
            }

            // Функция отправки формы через AJAX с отслеживанием прогресса
            async function submitFormWithProgress() {
                const form = document.getElementById('postForm');

                // Создаем пустой FormData для ручного наполнения
                const formData = new FormData();
                const url = form.action;

                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');
                const progressText = document.getElementById('uploadProgressText');

                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');
                const deleteBtn = document.getElementById('deleteBtn');

                // АКТИВИРУЕМ БЛОКИРОВКУ (карточка затухает, клики отключаются)
                isUploading = true;
                document.querySelector('.modal-card').classList.add('uploading');

                // Показываем прогресс-бар и скрываем кнопки управления
                progressContainer.style.display = 'block';
                submitBtn.disabled = true;
                deleteBtn.style.display = 'none';
                cancelBtn.style.display = 'none';

                // 1. Копируем стандартные текстовые поля формы в FormData
                formData.append('profileId', form.querySelector('[name="profileId"]').value);
                formData.append('networkType', form.querySelector('[name="networkType"]').value);
                formData.append('caption', form.querySelector('[name="caption"]').value);
                formData.append('showDate', form.querySelector('[name="showDate"]').value);
                formData.append('postId', form.querySelector('[name="postId"]').value);

                // Переносим старые сохраненные картинки (keptImages)
                const keptInputs = form.querySelectorAll('[name="keptImages"]');
                keptInputs.forEach(input => formData.append('keptImages', input.value));

                // 2. Сжимаем файлы прямо на устройстве пользователя перед отправкой по сети
                 try {
                        progressFill.style.width = '5%';
                        for (let i = 0; i < selectedFiles.length; i++) {
                            progressText.textContent = `Оптимизация файла ${i + 1} из ${selectedFiles.length}...`;
                        
                            // Запоминаем истинный размер файла (в байтах) до сжатия
                            const originalSizeBytes = selectedFiles[i].size;

                            const result = await compressImageOnClient(selectedFiles[i], 1600, 0.8);
                    
                            formData.append('images', result.file);
                            // Передаем текстовые разрешения как обычные поля формы
                            formData.append('originalDimensions', result.originalResolution);
                            formData.append('compressedDimensions', result.compressedResolution);
                            formData.append('originalSizes', originalSizeBytes); 
                        }
                    } catch (err) {
                        console.error('Ошибка при подготовке файлов на клиенте:', err);
                        alert('Не удалось подготовить изображения к отправке.');
                        resetUploadProgress();
                        return;
                    }

                // 3. Отправляем подготовленный легкий пакет файлов на сервер
                const xhr = new XMLHttpRequest();
                xhr.open('POST', url, true);

                // Отслеживание прогресса загрузки файлов на сервер
                xhr.upload.onprogress = function(e) {
                    if (e.lengthComputable) {
                        const percentComplete = Math.round((e.loaded / e.total) * 100);

                        if (percentComplete < 100) {
                            progressFill.style.width = percentComplete + '%';
                            progressText.textContent = `Загрузка сжатых файлов: ${percentComplete}% (${formatBytes(e.loaded)} из ${formatBytes(e.total)})`;
                        } else {
                            progressFill.style.width = '100%';
                            progressFill.classList.add('pulse');
                            progressText.textContent = 'Идет сохранение на сервере...';
                        }
                    }
                };

                xhr.onload = function() {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        isUploading = false;
                        document.querySelector('.modal-card').classList.remove('uploading');
                        window.location.href = xhr.responseURL || window.location.href;
                    } else {
                        alert('Произошла ошибка при сохранении поста: ' + xhr.statusText);
                        resetUploadProgress();
                    }
                };

                xhr.onerror = function() {
                    alert('Произошла сетевая ошибка при отправке данных на сервер.');
                    resetUploadProgress();
                };

                xhr.send(formData);
            }

            // Сброс состояния прогресс-бара в случае ошибки
            function resetUploadProgress() {
                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressFill = document.getElementById('uploadProgressFill');

                const submitBtn = document.getElementById('postForm-ok');
                const cancelBtn = document.querySelector('.btn-cancel');
                const deleteBtn = document.getElementById('deleteBtn');

                // Разблокируем интерфейс
                isUploading = false;
                document.querySelector('.modal-card').classList.remove('uploading');

                progressContainer.style.display = 'none';
                submitBtn.disabled = false;
                cancelBtn.style.display = 'inline-block';
                if (isEditMode) {
                    deleteBtn.style.display = 'block';
                }
                progressFill.style.width = '0%';
                progressFill.classList.remove('pulse');
            }

            // Вспомогательная функция для форматирования байт в понятный вид
            function formatBytes(bytes, decimals = 2) {
                if (bytes === 0) return '0 B';
                const k = 1024;
                const dm = decimals < 0 ? 0 : decimals;
                const sizes = ['B', 'КБ', 'МБ', 'ГБ'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
            }

            // Функция пропорционального сжатия изображения в браузере перед отправкой
            function compressImageOnClient(file, maxDimension = 1600, quality = 0.9) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function(event) {
                        const img = new Image();
                        img.src = event.target.result;
                        img.onload = function() {
                            const canvas = document.createElement('canvas');
                            let width = img.width;
                            let height = img.height;

                            // Запоминаем исходное разрешение
                            const originalResolution = `${width}x${height}`;

                            // Вычисляем пропорции ресайза
                            if (width > maxDimension || height > maxDimension) {
                                if (width > height) {
                                    height = Math.round((height * maxDimension) / width);
                                    width = maxDimension;
                                } else {
                                    width = Math.round((width * maxDimension) / height);
                                    height = maxDimension;
                                }
                            }

                            // Запоминаем сжатое разрешение
                            const compressedResolution = `${width}x${height}`;

                            canvas.width = width;
                            canvas.height = height;

                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);

                            // Конвертируем в JPEG
                            canvas.toBlob((blob) => {
                                if (blob) {
                                    const compressedFile = new File([blob], file.name, {
                                        type: 'image/jpeg',
                                        lastModified: Date.now()
                                    });
                        
                                    // ВОЗВРАЩАЕМ: сжатый файл и оба разрешения текстом
                                    resolve({
                                        file: compressedFile,
                                        originalResolution: originalResolution,
                                        compressedResolution: compressedResolution
                                    });
                                } else {
                                    reject(new Error('Ошибка сжатия'));
                                }
                            }, 'image/jpeg', quality);
                        };
                        img.onerror = () => reject(new Error('Ошибка загрузки изображения'));
                    };
                    reader.onerror = () => reject(new Error('Ошибка чтения файла'));
                });
            }

            // Функция-хелпер для получения красивых SVG-иконок соцсетей
            function getNetworkIcon(network) {
                const net = (network || '').toLowerCase();

                // Telegram (Бумажный самолетик)
                if (net.includes('telegram')) {
                    return `<svg class="net-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.74-.4.27-.76.41-1.08.4-.36-.01-1.05-.2-1.56-.37-.63-.2-1.12-.31-1.08-.66.02-.18.3-.37.83-.58 3.27-1.42 5.45-2.36 6.54-2.81 3.1-.12 3.74.03 3.53 1.52z"/></svg>`;
                }
