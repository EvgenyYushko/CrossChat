                    <div class="file-upload-zone" id="dropZone">
                        <span class="upload-text">📁 Нажмите для выбора файлов или перетащите их сюда</span>
                        <input type="file" id="fileInput" name="images" multiple accept="image/*,video/*">
                    </div>
                </div>

                <!-- Чекбокс "Один текст для всех" (добавлен сюда) -->
                <div class="form-group" id="unifiedTextGroup" style="display: none;">
                    <label style="display: flex; align-items: center; gap: 8px; text-transform: none; font-size: 0.9rem; cursor: pointer; color: var(--text-main);">
                        <input type="checkbox" id="unifiedTextCheckbox" checked onchange="toggleUnifiedTextMode()" style="width: 16px; height: 16px; accent-color: var(--accent-color);"> Один текст для всех соцсетей
                    </label>
                </div>

                <!-- Контейнер для динамического текста постов -->
                <div id="captionContainer">
                    <div class="form-group" id="defaultCaptionGroup">
                        <label id="captionLabel">Текст поста</label>
                        <textarea name="caption" id="captionInput" required placeholder="Введите текст вашего сообщения..."></textarea>
                    </div>

                    <!-- Скрытые кастомные текста для соцсетей (режим All) -->
                    <div class="form-group" id="captionGroup_TelegramPublic" style="display: none;">
                        <label style="color: #3b82f6;">Текст для Telegram</label>
                        <textarea name="caption_TelegramPublic" id="captionInput_TelegramPublic" placeholder="Введите уникальный текст для TelegramPublic..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_TelegramPrivate" style="display: none;">
                        <label style="color: #3b82f6;">Текст для TelegramPrivate</label>
                        <textarea name="caption_TelegramPrivate" id="captionInput_TelegramPrivate" placeholder="Введите уникальный текст для TelegramPrivate..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_Instagram" style="display: none;">
                        <label style="color: #ec4899;">Текст для Instagram</label>
                        <textarea name="caption_Instagram" id="captionInput_Instagram" placeholder="Введите уникальный текст для Instagram..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_Facebook" style="display: none;">
                        <label style="color: #ec4899;">Текст для Facebook</label>
                        <textarea name="caption_Facebook" id="captionInput_Facebook" placeholder="Введите уникальный текст для Facebook..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_Threads" style="display: none;">
                        <label style="color: #ec4899;">Текст для Threads</label>
                        <textarea name="caption_Threads" id="captionInput_Threads" placeholder="Введите уникальный текст для Threads..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_BlueSky" style="display: none;">
                        <label style="color: #ec4899;">Текст для BlueSky</label>
                        <textarea name="caption_BlueSky" id="captionInput_BlueSky" placeholder="Введите уникальный текст для BlueSky..."></textarea>
                    </div>
                    <div class="form-group" id="captionGroup_X" style="display: none;">
                        <label style="color: #ec4899;">Текст для X</label>
                        <textarea name="caption_X" id="captionInput_X" placeholder="Введите уникальный текст для X..."></textarea>
                    </div>
                    @* <div class="form-group" id="captionGroup_VK" style="display: none;">
                        <label style="color: #4c75a3;">Текст для VK</label>
                        <textarea name="caption_VK" id="captionInput_VK" placeholder="Введите уникальный текст для VK..."></textarea>
                    </div> *@
                </div>

                <!-- Предупреждение о коллективном редактировании -->
                <div id="multiPostWarning" style="display: none; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 10px; padding: 10px 12px; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.4;"></div>

                <!-- Блок прогресс-бара -->
                <div id="uploadProgressContainer" class="upload-progress-container" style="display: none;">
                    <div class="progress-bar-bg">
                        <div id="uploadProgressFill" class="progress-bar-fill"></div>
                    </div>
                    <span id="uploadProgressText" class="progress-text">Загрузка: 0%</span>
                </div>

                <div class="form-actions">
                    <button id="postForm-ok" type="submit" class="btn-primary">Сохранить</button>
                    <button type="button" class="btn-cancel" onclick="closeModal()">Отмена</button>
                    <input type="hidden" name="postId" id="postId" />
                    <button type="button" id="deleteBtn" class="btn-danger" onclick="deletePost()">Удалить пост</button>
                </div>
            </form>
        </div>
    </div>
    <div id="imageLightbox" onclick="closeLightbox()">
        <button class="close-lightbox-btn" onclick="closeLightbox()">&times;</button>
        <img id="lightboxImage" src="" alt="Просмотр изображения">
    </div>
    <!-- Парящий тултип для быстрого превью поста -->
    <div id="calendarTooltip" class="calendar-tooltip"></div>
</div>

@section Scripts {
        <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
        <!-- Подключаем русский перевод и региональные стандарты -->
        <script>
            let isEditMode = false;
            let isUploading = false; // Глобальный флаг процесса загрузки
            let isImageEditingLocked = false; 

            const modal = document.getElementById('postModal');
            const dateInput = document.getElementById('showDateInput');
            const postIdInput = document.getElementById('postId');

            // Локальные хранилища для файлов и картинок
            let selectedFiles = [];   // Хранит новые объекты File
            let existingImages = [];  // Хранит строки Base64 с сервера

            async function deletePost() {
                if (isUploading) return; // Блокируем удаление во время отправки другого запроса
                if (!confirm('Удалить пост?')) return;
                const postId = postIdInput.value;
                const network = "@ViewBag.Network"; // Передаем текущую соцсеть для умного удаления!
                const response = await fetch(`/planner/delete/${postId}?networkType=${network}`, { method: 'POST' });
                if (response.ok) location.reload();
                else alert("Ошибка при удалении");
            }

            function formatToInput(date) {
                const pad = (num) => num.toString().padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T12:00`;
            }

            // Функция синхронизации массива selectedFiles с элементом input[type="file"]
            function syncFileInput() {
                const fileInput = document.getElementById('fileInput');
                const dataTransfer = new DataTransfer();
                selectedFiles.forEach(file => dataTransfer.items.add(file));
                fileInput.files = dataTransfer.files;
            }

            // Рендеринг галереи превью
            function renderGallery() {
                const gallery = document.getElementById('imageGallery');
                const hiddenContainer = document.getElementById('hiddenInputsContainer');
                gallery.innerHTML = '';
                hiddenContainer.innerHTML = '';

                // 1. Отрисовка картинок из базы данных
                existingImages.forEach((imgData, index) => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'thumb-wrapper';

                    const img = document.createElement('img');
                    img.className = 'thumb';

                    let src = imgData;
                    if (!imgData.startsWith('data:')) {
                        let mimeType = 'image/jpeg';
                        if (imgData.startsWith('iVBORw')) mimeType = 'image/png';
                        else if (imgData.startsWith('R0lGOD')) mimeType = 'image/gif';
                        else if (imgData.startsWith('UklGR')) mimeType = 'image/webp';
                        src = `data:${mimeType};base64,${imgData}`;
                    }
                    img.src = src;
                    img.onclick = () => openLightbox(src);

                    wrapper.appendChild(img);

                    // ИСПРАВЛЕНИЕ: Создаем крестик удаления ТОЛЬКО если редактирование картинок разрешено!
                    if (!isImageEditingLocked) {
                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'remove-thumb-btn';
                        removeBtn.innerHTML = '&times;';
                        removeBtn.onclick = (e) => {
                            e.stopPropagation();
                            existingImages.splice(index, 1);
                            renderGallery();
                        };
                        wrapper.appendChild(removeBtn);
                    }

                    gallery.appendChild(wrapper);

                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'keptImages';
                    hiddenInput.value = imgData;
                    hiddenContainer.appendChild(hiddenInput);
                });

                // 2. Отрисовка новых выбранных файлов
                selectedFiles.forEach((file, index) => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'thumb-wrapper';

                    const img = document.createElement('img');
                    img.className = 'thumb';

                    const blobUrl = URL.createObjectURL(file);
                    img.src = blobUrl;
                    img.onclick = () => openLightbox(blobUrl);

                    wrapper.appendChild(img);

                    // ИСПРАВЛЕНИЕ: Создаем крестик удаления ТОЛЬКО если редактирование разрешено!
                    if (!isImageEditingLocked) {
                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'remove-thumb-btn';
                        removeBtn.innerHTML = '&times;';
                        removeBtn.onclick = (e) => {
                            e.stopPropagation();
                            selectedFiles.splice(index, 1);
                            URL.revokeObjectURL(blobUrl);
                            syncFileInput();
                            renderGallery();
                        };
                        wrapper.appendChild(removeBtn);
                    }

                    gallery.appendChild(wrapper);
                });
            }

            document.addEventListener('DOMContentLoaded', function() {

                initCheckboxIcons();

                var calendarEl = document.getElementById('calendar');

                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'ru',
                    firstDay: 1, // <-- Указывает, что неделя начинается с Понедельника
                    editable: true, // <-- Включает перетаскивание и изменение размеров событий на календаре!
                    selectable: true,
                    height: 'auto',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,timeGridDay'
                    },

                    // --- РЕНДЕРИНГ СОДЕРЖИМОГО СОБЫТИЯ ---
                    eventContent: function(arg) {
                        const currentNetwork = "@ViewBag.Network";
                        let iconsHtml = '';
                        const titleText = arg.event.title;

                        if (currentNetwork === "All") {
                            // Если мы в общем режиме — выводим иконки ВСЕХ активных сетей в ряд!
                            const activeNets = arg.event.extendedProps.activeNetworks || [];
                            activeNets.forEach(net => {
                                iconsHtml += getNetworkIcon(net);
                            });
                        } else {
                            // Если в одиночной сети — выводим только иконку этой соцсети
                            iconsHtml = getNetworkIcon(currentNetwork);
                        }

                        return {
                            html: `<div class="fc-event-main-content">${iconsHtml}<span class="fc-event-title-text">${titleText}</span></div>`
                        };
                    },

                    // --- ФИЧА №3: НАВЕДЕНИЕ МЫШИ НА СОБЫТИЕ ---
                    eventMouseEnter: function(info) {
                        if (window.innerWidth < 600) return;

                        const tooltip = document.getElementById('calendarTooltip');
                        const event = info.event;
                        const title = event.title;
                        const currentNetwork = "@ViewBag.Network";

                        let iconsHtml = '';
                        if (currentNetwork === "All") {
                            const activeNets = event.extendedProps.activeNetworks || [];
                            activeNets.forEach(net => { iconsHtml += getNetworkIcon(net); });
                        } else {
                            iconsHtml = getNetworkIcon(currentNetwork);
                        }

                        const options = { month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                        const dateStr = event.start.toLocaleDateString('ru-RU', options);
                        const statusColor = event.backgroundColor;

                        tooltip.innerHTML = `
                            <div class="tooltip-header">
                                <div class="tooltip-network">${iconsHtml}</div>
                                <span class="tooltip-status" style="background: ${statusColor}">Пост</span>
                            </div>
                            <div class="tooltip-date">📅 ${dateStr}</div>
                            <div class="tooltip-caption">${title ? title : "<i>Без описания</i>"}</div>
                        `;

                        const rect = info.el.getBoundingClientRect();
                        tooltip.style.display = 'block';
                        const tooltipHeight = tooltip.offsetHeight;

                        tooltip.style.left = (window.scrollX + rect.left + rect.width / 2 - 130) + 'px';
                        tooltip.style.top = (window.scrollY + rect.top - tooltipHeight - 12) + 'px';
                        tooltip.style.opacity = '1';
                    },

                    // --- УХОД МЫШИ С СОБЫТИЯ ---
                    eventMouseLeave: function() {
                        if (window.innerWidth < 600) return;

                        const tooltip = document.getElementById('calendarTooltip');
                        tooltip.style.opacity = '0';
                        setTimeout(() => {
                            if (tooltip.style.opacity === '0') {
                                tooltip.style.display = 'none';
                            }
                        }, 150);
                    },

                    // --- ОБРАБОТЧИК ПЕРЕТАСКИВАНИЯ ПОСТА МЫШКОЙ ---
                    eventDrop: function(info) {
                        // Блокируем перенос на календаре, если это мультипостинг и мы находимся в одиночной соцсети
                        const currentNetwork = "@ViewBag.Network";
                        const activeNets = info.event.extendedProps.activeNetworks || [];
                        if (currentNetwork !== "All" && activeNets.length > 1) {
                            alert('Изменение даты публикации для мультипостинга заблокировано в одиночной соцсети. Перейдите в общий вид ("All").');
                            info.revert();
                            return;
                        }

                        const postId = info.event.id;
                        const localDate = info.event.start;
                        const pad = (num) => num.toString().padStart(2, '0');
                        const localDateStr = `${localDate.getFullYear()}-${pad(localDate.getMonth() + 1)}-${pad(localDate.getDate())}T${pad(localDate.getHours())}:${pad(localDate.getMinutes())}:${pad(localDate.getSeconds())}`;

                        const formData = new FormData();
                        formData.append('newDate', localDateStr);

                        fetch(`/planner/update-date/${postId}`, {
                            method: 'POST',
                            body: formData
                        })
                        .then(res => {
                            if (!res.ok) throw new Error('Ошибка сервера');
                        })
                        .catch(err => {
                            alert('Не удалось изменить дату. Откат изменений.');
                            info.revert();
                        });
                    },

                    // --- КАСТОМИЗАЦИЯ ЗАГОЛОВКОВ ДЛЯ НЕРАБОЧИХ/РАБОЧИХ ВИДОВ ---
                    views: {
                        timeGridWeek: {
                            // Кастомный рендеринг заголовков колонок ТОЛЬКО для недели
                            dayHeaderContent: function(arg) {
                                // Получаем сокращенный день недели (ПН, ВТ...) и удаляем точку, если браузер её добавил
                                const weekday = arg.date.toLocaleDateString('ru-RU', { weekday: 'short' })
                                                       .replace('.', '')
                                                       .toUpperCase();
                                // Получаем число месяца (29, 30...)
                                const day = arg.date.getDate();

                                // Возвращаем HTML: день недели сверху, число снизу на новой строке
                                return { 
                                    html: `<div class="custom-day-header"><b>${weekday}</b><br><span>${day}</span></div>` 
                                };
                            }
                        },
                        // --- НАСТРОЙКА ДЛЯ РЕЖИМА ОДНОГО ДНЯ ---
                        timeGridDay: {
                            dayHeaderContent: function(arg) {
                                // Полное название дня недели (ПОНЕДЕЛЬНИК, ВТОРНИК...)
                                const weekday = arg.date.toLocaleDateString('ru-RU', { weekday: 'long' }).toUpperCase();
                                // Число и название месяца (29 июня)
                                const dayMonth = arg.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });

                                return {
                                    html: `<div class="custom-day-header"><b>${weekday}</b><br><span>${dayMonth}</span></div>`
                                };
                            }
                        }
                    },

                    events: '/planner/events?profileId=@ViewBag.ProfileId&networkType=@ViewBag.Network',

                // КЛИК ПО СОБЫТИЮ (РЕДАКТИРОВАНИЕ)
                eventClick: function(info) {
                    const postId = info.event.id;
                    const currentNetwork = "@ViewBag.Network";
                    isEditMode = true;

                    resetModalFormState();

                    const postIdInput = document.getElementById('postId');
                    const dateInput = document.getElementById('showDateInput');
                    const defaultCaptionInput = document.getElementById('captionInput');
                    const deleteBtn = document.getElementById('deleteBtn');
                    const postForm = document.getElementById('postForm');
                    const postFormOk = document.getElementById('postForm-ok');

                    document.getElementById('modalTitle').textContent = "Редактирование поста";
                    document.getElementById('imageGallery').innerHTML =
                        '<div style="color: var(--text-secondary); font-size: 0.9rem; padding: 10px 0;">⏳ Загрузка изображений...</div>';

                    modal.style.display = 'flex';

                    fetch(`/planner/get/${postId}`)
                        .then(res => res.json())
                        .then(post => {
                            document.getElementById('imageGallery').innerHTML = '';

                            postIdInput.value = post.id || post.Id;

                            const showDate = post.showDate || post.ShowDate;
                            if (showDate) {
                                dateInput.value = showDate.slice(0, 16);
                            }

                            const networks = post.networks || post.Networks;

                            // Собираем активные сети
                            let activeNets = [];
                            for (let key in networks) {
                                if (networks[key]) {
                                    const status = networks[key].status !== undefined ? networks[key].status : networks[key].Status;
                                    if (status !== undefined && status !== null && status !== "None" && status !== 0) {
                                        activeNets.push(key);
                                    }
                                }
                            }
                            const isMultiPost = activeNets.length > 1;

                            const netSelectGroup = document.getElementById('networkSelectGroup');
                            const defaultCaptionGroup = document.getElementById('defaultCaptionGroup');
                            const warningDiv = document.getElementById('multiPostWarning');

                            if (currentNetwork === "All") {
                                // ОБЩИЙ РЕЖИМ
                                if (netSelectGroup) netSelectGroup.style.display = 'block';
                                document.getElementById('unifiedTextGroup').style.display = 'block';
                                if (warningDiv) warningDiv.style.display = 'none';

                                dateInput.disabled = false;
                                document.getElementById('fileInput').disabled = false;
                                document.querySelector('.file-upload-zone').style.opacity = '1';

                                // УМНОЕ ОПРЕДЕЛЕНИЕ ЕДИНОГО ТЕКСТА:
                                // Проверяем, одинаковые ли текста во всех активных соцсетях поста
                                let isUnified = true;
                                let firstActiveCaption = null;
                                activeNets.forEach(net => {
                                    const text = networks[net].caption || networks[net].Caption || "";
                                    if (firstActiveCaption === null) {
                                        firstActiveCaption = text;
                                    } else if (text !== firstActiveCaption) {
                                        isUnified = false; // Текстовки отличаются!
                                    }
                                });
                                if (firstActiveCaption === null) firstActiveCaption = "";

                                // Выставляем статус чекбокса "Один текст для всех"
                                document.getElementById('unifiedTextCheckbox').checked = isUnified;

                                if (isUnified) {
                                    if (defaultCaptionGroup) defaultCaptionGroup.style.display = 'block';
                                    if (defaultCaptionInput) {
                                        defaultCaptionInput.value = firstActiveCaption;
                                        defaultCaptionInput.required = true;
                                    }
                                } else {
                                    if (defaultCaptionGroup) defaultCaptionGroup.style.display = 'none';
                                    if (defaultCaptionInput) defaultCaptionInput.required = false;
                                }

                            // Выставляем чекбоксы соцсетей и заполняем их текстареа
                            document.querySelectorAll('input[name="selectedNetworks"]').forEach(cb => {
                                const netName = cb.value;
                                const isActive = activeNets.includes(netName);
                                cb.checked = isActive;

                                const subGroup = document.getElementById(`captionGroup_${netName}`);
                                const subTextarea = document.getElementById(`captionInput_${netName}`);

                                if (subGroup && subTextarea) {
                                    subTextarea.value = networks[netName].caption || networks[netName].Caption || "";

                                    // Показываем подгруппу только если сеть активна И мы в раздельном режиме (isUnified = false)
                                    if (isActive && !isUnified) {
                                        subGroup.style.display = 'block';
                                        subTextarea.required = true;
                                    } else {
                                        subGroup.style.display = 'none';
                                        subTextarea.required = false;
                                    }
                                }
                            });
                            } else {
                                // ОДИНОЧНЫЙ РЕЖИМ (Instagram, Telegram...)
                                if (netSelectGroup) netSelectGroup.style.display = 'none';
                                document.getElementById('unifiedTextGroup').style.display = 'none';
                                if (defaultCaptionGroup) defaultCaptionGroup.style.display = 'block';

                                if (defaultCaptionInput) {
                                    defaultCaptionInput.required = true;
                                    const netData = networks[currentNetwork];
                                    defaultCaptionInput.value = netData ? (netData.caption || netData.Caption || "") : "";
                                }

                                if (isMultiPost) {
                                    const otherNets = activeNets.filter(n => n !== currentNetwork).join(', ');
                                    if (warningDiv) {
                                        warningDiv.style.display = 'block';
                                        warningDiv.textContent = `🔗 Этот пост также запланирован в: ${otherNets}. Изменение даты публикации и изображений заблокировано отсюда. Перейдите в общий планировщик ("All") для их редактирования.`;
                                    }

                                    isImageEditingLocked = true;
                                    dateInput.disabled = true;
                                    document.getElementById('fileInput').disabled = true;

                                    const fileUploadGroup = document.getElementById('fileUploadGroup');
                                    if (fileUploadGroup) fileUploadGroup.style.display = 'none';
                                } else {
                                    isImageEditingLocked = false;
                                    dateInput.disabled = false;
                                    document.getElementById('fileInput').disabled = false;
                                    if (warningDiv) warningDiv.style.display = 'none';

                                    const fileUploadGroup = document.getElementById('fileUploadGroup');
                                    if (fileUploadGroup) fileUploadGroup.style.display = 'block';
                                }
                            }

                            deleteBtn.style.display = 'block';
                            postForm.action = `/planner/update/${postId}`;
                            postFormOk.textContent = "Изменить";

                            const images = post.images || post.Images;
                            if (images && images.length > 0) {
                                existingImages = [...images];
                            }

                            syncFileInput();
                            renderGallery();
                        })
                        .catch(err => {
                            console.error("Ошибка загрузки поста:", err);
                        });
                },

                // КЛИК ПО ПУСТОМУ ДНЮ (СОЗДАНИЕ)
                dateClick: function(info) {
                    isEditMode = false;
                    resetModalFormState();

                    const currentNetwork = "@ViewBag.Network";
                    document.getElementById('postForm').action = "/planner/create";
                    document.getElementById('deleteBtn').style.display = 'none';
                    document.getElementById('postForm-ok').textContent = `Запланировать`;

                    dateInput.disabled = false;
                    document.getElementById('fileInput').disabled = false;

                    const fileUploadGroup = document.getElementById('fileUploadGroup');
                    if (fileUploadGroup) fileUploadGroup.style.display = 'block';

                    const netSelectGroup = document.getElementById('networkSelectGroup');
                    const defaultCaptionGroup = document.getElementById('defaultCaptionGroup');

                    if (currentNetwork === "All") {
                        if (netSelectGroup) netSelectGroup.style.display = 'block';
                        document.getElementById('unifiedTextGroup').style.display = 'block';

                        // По умолчанию "Один текст" включен, поэтому показываем дефолтный текстареа
                        if (defaultCaptionGroup) defaultCaptionGroup.style.display = 'block';
                        const defCapInput = document.getElementById('captionInput');
                        if (defCapInput) {
                            defCapInput.required = true;
                            defCapInput.value = "";
                        }

                        document.querySelectorAll('input[name="selectedNetworks"]').forEach(cb => {
                            cb.checked = false;
                        });
                    } else {
                        if (netSelectGroup) netSelectGroup.style.display = 'none';
                        document.getElementById('unifiedTextGroup').style.display = 'none';
                        if (defaultCaptionGroup) defaultCaptionGroup.style.display = 'block';

                        const defCapInput = document.getElementById('captionInput');
                        if (defCapInput) {
                            defCapInput.required = true;
                            defCapInput.value = "";
                        }
                    }

                    let selectedDate = info.date;
                    if (info.allDay) selectedDate.setHours(12, 0);

                    dateInput.value = formatToInput(selectedDate);
