@model CrossChat.Data.Entities.TelegramUserBotSettings
@{
    ViewData["Title"] = "Telegram UserBot";
    bool isConnected = Model != null && !string.IsNullOrEmpty(Model.AuthKey);
}

@section Styles {
    <style>
        /* Уникальные стили для страницы Telegram UserBot */
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
        }

        h1 {
            color: var(--text-main);
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            text-align: center;
        }

        h3 {
            color: var(--text-main);
            text-align: left;
            margin: 1.75rem 0 0.75rem;
            font-size: 1.1rem;
            border-bottom: 1px solid var(--glass-border);
            padding-bottom: 0.5rem;
        }

        .form-section {
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* СТИЛИЗАЦИЯ ТЕКСТОВЫХ ПОЛЕЙ ВВОДА */
        .text-input {
            width: 100%;
            box-sizing: border-box; /* Исключает вылет полей за рамки */
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            margin-bottom: 1rem;
            font-family: inherit;
        }

            .text-input:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            resize: vertical;
            min-height: 120px;
            font-family: inherit;
            margin-bottom: 1rem;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.23s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        /* Группа верхних кнопок управления */
        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            box-sizing: border-box;
        }

        /* Стилизация кнопки консоли бота (стеклянный стиль) */
        .btn-console {
            background: rgba(15, 23, 42, 0.4) !important;
            border: 1px solid var(--glass-border) !important;
            color: var(--text-main) !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            margin: 0 !important;
        }

            .btn-console:hover {
                background: rgba(15, 23, 42, 0.7) !important;
                border-color: var(--text-secondary) !important;
                transform: translateY(-1px);
            }

        /* Стилизация кнопки автопостинга (Индиго-градиент) */
        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
            margin: 0 !important;
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                box-shadow: 0 8px 16px rgba(99, 102, 241, 0.35);
                transform: translateY(-1px);
            }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1.5rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 2rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        /* Переключатель */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            margin-bottom: 1.5rem;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        /* СТАТУСЫ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* МОБИЛЬНАЯ АДАПТАЦИЯ */
        @@media (max-width: 600px) {
            .container

        {
            margin-top: 5rem;
        }

        .card {
            padding: 1.5rem;
        }

        .btn {
            padding: 12px 10px;
            font-size: 0.9rem;
        }

        /* Складываем кнопки управления в один ряд вертикально на мобилках */
        .action-buttons-group {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        /* Складываем сетку прокси в один ряд вертикально на мобилках */
        .proxy-grid {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        }

        /* --- СВЕТЛАЯ ТЕМА ДЛЯ КНОПОК --- */
        [data-theme="light"] .btn-console {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

            [data-theme="light"] .btn-console:hover {
                background: #f1f5f9 !important;
                border-color: #94a3b8 !important;
            }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Назад</a>
}

<div class="container">
    <div class="card">
        <h1>Telegram User Бот</h1>

        @if (isConnected)
        {
            <div style="text-align: center;">
                <span class="status-badge @(Model.IsActive ? "status-active" : "status-paused")">
                    <span class="dot"></span>@(Model.IsActive ? "В сети" : "Отключен")
                </span>
            </div>

            <form action="/telegram-user/update" method="post" class="form-section">
                <input type="hidden" name="botId" value="@Model.Id" />

                <!-- Глобальный тумблер активности -->
                <div class="switch-container">
                    <div>
                        <label style="margin:0; font-size: 1.1rem; color: white;">Активность</label>
                        <div style="font-size: 0.8rem; color: var(--text-secondary);">Запустить прослушивание сообщений</div>
                    </div>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <!-- СИММЕТРИЧНАЯ ГРУППА КНОПОК УПРАВЛЕНИЯ -->
                <div class="action-buttons-group">
                    <a href="/auth/console?provider=telegram&botId=@Model.Id&username=@Model.Id" class="btn btn-console">
                        💻 Консоль бота
                    </a>
                    <a href="/planner?profileId=@Model.ProfileId&network=TelegramPublic&botId=@Model.Id" class="btn btn-autoposting">
                        📅 Автопостинг
                    </a>
                </div>

                <h3>Данные сессии (Read-only)</h3>
                <div class="form-group">
                    <label>User ID</label>
                    <input type="text" value="@Model.TgUserId" class="text-input" readonly style="opacity: 0.6; cursor: not-allowed;">
                </div>

                <h3>Настройки ИИ</h3>
                <div class="form-group">
                    <label>Системный промпт (Инструкция)</label>
                    <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                </div>

                <h3>Обновить Прокси</h3>
                <!-- СЕТКА ПРОКСИ 1 С КЛАССОМ .PROXY-GRID ДЛЯ МОБИЛОК -->
                <div class="proxy-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; box-sizing: border-box;">
                    <div class="form-group">
                        <label>Host</label>
                        <input type="text" name="ProxyHost" value="@Model.ProxyHost" class="text-input" placeholder="IP" style="margin:0;">
                    </div>
                    <div class="form-group">
                        <label>Port</label>
                        <input type="number" name="ProxyPort" value="@Model.ProxyPort" class="text-input" placeholder="Port" style="margin:0;">
                    </div>
                </div>

                <!-- СЕТКА ПРОКСИ 2 С КЛАССОМ .PROXY-GRID ДЛЯ МОБИЛОК -->
                <div class="proxy-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; box-sizing: border-box; margin-top: 10px;">
                    <div class="form-group">
                        <label>User</label>
                        <input type="text" name="ProxyUser" value="@Model.ProxyUser" class="text-input" placeholder="Login" style="margin:0;">
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="ProxyPass" value="@Model.ProxyPass" class="text-input" placeholder="Password" style="margin:0;">
                    </div>
                </div>

                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            </form>

            <form action="/telegram-user/disconnect" method="post" onsubmit="return confirm('Полностью удалить сессию и данные бота?');" style="margin-top: 1rem;">
                <input type="hidden" name="botId" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Удалить аккаунт</button>
            </form>
        }
        else
        {
            /* === РЕЖИМ ПОДКЛЮЧЕНИЯ === */
            <p style="color:var(--text-secondary); margin-bottom:2rem;">Введите данные для ручного внедрения сессии (Inject).</p>

            <form action="/telegram-user/connect" method="post" class="form-section">
                <h3>Данные аккаунта</h3>
                <div class="form-group">
                    <label>DC ID</label>
                    <input type="number" name="DcId" placeholder="1-5" class="text-input" required>
                </div>

                <div class="form-group">
                    <label>Auth Key (HEX)</label>
                    <input type="text" name="AuthKey" placeholder="Длинный HEX ключ..." class="text-input" required>
                </div>

                <div class="form-group">
                    <label>Telegram User ID</label>
                    <input type="number" name="TgUserId" placeholder="Например: 12345678" class="text-input" required>
                </div>

                <h3>Прокси (Обязательно для Render)</h3>
                <!-- СЕТКА ПРОКСИ 1 С КЛАССОМ .PROXY-GRID ДЛЯ МОБИЛОК -->
                <div class="proxy-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; box-sizing: border-box; margin-bottom: 10px;">
                    <input type="text" name="ProxyHost" placeholder="IP" class="text-input" style="margin:0;">
                    <input type="number" name="ProxyPort" placeholder="Port" class="text-input" style="margin:0;">
                </div>
                <!-- СЕТКА ПРОКСИ 2 С КЛАССОМ .PROXY-GRID ДЛЯ МОБИЛОК -->
                <div class="proxy-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; box-sizing: border-box; margin-bottom: 20px;">
                    <input type="text" name="ProxyUser" placeholder="Login" class="text-input" style="margin:0;">
                    <input type="password" name="ProxyPass" placeholder="Password" class="text-input" style="margin:0;">
                </div>

                <button type="submit" class="btn btn-primary">Подключить UserBot</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Показ тоста при сохранении
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('saved')) {
            alert('Настройки успешно обновлены!');
        }
    </script>
}