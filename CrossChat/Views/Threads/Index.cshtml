@model CrossChat.Data.Entities.ThreadsSettings
@{
    ViewData["Title"] = "Управление Threads";
    bool isConnected = Model != null && !string.IsNullOrEmpty(Model.AccessToken);
}

@section Styles {
    <style>
        .container {
            max-width: 800px;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
            text-align: center;
        }

        h1 {
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }

        /* HEADER ПОДКЛЮЧЕННОГО */
        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 2rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--text-main);
            padding: 4px;
            background: transparent;
            margin-bottom: 1rem;
        }

        .username {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        /* ФОРМА */
        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
        }

        textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 1rem;
            border-radius: 12px;
            font-family: inherit;
            resize: none;
            min-height: 150px;
        }

            textarea:focus {
                outline: none;
                border-color: var(--accent-color);
            }

        /* КНОПКИ */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
            width: 100%;
            font-size: 1rem;
            box-sizing: border-box;
        }

            .btn svg {
                width: 24px;
                height: 24px;
                fill: white;
                flex-shrink: 0;
            }

        .btn-threads {
            background: #000;
            color: white;
            border: 1px solid #333;
        }

        [data-theme="light"] .btn-threads {
            background: #000;
        }

        .btn-primary {
            background: var(--accent-color);
            color: white;
            margin-top: 1rem;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            margin-top: 2rem;
        }

        /* СТАТУСЫ */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* ТОГГЛ */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            background: var(--glass-bg);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(24px);
            }

        /* ИНСТРУКЦИЯ */
        .instruction-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 0.95rem;
            cursor: pointer;
            margin-bottom: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            width: 100%;
            justify-content: center;
        }

        .instruction-content {
            display: none;
            text-align: left;
            background: var(--glass-bg);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
        }

        .step-title {
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 600px) {
            .container {
                margin-top: 5rem;
            }

            .card {
                padding: 1.5rem;
            }

            .btn {
                padding: 12px 10px;
                font-size: 0.9rem;
            }
        }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Профиль</a>
}

<div class="container">
    <div class="card">
        @if (isConnected)
        {
            <div id="toast" style="display:none; background:#10b981; color:white; padding:10px; border-radius:8px; margin-bottom:1rem;">Настройки сохранены!</div>

            <div class="connected-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
                }
                <div class="username">@@@(Model.Username ?? "threads_user")</div>

                <div style="margin-top: 10px;">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active"><span class="dot"></span> Бот активен</span>
                    }
                    else
                    {
                        <span class="status-badge status-paused">⚠️ Отключен</span>
                    }
                </div>
            </div>
            <a href="/auth/console?provider=threads&botId=@Model.Id&username=@Model.Username" class="btn" style="background:#000; border:1px solid #333; margin-top: 1rem;">
                💻 Открыть консоль
            </a>
            <a href="/planner?profileId=@Model.ProfileId&network=Threads" class="btn" style="background: #6366f1; margin-top: 10px;">
                📅 Автопостинг
            </a>
            <form action="/threads/update-settings" method="post">
                <input type="hidden" name="botId" value="@Model.Id">
                <div class="switch-container">
                    <label style="margin:0;">Включить автоответы</label>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false" />
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="form-group" style="text-align:left;">
                    <label>Системный промпт (Инструкция)</label>
                    <textarea name="systemPrompt" required>@Model.SystemPrompt</textarea>
                </div>

                <div class="form-group" style="text-align:left; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 30px; margin-bottom: 15px;">Привязан к профилю</h4>

                    <select name="profileId" class="select-input">
                        @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
            </form>

            <form action="/threads/disconnect?botId=@Model.Id" method="post" onsubmit="return confirm('Отключить Threads?');">
                <button type="submit" class="btn btn-danger">Отключить аккаунт</button>
            </form>
        }
        else
        {
            <button class="instruction-btn" onclick="toggleInstruction()">📖 Как подготовить Threads?</button>
            <div id="instructionBlock" class="instruction-content">
                <p>1. Убедитесь, что ваш аккаунт Threads является <strong>профессиональным</strong>.</p>
                <p>2. В настройках конфиденциальности разрешите ответы (Replies) для всех.</p>
                <p>3. Нажмите кнопку ниже и разрешите доступ приложению.</p>
            </div>

            <div class="login-buttons">
                <a href="@ViewBag.LoginUrl" class="btn btn-threads">
                    <svg viewBox="0 0 24 24"><path d="M12 24c6.627 0 12-5.373 12-12S18.627 0 12 0 0 5.373 0 12s5.373 12 12 12zm0-22c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z" /></svg>
                    <span>Войти через Threads</span>
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleInstruction() {
            var block = document.getElementById('instructionBlock');
            block.style.display = (block.style.display === 'block') ? 'none' : 'block';
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('saved')) {
            const toast = document.getElementById('toast');
            toast.style.display = 'block';
            setTimeout(() => toast.style.display = 'none', 3000);
        }
    </script>
}