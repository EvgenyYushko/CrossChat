@model CrossChat.Data.Entities.YouTubeSettings
@{
    ViewData["Title"] = "Управление YouTube каналом";
    var channelUrl = !string.IsNullOrEmpty(Model.CustomUrl)
        ? $"https://youtube.com/{Model.CustomUrl}"
        : $"https://youtube.com/channel/{Model.ChannelId}";
}

@section Styles {
    <style>
        .container {
            max-width: 800px;
            width: 100%;
            margin: 6rem auto 3rem;
            padding: 0 1rem;
        }

        .card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .connected-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .big-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #ff0000;
            padding: 4px;
            background: transparent;
            margin-bottom: 1rem;
            box-shadow: 0 8px 24px rgba(255, 0, 0, 0.25);
        }

        .channel-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            color: var(--text-main);
        }

        .channel-handle {
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-family: monospace;
            margin-bottom: 1rem;
        }

        /* Бейджи статистики */
        .stats-grid {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 1.25rem;
        }

        .stat-badge {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-paused {
            background: rgba(234, 179, 8, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        /* Кнопки управления */
        .action-buttons-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            box-sizing: border-box;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 20px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            width: 100%;
            font-size: 0.95rem;
            box-sizing: border-box;
        }

        .btn-yt {
            background: #ff0000 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 15px rgba(255, 0, 0, 0.3);
        }

            .btn-yt:hover {
                background: #cc0000 !important;
                transform: translateY(-1px);
            }

        .btn-autoposting {
            background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

            .btn-autoposting:hover {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
                transform: translateY(-1px);
            }

        /* Форма настроек */
        .form-section {
            margin-top: 2rem;
            border-top: 1px solid var(--glass-border);
            padding-top: 2rem;
            text-align: left;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .select-input, textarea {
            width: 100%;
            box-sizing: border-box;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 0.85rem 1rem;
            border-radius: 12px;
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
        }

            .select-input:focus, textarea:focus {
                border-color: var(--accent-color);
            }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            background: rgba(255, 255, 255, 0.03);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked ~ .slider {
            background-color: #10b981;
        }

            input:checked ~ .slider:before {
                transform: translateX(24px);
            }

        .btn-primary {
            background: var(--accent-color);
            color: white;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            margin-top: 1.5rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: rgba(239, 68, 68, 0.4);
            }

        @@media (max-width: 600px) {
            .container { margin-top: 5rem; }
            .card { padding: 1.5rem; }
            .action-buttons-group { grid-template-columns: 1fr; }
        }
    </style>
}

@section NavbarActions {
    <a href="/profiles" style="color:var(--text-secondary); text-decoration:none; font-size:0.9rem;">← Профиль</a>
}

@section Scripts {
    <script>
        function updateYtModeUi() {
            const mode = document.getElementById('ytReplyModeSelect').value;
            const templatesBox = document.getElementById('ytTemplatesBox');
            const aiBox = document.getElementById('ytAiPromptBox');

            if (mode === "1") {
                templatesBox.style.display = "none";
                aiBox.style.display = "block";
            } else if (mode === "2") {
                templatesBox.style.display = "block";
                aiBox.style.display = "none";
            } else {
                templatesBox.style.display = "block";
                aiBox.style.display = "block";
            }
        }

        function confirmDisconnect(postsCount) {
            if (postsCount > 0) {
                return confirm(
                    `⚠️ ВНИМАНИЕ!\n\n` +
                    `К этому YouTube-каналу привязано публикаций в планировщике: ${postsCount} шт.\n\n` +
                    `При отключении канала эти видео и публикации будут удалены из календаря, а тяжелые видеофайлы очищены из Google Диска.\n\n` +
                    `Вы уверены, что хотите отключить канал?`
                );
            }
            return confirm('Отключить этот YouTube-канал от CrossChat?');
        }
    </script>
}

<div class="container">
    <div class="card">
        <!-- ШАПКА КАНАЛА -->
        <div class="connected-header">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="big-avatar" alt="Avatar">
            }
            else
            {
                <div class="big-avatar" style="display:flex;align-items:center;justify-content:center;font-size:2rem;background:#ff0000;color:white;">YT</div>
            }

            <div class="channel-title">@Model.ChannelTitle</div>
            <div class="channel-handle">@(Model.CustomUrl ?? Model.ChannelId)</div>

            <div class="stats-grid">
                <span class="stat-badge">👥 @Model.SubscriberCount.ToString("N0") подписчиков</span>
                <span class="stat-badge">🎬 @Model.VideoCount.ToString("N0") видео</span>
            </div>

            <div>
                @if (Model.IsActive)
                {
                    <span class="status-badge status-active"><span class="dot"></span> Канал активен</span>
                }
                else
                {
                    <span class="status-badge status-paused">⚠️ Отключен</span>
                }
            </div>
        </div>

        <!-- КНОПКИ ДЕЙСТВИЯ -->
        <div class="action-buttons-group">
            <a href="@channelUrl" target="_blank" class="btn btn-yt">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
                Открыть канал
            </a>
            <a href="/planner?profileId=@Model.ProfileId&network=YouTube&botId=@Model.Id" class="btn btn-autoposting">
                📅 Загрузка Shorts
            </a>
        </div>

        <!-- ФОРМА НАСТРОЕК -->
        <div class="form-section">
            <form action="/youtube/update-settings" method="post">
                <input type="hidden" name="botId" value="@Model.Id">

                <h4 style="margin-bottom: 20px; color: var(--text-main); font-weight: 700;">Настройки канала</h4>

                <!-- 1. ТУМБЛЕР АКТИВНОСТИ ДЛЯ АВТОПОСТИНГА (ИСПРАВЛЕН) -->
                <div class="switch-container">
                    <label style="margin: 0; font-weight: 600; cursor: pointer;">Включен для автопостинга</label>
                    <label class="switch">
                        <input type="hidden" name="isActive" value="false">
                        <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>

                <!-- 2. БЛОК АВТООТВЕТОВ НА КОММЕНТАРИИ YOUTUBE -->
                <div class="switch-container" style="display: flex; flex-direction: column; align-items: stretch; gap: 14px; margin-bottom: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label style="margin: 0; font-weight: 600; cursor: pointer;">🤖 Автоответы на комментарии (Shorts & Видео)</label>
                        <label class="switch">
                            <input type="checkbox" id="ytCommentsToggle" name="isCommentsEnabled" value="true" @(Model.IsCommentsEnabled ? "checked" : "")
                                   onchange="document.getElementById('ytCommentsSettingsBlock').style.display = this.checked ? 'flex' : 'none';">
                            <span class="slider"></span>
                        </label>
                        <!-- Вынесли наружу из .switch: теперь он не ломает CSS-анимацию! -->
                        <input type="hidden" name="isCommentsEnabled" value="false">
                    </div>

                    <!-- ВНУТРЕННИЕ НАСТРОЙКИ АВТООТВЕТОВ -->
                    <div id="ytCommentsSettingsBlock" style="display: @(Model.IsCommentsEnabled ? "flex" : "none"); flex-direction: column; gap: 14px; padding-top: 14px; border-top: 1px solid var(--glass-border);">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 6px;">Режим генерации ответов:</label>
                            <select name="commentReplyMode" id="ytReplyModeSelect" class="select-input" style="font-weight: 600; cursor: pointer;" onchange="updateYtModeUi()">
                                <option value="2" selected="@(Model.CommentReplyMode == 2)">📝 Только шаблоны (Бесплатно, Spintax)</option>
                                <option value="3" selected="@(Model.CommentReplyMode == 3)">⚡ Комбинированный (ИИ ➔ при сбое Шаблон)</option>
                                <option value="1" selected="@(Model.CommentReplyMode == 1)">🤖 Только ИИ (Gemini)</option>
                            </select>
                        </div>

                        <!-- ПОЛЕ ДЛЯ ШАБЛОНОВ СО SPINTAX -->
                        <div id="ytTemplatesBox" style="display: @(Model.CommentReplyMode == 1 ? "none" : "block");" class="form-group">
                            <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">
                                Шаблоны ответов (со Spintax {вариант1|вариант2}):
                            </label>
                            <textarea name="commentTemplates" rows="3" class="select-input" style="font-size: 0.9rem;"
                                      placeholder="{Спасибо|Благодарю}! ❤️&#10;Рады видеть на канале! ✨">@(Model.CommentTemplates ?? "{Спасибо|Благодарю}! ❤️\nРады видеть на канале! ✨")</textarea>
                            <small style="display: block; font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                Движок автоматически выбирает случайные фразы, чтобы исключить спам-фильтры YouTube.
                            </small>
                        </div>

                        <!-- ПРОМПТ ДЛЯ ИИ-ОТВЕТОВ НА КОММЕНТАРИИ -->
                        <div id="ytAiPromptBox" style="display: @(Model.CommentReplyMode == 2 ? "none" : "block");" class="form-group">
                            <label style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 4px;">Промпт для ответов ИИ:</label>
                            <textarea name="commentPrompt" rows="2" class="select-input" style="font-size: 0.9rem;">@Model.CommentPrompt</textarea>
                            <small style="display: block; font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                Инструкция нейросети, в каком стиле отвечать зрителям в комментариях.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- 3. СИСТЕМНЫЙ ПРОМПТ ДЛЯ ПОСТИНГА (ВОССТАНОВЛЕН) -->
                <div class="form-group">
                    <label>Промпт для генерации описания и тегов к видео (ИИ)</label>
                    <textarea name="systemPrompt" rows="3" class="select-input">@Model.SystemPrompt</textarea>
                    <small style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 4px; display: block;">
                        Используется при автогенерации заголовков и SEO-описаний к Shorts и длинным видео.
                    </small>
                </div>

                <!-- 4. ПРИВЯЗКА К ПРОФИЛЮ -->
                <div class="form-group">
                    <label>Привязан к профилю</label>
                    <select name="profileId" class="select-input">
                        @if (ViewBag.Profiles != null)
                        {
                            @foreach (var p in (List<CrossChat.Data.Entities.Profile>)ViewBag.Profiles)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.ProfileId)">
                                    @p.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 15px;">Сохранить настройки</button>
            </form>

            <!-- КНОПКА ОТКЛЮЧЕНИЯ YOUTUBE С УМНЫМ ПРЕДУПРЕЖДЕНИЕМ -->
            <form action="/youtube/disconnect" method="post" onsubmit="return confirmDisconnect(@(ViewBag.LinkedPostsCount ?? 0));">
                <input type="hidden" name="botId" value="@Model.Id">
                <button type="submit" class="btn btn-danger">Отключить канал</button>
            </form>
        </div>
    </div>
</div>